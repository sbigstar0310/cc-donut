#!/usr/bin/env python3
"""ccd account store — multi-account quota handoff.

Single owner of everything account-related: the credential store, quota polling,
OAuth refresh, and the swap itself. quota-guard.sh and ccd-handoff both shell out
to this script rather than sharing bash functions, because they run in different
processes at different moments.

Design notes live in docs/multi-account.md. The three facts this file is built on:

  1. GET https://api.anthropic.com/api/oauth/usage answers for ANY token, so a
     stored account's quota can be read without making it active. Without this
     the whole feature collapses into "swap and hope".
  2. The credential blob also holds `mcpOAuth` (Notion/Slack logins), which is
     account-INDEPENDENT. A swap replaces only the `claudeAiOauth` subtree; a
     wholesale overwrite would log the user out of their MCP servers on every hop.
  3. Access tokens live ~8h, refresh tokens ~8.5 DAYS and rotate on every use.
     So: refresh rarely, serialize it, write the rotated token to disk BEFORE
     using the new access token, and never refresh the account Claude Code owns.
     The corollary is bank_live_oauth(): because the stored token is a snapshot
     of a rotating key, every command starts by copying the live blob back into
     the account that owns it. Reading the live blob is free; spending the stored
     one is not.

Commands:
  ccd account add [--name N] [--label L] [--priority P]
  ccd account list [--json]
  ccd account rm <name>
  ccd account use [<name>] [--json]
  ccd account refresh [--all] [--inactive-only] [<name>]
  ccd account pick [--json]
  ccd account swap [--from N] [--window K] (internal: called by the hook)
  ccd account exhausted          (internal: the only thing that may justify paying)
  ccd account keepalive          (internal: called by the hook, at most daily)
  ccd account current [--json]   (internal: statusline / doctor)
"""

import argparse
import contextlib
import datetime
import errno
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request

# ── Constants ────────────────────────────────────────────────────────────────

USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
# Test-only, like CCD_TOKEN_URL: lets the suite stand up a local usage endpoint and
# assert the VERDICT a warm probe produces, not merely that it wrote a file.
if os.environ.get("CCD_USAGE_URL"):
    USAGE_URL = os.environ["CCD_USAGE_URL"]
OAUTH_BETA = "oauth-2025-04-20"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
# Anthropic has been moving token exchange from console.anthropic.com to
# platform.claude.com. Try both, remember which one answered.
TOKEN_URLS = (
    "https://console.anthropic.com/v1/oauth/token",
    "https://platform.claude.com/v1/oauth/token",
)
# Test-only, like CCD_CREDENTIALS_BACKEND: lets the suite stand up a local token
# endpoint and count what a refresh pass actually sends.
if os.environ.get("CCD_TOKEN_URL"):
    TOKEN_URLS = (os.environ["CCD_TOKEN_URL"],)
KEYCHAIN_SERVICE = "Claude Code-credentials"
USER_AGENT = "ccd"

# ONE meaning of "spent", and it is not a knob: the percentage at which a window
# has nothing left. Three decisions turn on it and they must never disagree —
# when a session moves (the hook), whether an account is somewhere to move TO
# (has_headroom), and whether an account counts towards the proof that may
# authorise paying (_still_spent). A 90% "reserve" used to answer the second and
# the third at once: a spare at 90% was skipped by the swap AND proved spent, and
# ccd paid with a tenth of a subscription left. So the number lives in one file,
# bin/spent-at, read by this program, the hook and the statusline alike; none of
# them sources another, and none of them can drift. Missing or unreadable is a
# broken install, and says so loudly rather than guessing.
with open(os.path.join(os.path.dirname(os.path.realpath(__file__)), "spent-at")) as _f:
    SPENT_AT = int(_f.read())


def window_spent(pct):
    """Is this one window out of room? Readings are whole percentages (_window
    rounds them), so 99.6 on the wire is 100 here and counts; 99.4 does not."""
    return isinstance(pct, (int, float)) and not isinstance(pct, bool) and pct >= SPENT_AT


CANDIDATE_TTL = int(os.environ.get("CCD_CANDIDATE_TTL", "300"))
KEEPALIVE_INTERVAL = int(os.environ.get("CCD_KEEPALIVE_INTERVAL", "86400"))
# First retry after a failed keepalive pass, doubling per consecutive failure up
# to KEEPALIVE_INTERVAL. A flat daily cadence gave a spare ~8 one-shot tries in
# its token's life; it backs off rather than retrying fast because the failure
# may itself be the endpoint refusing us.
KEEPALIVE_BUDGET = int(os.environ.get("CCD_KEEPALIVE_BUDGET", "120"))
KEEPALIVE_RETRY_MIN = int(os.environ.get("CCD_KEEPALIVE_RETRY_MIN", "900"))
# Warn once a spare's stored token has gone unrefreshed this long. Deliberately
# well inside the ~8.5-day refresh token life so there is room to act.
STALE_WARN_AFTER = int(os.environ.get("CCD_STALE_WARN_AFTER", str(3 * 86400)))
# Refresh a stored token this long before it actually expires.
REFRESH_SKEW = 300
# Overridable so the test suite can drive it to ~1s. A test that reaches the real
# network is a bug in the test, but it must fail fast and loudly rather than hang
# the suite for ten seconds per account while quietly calling Anthropic.
HTTP_TIMEOUT = int(os.environ.get("CCD_HTTP_TIMEOUT", "10"))
LOCK_TIMEOUT = 5
# How often a held Claude Code lock's mtime is refreshed. A keychain call may take
# its full 15s, past the write lock's stale window; Claude Code's own holders touch
# theirs every 5s, and so does this (claude_code_locks).
LOCK_TOUCH = 5

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

# ── Paths ────────────────────────────────────────────────────────────────────

# Derived from HOME only — never from a CCD_DIR override. bin/ccd, quota-guard.sh
# and ccd-handoff all hardcode $HOME/.claude/ccd, and the handoff interlock
# compares a path string computed independently on each side: an override honored
# here but not there would silently disable the whole handoff. HOME is also what
# the test suite swaps, so this stays testable.
CCD_DIR = os.path.join(os.path.expanduser("~"), ".claude", "ccd")
ACCOUNTS_DIR = os.path.join(CCD_DIR, "accounts")
ACTIVE_FILE = os.path.join(ACCOUNTS_DIR, ".active")
# When ccd last INSTALLED credentials, so a profile read can be judged stale or
# fresh relative to our own swap. Written by swap_to() alone — see active_set().
# Absent means ccd has never installed anything, and the profile is unopposed.
ACTIVE_AT_FILE = os.path.join(ACCOUNTS_DIR, ".active-at")
LOCK_FILE = os.path.join(ACCOUNTS_DIR, ".lock")
REFRESH_LOCK = os.path.join(ACCOUNTS_DIR, ".refresh.lock")    # see cmd_keepalive
ENDPOINT_FILE = os.path.join(ACCOUNTS_DIR, ".token-endpoint")
# One reading per account, one file per reading. A shared file made every writer
# responsible for every row: load all, wait on the network, write all — and an
# atomic replace keeps such a file from tearing, not from losing the update
# somebody else made while you waited. With a file each, a prober can only ever
# publish the account it measured.
READINGS_DIR = os.path.join(CCD_DIR, "readings")
KEEPALIVE_MARK = os.path.join(CCD_DIR, "accounts-keepalive")
# Where automatic swaps have come FROM lately, so one is never sent back to an
# account it just left as spent. Bounded by time: an entry is a statement about
# the last half hour, not a permanent verdict, and nothing is evicted while it
# still describes now (see swap_guard_read).
# Written BEFORE a credential write that could leave the backends holding
# different things, and removed once they provably agree again. While it exists
# nothing may install or bank a credential: the stores disagree about who is
# signed in, and every copy from one to the other files one account's credential
# under another's name.
STORE_SPLIT = os.path.join(CCD_DIR, "store-split")
# ccd does not repair the store: a credential Claude Code writes is worth more
# than anything ccd could reconstruct from a snapshot it happens to hold. All ccd
# owes the user is a true report and a stop that lifts by itself — see
# split_way_out(), which is careful not to promise more than a sign-in does.
SWAP_GUARD = os.path.join(CCD_DIR, "swapped-windows")
SWAP_GUARD_TTL = int(os.environ.get("CCD_SWAP_GUARD_TTL", "1800"))
# Breadcrumb for the hook. keepalive runs backgrounded with its output discarded,
# so anything it prints is lost; the hook picks this up on a later tick.
STALE_FILE = os.path.join(CCD_DIR, "accounts-stale")


def claude_config_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(
        os.path.expanduser("~"), ".claude"
    )


def credentials_file():
    return os.path.join(claude_config_dir(), ".credentials.json")


# ── Small utilities ──────────────────────────────────────────────────────────

C_RESET, C_DIM, C_BOLD = "\033[0m", "\033[2m", "\033[1m"
C_GRN, C_YLW, C_RED, C_CYN = "\033[32m", "\033[33m", "\033[31m", "\033[36m"


def color(on):
    if not on:
        for k in ("C_RESET", "C_DIM", "C_BOLD", "C_GRN", "C_YLW", "C_RED", "C_CYN"):
            globals()[k] = ""


def warn(msg):
    sys.stderr.write(f"{C_YLW}ccd account: {msg}{C_RESET}\n")


def die(msg, code=1):
    sys.stderr.write(f"{C_RED}ccd account: {msg}{C_RESET}\n")
    raise SystemExit(code)


def now():
    return int(time.time())


def ensure_dirs():
    os.makedirs(ACCOUNTS_DIR, mode=0o700, exist_ok=True)
    os.makedirs(READINGS_DIR, mode=0o700, exist_ok=True)
    try:        # makedirs leaves an existing directory's mode alone
        os.chmod(READINGS_DIR, 0o700)
    except OSError:
        pass
    try:        # the shared cache these replaced; a cache, so nothing is migrated
        os.unlink(os.path.join(CCD_DIR, "accounts-quota.json"))
    except OSError:
        pass
    try:
        os.chmod(ACCOUNTS_DIR, 0o700)
    except OSError:
        pass


def write_atomic(path, text, mode=0o600):
    """Write via a temp file in the same directory, then rename. A crash leaves
    either the old file or the new one, never a truncated blend."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".ccd-acct.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
        tmp = None
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)


def write_json(path, obj, mode=0o600):
    write_atomic(path, json.dumps(obj, ensure_ascii=False, indent=2) + "\n", mode)


def read_json(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except Exception:
        return None


class LockBusy(Exception):
    pass


class Lock:
    """flock around every mutation of the store or the live blob.

    Reentrant within one process. The rule is "whoever writes a stored credential
    holds the store lock", and the writers nest — a swap holds it and banks the
    outgoing account, a probe holds it and rotates a token. flock is per open file
    description, so a second open here would queue behind the first and deadlock;
    counting the depth is what lets the rule be stated once, at the bottom, rather
    than remembered at every call site.

    fcntl is absent on some platforms; degrade to no locking rather than refusing
    to run, since the alternative is the feature simply not working there."""

    _depth = {}

    def __init__(self, path, timeout=LOCK_TIMEOUT, wait=True, fatal=True):
        self.path = path
        self.timeout = timeout
        # wait=False raises LockBusy instead of dying: a background pass that
        # finds another one running has nothing to do and nobody to tell.
        self.wait = wait
        # fatal=False waits like any other caller and then raises LockBusy rather
        # than ending the process — for work that is worth a moment's patience and
        # is not worth anybody's session (a token exchange that has not started).
        self.fatal = fatal
        self.fd = None
        self.nested = False

    def __enter__(self):
        try:
            import fcntl
        except ImportError:
            return self
        if Lock._depth.get(self.path):
            Lock._depth[self.path] += 1
            self.nested = True
            return self
        ensure_dirs()
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
        deadline = time.time() + self.timeout
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                Lock._depth[self.path] = 1
                return self
            except OSError as e:
                if e.errno not in (errno.EAGAIN, errno.EACCES):
                    raise
                if not self.wait or time.time() >= deadline:
                    os.close(self.fd)
                    self.fd = None
                    if not self.wait or not self.fatal:
                        raise LockBusy()
                    die("another ccd account operation is in progress — try again")
                time.sleep(0.1)

    def __exit__(self, *exc):
        if self.nested:
            Lock._depth[self.path] -= 1
            self.nested = False
            return False
        if self.fd is not None:
            Lock._depth.pop(self.path, None)
            try:
                import fcntl

                fcntl.flock(self.fd, fcntl.LOCK_UN)
            except Exception:
                pass
            os.close(self.fd)
            self.fd = None
        return False


# ── Live credential blob (owned by Claude Code) ──────────────────────────────
#
# NOTE: this is NOT the ccd account store. The store is a file on every platform
# (docs/multi-account.md §9.1). The LIVE blob has to live wherever Claude Code
# actually reads it, and that location is platform-dependent — an external
# contract, not a design choice. It is confined to these two functions.


def _keychain_read():
    """The live blob, or None — and None means only "no answer". `security` exits
    44 out of failed searches as well as empty ones, so nothing here can tell an
    absent item from an unreachable one, and nothing downstream may pretend to."""
    try:
        p = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception:
        return None
    if p.returncode != 0:
        return None
    try:
        d = json.loads(p.stdout.strip())
        return d if isinstance(d, dict) else None
    except Exception:
        return None


def _keychain_write(blob):
    account = os.environ.get("USER") or os.environ.get("LOGNAME") or ""
    if not account:
        try:
            import getpass

            account = getpass.getuser()
        except Exception:
            return False
    # The command goes to `security -i` on stdin, as Claude Code writes this item,
    # so the credential never reaches the process table. A quote, backslash or
    # newline in the account would change the -a word or cut the command short,
    # writing another account's item or one with no password.
    if any(c in account for c in '"\\\n'):
        return False
    args = ["add-generic-password", "-U", "-s", KEYCHAIN_SERVICE, "-a", account]
    args += ["-X", json.dumps(blob, ensure_ascii=False).encode().hex()]
    line = " ".join(f'"{a}"' for a in args) + "\n"
    # Interactive mode reads a line into 4096 bytes and runs the overflow as a
    # command of its own. Past Claude Code's own limit for this item, argv it is.
    stdin = len(line.encode()) <= 4032
    try:
        p = subprocess.run(
            ["security", "-i"] if stdin else ["security", *args],
            input=line if stdin else None,
            capture_output=True,
            text=True,
            timeout=15,
        )
    except Exception:
        return False
    # Interactive mode exits with the last line's status cut to one byte, so a
    # refusal can exit 0; the "<command>: returned <status>" it prints cannot.
    return p.returncode == 0 and ": returned " not in p.stderr


def use_keychain():
    """The keychain is the only part of this program that reaches outside HOME.

    The test suite isolates everything by swapping HOME, which cannot contain a
    keychain write — so without this switch, running the suite on a Mac would
    overwrite the developer's own Claude login. Set CCD_CREDENTIALS_BACKEND=file
    to keep every credential operation inside $HOME. Test-only; production never
    sets it."""
    if os.environ.get("CCD_CREDENTIALS_BACKEND") == "file":
        return False
    return sys.platform == "darwin"


def live_read():
    """Return (blob, sources). sources lists every place the blob was found, so
    live_write can keep all of them in step."""
    sources = []
    blob = None
    if use_keychain():
        blob = _keychain_read()
        if blob is not None:
            sources.append("keychain")
    filed = read_json(credentials_file())
    if filed is not None:
        sources.append("file")
        if blob is None:
            blob = filed
    return (blob if blob is not None else {}), sources


def cred_identity(oauth):
    """What makes two backends the same credential, or None when they cannot say.

    The ACCESS token: it is what Claude Code sends, and a rotation mints a new
    access and refresh token together, so equal access tokens mean the same
    credential. The refresh token is deliberately not used — it is optional in
    everything ccd accepts, so two unrelated logins that both lack one would
    compare equal, which is absence of evidence read as agreement."""
    at = oauth.get("accessToken") if isinstance(oauth, dict) else None
    return at if isinstance(at, str) and at else None


def live_creds():
    """Return ({backend: its claudeAiOauth, whatever it holds}, [backends that
    gave no answer]).

    live_read() answers a different question — what to write back — and folds the
    backends into one preferred blob, which drops the other one's credential out
    of view. Whether a stored token is safe to SPEND, and whether two stores
    agree, both need all of them, unfiltered: a credential ccd would never install
    is still one a session may be carrying.

    ccd does not infer absence. A keychain with no answer is unknown, whatever
    exit code came back. The one absence taken at its word is the kernel's own
    ENOENT for the file — open() says it, where os.path.exists() says the same
    "no" for a permission error — and even that only means the file holds no
    token to protect. It never counts as a store that agrees."""
    def oauth_of(blob):
        o = blob.get("claudeAiOauth") if isinstance(blob, dict) else None
        return o if isinstance(o, dict) else {}

    held, blind = {}, []
    if use_keychain():
        blob = _keychain_read()
        if blob is None:
            blind.append("keychain")
        else:
            held["keychain"] = oauth_of(blob)
    try:
        with open(credentials_file()) as f:
            held["file"] = oauth_of(json.load(f))
    except FileNotFoundError:
        pass
    except Exception:
        blind.append("file")
    return held, blind


def store_split():
    """The stop a credential write left behind, as recorded — None only when there
    is no record. A cheap read: it says a stop may be standing, not that it still
    applies.

    Never falsy while the file exists. A record that is empty, corrupt or
    unreadable is still a stop; reading it as "no record" fails open in exactly
    the state where nothing is known."""
    try:
        with open(STORE_SPLIT) as f:
            rec = json.load(f)
    except FileNotFoundError:
        return None
    except Exception:
        rec = None
    if isinstance(rec, dict) and rec:
        return rec
    return {"detail": "the record of it cannot be read"}


def store_split_now():
    """The stop, re-tested against the stores. Call it holding the store lock.

    It lifts on positive evidence and on nothing else: every store the record
    names answers, each with a credential that has an identity, and every
    credential in sight carries the same one. "Cannot see it", "holds nothing" and
    "holds something unidentifiable" all keep it standing — each was once read as
    agreement, and each lifted a stop on a store nobody had seen agree. A backend
    that really is gone for good has an explicit exit instead (split_way_out).
    A record that names no stores has nothing that could answer, so it stands.

    The lock is what makes the test honest. A writer that has recorded its intent
    but not yet touched a backend leaves the stores agreeing, and lifting the stop
    there would throw away exactly the protection the record exists to give."""
    rec = store_split()
    if rec is None:
        return None
    named = rec.get("stores")
    if not isinstance(named, list) or not named \
            or not all(isinstance(n, str) for n in named):
        return rec
    held, blind = live_creds()
    ids = {cred_identity(held.get(n)) for n in named}
    ids |= {cred_identity(o) for o in held.values()}
    if blind or None in ids or len(ids) != 1:
        return rec
    clear_store_split()
    return None


def mark_store_split(detail, stores):
    """Record, BEFORE a backend is touched, that this write could leave them
    disagreeing. Returns False when it could not be written.

    Write-ahead, not best-effort. A state directory that cannot hold the record is
    a protection that cannot be recorded, and an unrecorded protection is none at
    all: the next command would bank one account's credential under another's name
    with nothing left to stop it. So a caller that cannot record its intent does
    not write the credential either."""
    try:
        write_json(STORE_SPLIT,
                   {"detail": detail, "stores": sorted(stores), "at": now()})
        return True
    except Exception:
        return False


def split_way_out():
    """The two exits. The first is ccd's; the second is the user's, and it is a
    sentence rather than a command on purpose — ccd cannot know which half of a
    divided store is the right one, or whether a backend that stopped answering
    is gone for good, so it says what it does know and leaves the judgement with
    the person who can check that the login works."""
    return ("Sign in again with /login; ccd lifts this by itself once every store "
            "it named answers with the same credential."
            "\n     If it still stands and you are satisfied the login works, delete "
            + _tilde(STORE_SPLIT) + ".")


def _tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home + os.sep) else path


def split_text(rec):
    return ("the credential stores disagree with each other ("
            + str(rec.get("detail") or "unknown") + ")."
            "\n     " + split_way_out())


def clear_store_split():
    try:
        os.unlink(STORE_SPLIT)
    except OSError:
        pass


def write_targets(sources):
    """Every backend a write has to land in: wherever the blob was read from,
    plus the keychain on a platform that keeps one. The write-ahead record names
    these, so it has to be the same answer live_write() acts on."""
    targets = set(sources)
    if use_keychain():
        targets.add("keychain")
    else:
        targets.discard("keychain")
        targets.add("file")
    return sorted(targets)


def live_write(blob, sources):
    """Write the blob everywhere Claude Code might read it.

    Returns (ok, failed, written): ok only when EVERY backend that had to take
    the write took it, failed naming the ones that refused, and written naming
    the ones that now hold this blob. A caller undoing a partial write needs that
    last list — which backends were READABLE is a different question, and
    answering it instead is how a split store went unrepaired.

    Half a write is not a write. On macOS a stale ~/.claude/.credentials.json is
    a real hazard: Claude Code falls back to it when the keychain read fails, so
    one backend holding the new credential and the other the old is a store that
    disagrees with itself — and the next bank copies the stale half back over the
    new one, destroying a credential nobody can mint again. Reporting that as
    success is what let it happen quietly."""
    targets = write_targets(sources)
    failed, written = [], []
    if "keychain" in targets:
        (written if _keychain_write(blob) else failed).append("keychain")
    if "file" in targets:
        try:
            write_json(credentials_file(), blob, 0o600)
            written.append("file")
        except Exception:
            failed.append("file")
    return (bool(targets) and not failed), failed, written


# Claude Code refreshes a token under locks of its own, and its save is a
# compare-and-swap: when the stored refresh token is no longer the one it spent,
# it writes nothing. A swap that banked the outgoing credential mid-refresh banked
# a token the server had just retired, and the rotated one was then thrown away —
# that account came back needing /login (#67). Taking the same locks in the same
# order lets the refresh finish first, so what the swap reads is what it produced.
#
# Claude Code's internal protocol, not a contract: its bundled proper-lockfile, as
# 2.1.273–2.1.278 use it. A lock is a directory made with mkdir, its holder keeps
# the mtime fresh, and one older than its stale window was abandoned. Should the
# names change, these guard nothing — which is where ccd stood before.
def claude_code_locks_at():
    """(path, stale seconds), in the order Claude Code's refresh takes them."""
    cfg = os.environ.get("CLAUDE_SECURESTORAGE_CONFIG_DIR")
    cfg = (claude_config_dir() if cfg is None else cfg) or os.path.join(
        os.path.expanduser("~"), ".claude")
    return ((os.path.join(cfg, ".oauth_refresh.lock"), 60),   # around the request
            (os.path.realpath(cfg) + ".lock", 60),            # its older name
            (os.path.join(cfg, ".storage-write.lock"), 15))   # around every write


def _claude_code_lock(path, stale, deadline):
    """mkdir `path` by `deadline`, or die. False when its directory does not
    exist: no store lives there to guard, and ccd does not create it.

    The deadline bounds every turn of the loop, mkdir included. A lock standing
    free — or released a moment after the budget ran out, or abandoned and there
    for the taking — is still a lock this swap has no time left to use, and taking
    it starts a write the caller has already stopped waiting for. Only the waiting
    paths were checked, so those three walked straight past it.

    Nothing that is not ours is deleted but what Claude Code would take over
    itself. A lock dated in the future never goes stale for Claude Code
    (anthropics/claude-code#95739), so it is held here too; one left as a file is
    nobody's lock (#95425), and waiting could never take it."""
    waited = None                               # the age it had when last in the way
    try:
        while True:
            if time.time() >= deadline:
                if waited is None:
                    die(f"no time left to take Claude Code's lock {_tilde(path)}; "
                        "nothing was changed — try again")
                if waited < -2:                 # proper-lockfile itself dates ~1s ahead
                    die(f"{_tilde(path)} is dated in the future and never goes stale "
                        "(anthropics/claude-code#95739). Nothing was changed; remove "
                        "it if no Claude Code is signing in")
                die(f"Claude Code is holding {_tilde(path)}; nothing was changed — "
                    "try again")
            try:
                os.mkdir(path)
                return True
            except FileExistsError:
                pass
            try:
                st = os.lstat(path)
            except FileNotFoundError:
                continue                        # released between the two calls
            if not stat.S_ISDIR(st.st_mode):
                die(f"{_tilde(path)} is a file, not a lock — Claude Code cannot save "
                    "a login past it (anthropics/claude-code#95425). Nothing was "
                    "changed; remove it and try again")
            age = time.time() - st.st_mtime
            if age > stale:
                try:
                    os.rmdir(path)              # abandoned, by Claude Code's own rule
                except FileNotFoundError:
                    pass
                continue
            waited = age                        # genuinely held, and worth waiting out
            time.sleep(0.1)
    except FileNotFoundError:
        return False
    except OSError as e:
        die(f"cannot take Claude Code's lock {_tilde(path)} ({e.strerror}); "
            "nothing was changed")


class Lease:
    """What a swap still holds of Claude Code's locks — asked, not assumed.

    Taking them is not keeping them. A process that stalls past a stale window (a
    sleeping laptop, a suspended hook, a keychain call that takes its full 15s) is
    overtaken: Claude Code makes the lock its own and starts refreshing the account
    the swap has already read. Installing from that read is #67 again through the
    narrow door (#96) — Claude Code's compare-and-swap discards the token it just
    minted, and the bank keeps the retired one. Losing the lease was visible only
    to the heartbeat, which stopped touching it and said nothing; the one process
    that had to know was the writer.

    Once lapsed, lapsed. A lock that comes free again says nothing about what its
    taker did while it was theirs."""

    def __init__(self):
        self.held = {}                          # lock path -> the mtime we gave it
        self.gone = None                        # the first lock that stopped being ours
        self.why = None
        self._guard = threading.Lock()          # the refresher rewrites held mtimes

    def _mine(self, p):
        try:
            return os.lstat(p).st_mtime_ns == self.held[p]
        except (OSError, KeyError):
            return False

    def _lapse(self, p, why):
        if self.gone is None:
            self.gone, self.why = p, why

    def took(self, p):
        with self._guard:
            self.held[p] = os.lstat(p).st_mtime_ns

    def mine(self, p):
        """Is this one lock still ours? What the release asks: a lapsed lease can
        hold the others yet, and those are ours to give back."""
        with self._guard:
            return self._mine(p)

    def refresh(self):
        """Keep what we hold fresh, as Claude Code's holders do. A touch that
        FAILS ends the lease too: a lock whose mtime we cannot keep current goes
        stale under us and is taken over at somebody else's leisure, so a lock
        that cannot be refreshed is one nothing may be written under."""
        with self._guard:
            for p in list(self.held):
                if not self._mine(p):
                    self._lapse(p, "another process took it over")
                    continue
                try:
                    os.utime(p)
                    self.held[p] = os.lstat(p).st_mtime_ns
                except OSError as e:
                    self._lapse(p, "its heartbeat could not keep it fresh: "
                                   f"{e.strerror}")

    def lapsed(self):
        """The first lock that is no longer ours, or None while every one is."""
        with self._guard:
            if self.gone is None:
                for p in list(self.held):
                    if not self._mine(p):
                        self._lapse(p, "another process took it over")
                        break
            return self.gone

    def note(self):
        return f"this swap lost Claude Code's lock {_tilde(self.gone)} ({self.why})"

    def hold(self, kept):
        """Write nothing once the lease has lapsed: die(), the way an expired
        deadline already fails, so the hook's three-attempts-then-a-note path
        takes it from there. `kept` says what the store was left holding."""
        if self.lapsed():
            die(f"{self.note()} — {kept}. Try again")


@contextlib.contextmanager
def claude_code_locks(deadline):
    """Hold Claude Code's credential locks around a read and write of the live
    store: all of them, taken by `deadline`, or die() having written nothing.

    Yields the Lease, because taking them is only half of holding them and the
    writer is the one that has to ask (#96).

    Only the refresh lock is ever waited on with nothing held, so Claude Code's
    own save never finds the write lock taken by somebody waiting on it.

    Released in the finally, die() included, and only while still ours. A
    SIGKILL leaves them behind; Claude Code takes them over once stale, so its
    refresh is held off for up to a minute."""
    lease = Lease()
    stop = threading.Event()

    def keep_fresh():
        while not stop.wait(LOCK_TOUCH):
            lease.refresh()

    keeper = threading.Thread(target=keep_fresh, daemon=True)
    keeper.start()
    try:
        for path, stale in claude_code_locks_at():
            if _claude_code_lock(path, stale, deadline):
                lease.took(path)
        yield lease
    finally:
        stop.set()
        keeper.join()
        for p in reversed(list(lease.held)):
            if lease.mine(p):
                try:
                    os.rmdir(p)
                except OSError:
                    pass


# ── Account store ────────────────────────────────────────────────────────────


def valid_name(name):
    return bool(name) and bool(NAME_RE.match(name))


def account_path(name):
    return os.path.join(ACCOUNTS_DIR, f"{name}.json")


def account_load(name):
    if not valid_name(name):
        return None
    return read_json(account_path(name))


def account_save(name, obj):
    """The one place a stored account is written, and therefore the one place the
    store lock has to be taken. Reading inside a lock only protects against
    writers that take it."""
    obj.setdefault("storage", "file")
    with Lock(LOCK_FILE):
        write_json(account_path(name), obj, 0o600)


def account_names():
    try:
        entries = os.listdir(ACCOUNTS_DIR)
    except OSError:
        return []
    names = [e[:-5] for e in entries if e.endswith(".json") and not e.startswith(".")]
    return sorted(n for n in names if valid_name(n))


def accounts_all():
    out = []
    for n in account_names():
        a = account_load(n)
        if a:
            a["name"] = n
            out.append(a)
    out.sort(key=lambda a: (a.get("priority", 999), a.get("added_at", 0), a["name"]))
    return out


def _pointer_name():
    try:
        with open(ACTIVE_FILE) as f:
            n = f.read().strip()
        if valid_name(n) and os.path.exists(account_path(n)):
            return n
    except OSError:
        pass
    return None


def _active_at():
    """When ccd last INSTALLED credentials, in ms epoch. 0 when it never has —
    which leaves the profile unopposed, because there is no swap to be stale
    against. Not the same as when the pointer was last written; see active_set."""
    try:
        with open(ACTIVE_AT_FILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 0


def active_name():
    """Which registered account is signed in RIGHT NOW.

    Two sources, and which one wins is decided by age, not by preference:

      - the pointer file records what ccd last installed
      - ~/.claude.json records who Claude Code last saw itself as

    The pointer is stale after the user runs /login themselves. The profile is
    stale for a short window after ccd swaps, because Claude Code does not
    re-read it until it restarts. Comparing profileFetchedAt against the time of
    our own swap tells us which staleness we are looking at, so neither one can
    overwrite the other's correct answer.

    Returns None when the signed-in account is registered nowhere. That is a real
    answer, not a failure: callers must not fall back to the pointer then, or
    they would attribute this session's tokens to an account that does not own
    them."""
    name, profiled = _signed_in()
    if profiled and name and _pointer_name() != name:
        # Self-heal after a /login, pointer only: ccd installed nothing. Decided
        # again under the store lock: a swap that finished since the read above
        # moved the pointer on purpose, and undoing it files the next backup under
        # the wrong account (#73). A held lock is skipped, not waited for — a later
        # call heals, and no reader should queue behind a swap to do it.
        try:
            with Lock(LOCK_FILE, wait=False):
                name, profiled = _signed_in()
                if profiled and name and _pointer_name() != name:
                    active_set(name, stamp=False)
        except (LockBusy, OSError):
            pass
    return name


def _signed_in():
    """active_name() without the repair: (account or None, whether the profile
    answered)."""
    uuid, _, fetched_at = live_identity()
    # Strictly after, matching _bank_target(): equal stamps leave the order
    # undecidable, and swap_to() banks CREDENTIALS from this answer, so a tie
    # accepted here files one account's tokens under another.
    if uuid and fetched_at > _active_at():
        # None: signed into an account ccd does not know.
        return next((a["name"] for a in accounts_all()
                     if a.get("account_uuid") == uuid), None), True
    # Either no identity is available (older Claude Code, unreadable config) or
    # the profile predates our swap and would answer with the account we just
    # left. The pointer is the better source in both cases.
    return _pointer_name(), False


def active_set(name, stamp=True):
    """Record which account is signed in; with `stamp`, also when ccd installed
    its credentials.

    Only a real credential write may stamp. Marking a pointer-only correction as
    an install dates ccd's "swap" AFTER the user's own /login, which makes the
    profile look stale forever and silently stops banking every later rotation —
    so the fix appears to work once and then rots."""
    write_atomic(ACTIVE_FILE, f"{name}\n", 0o600)
    if stamp:
        write_atomic(ACTIVE_AT_FILE, f"{int(time.time() * 1000)}\n", 0o600)


def live_identity():
    """Who is Claude Code signed in as right now — (accountUuid, email, fetched_at).

    Claude Code keeps this in ~/.claude.json under `oauthAccount`, refreshed at
    login. It is the one identifier that SURVIVES TOKEN ROTATION: access and
    refresh tokens change constantly, so "the token differs" can never
    distinguish an ordinary refresh from the user signing into a different
    account. accountUuid can, and reading it costs no network call.

    Everything that could otherwise corrupt the store depends on this: without it
    a manual /login is undetectable, and banking the outgoing session's tokens
    would file them under whatever name the stale pointer happened to hold."""
    seen = []
    for p in (os.path.join(claude_config_dir(), ".claude.json"),
              os.path.join(os.path.expanduser("~"), ".claude.json")):
        if p in seen:
            continue
        seen.append(p)
        acc = (read_json(p) or {}).get("oauthAccount")
        if isinstance(acc, dict):
            uuid = acc.get("accountUuid")
            if isinstance(uuid, str) and uuid:
                email = acc.get("emailAddress")
                # ms epoch of the last profile fetch. This is what makes the
                # identity usable right after a swap: Claude Code does not re-read
                # the profile until it next starts, so for a short window this
                # block still describes the account we just swapped AWAY from.
                fetched = acc.get("profileFetchedAt")
                fetched = fetched if isinstance(fetched, (int, float)) else 0
                return uuid, (email if isinstance(email, str) else ""), int(fetched)
    return None, "", 0


# Everything Claude Code caches about which account this is and what it may run.
# Taken from its own logout path, the only place that enumerates account-scoped
# state, so a swap drops exactly what a /login drops and nothing more.
#
# None of it is keyed by account, and the startup fetch that fills it never asks
# whether the account changed: `oauthAccount` is merged only while the uuid still
# matches, and the profile behind it refetches on a 24h timer. Leave these and the
# incoming account inherits the outgoing account's entitlements — a model the new
# plan includes still reads as credits-only — for a launch, or for a day.
ACCOUNT_SCOPED_CONFIG_KEYS = (
    "oauthAccount",
    "additionalModelOptionsCache",
    "additionalModelOptionsAnsweredAt",
    "additionalModelCostsCache",
    "modelAccessCache",
    "orgModelDefaultCache",
    "lastSeenOrgDefaultUpdatedAt",
    "clientDataCache",
    "clientDataCacheSlots",
    "autoCompactWindowsCache",
    "cachedUsageUtilization",
    "githubWebConnectionStatusCache",
    "startupPrefetchedAt",
)


def config_paths():
    """Every .claude.json Claude Code might read, in live_identity()'s order.

    Both are visited for the reason live_write() visits both credential stores: a
    stale copy left beside the live one resurrects the account we just left."""
    seen = []
    for p in (os.path.join(claude_config_dir(), ".claude.json"),
              os.path.join(os.path.expanduser("~"), ".claude.json")):
        if p not in seen:
            seen.append(p)
    return seen


def drop_account_scoped_config():
    """Forget what Claude Code cached about the account we just left.

    Claude Code owns this file, so this creates nothing and repairs nothing: an
    install without a config, or one we cannot parse, is left exactly as found.
    The credential move is what matters and must never be held hostage to the
    state of somebody else's file.

    Safe next to a running session, and needed there most of all — that session
    goes on running, and its NEXT launch reads this file. Claude Code's own writer
    re-reads under a lock and applies its change to what it finds on disk, and it
    watches the file for other processes, so a deletion survives its next write.
    What it cannot pick up is its own in-memory copy, which is why the caller says
    plainly which half of the account only moves at the next launch."""
    for path in config_paths():
        cfg = read_json(path)
        if cfg is None:
            continue                    # absent, or not ours to repair
        if not any(k in cfg for k in ACCOUNT_SCOPED_CONFIG_KEYS):
            continue                    # nothing stale; do not rewrite for nothing
        for k in ACCOUNT_SCOPED_CONFIG_KEYS:
            cfg.pop(k, None)
        try:
            mode = stat.S_IMODE(os.stat(path).st_mode)
        except OSError:
            mode = 0o600
        try:
            write_json(path, cfg, mode)
        except Exception:
            # Deliberately every exception, not just OSError. The credential swap
            # has already committed, and ccd-handoff reads a non-zero exit as "the
            # swap failed" and stops relaunching — stranding the user mid-handoff
            # over somebody else's file. A config Claude Code wrote can hold a lone
            # surrogate, which json.dumps(ensure_ascii=False) turns into a
            # UnicodeEncodeError on the way out; that is a ValueError, and the
            # narrower clause let it escape.
            warn(f"could not clear the cached account state in {path} — the new "
                 "account's models may take an extra restart to appear")


def _bank_target():
    """(account name, live oauth) when the live blob provably belongs to a
    registered account and differs from what is stored. None otherwise.

    Ordered cheapest-first and every gate fails closed, so a user who registered
    nothing returns before live_read() reaches the keychain."""
    uuid, _, fetched_at = live_identity()
    # `<=`, not `<`: equal stamps leave the order undecidable, so a tie is not
    # proof. active_name() applies the same rule, and must — swap_to() banks from
    # its answer. A missing .active-at reads as 0, which passes: ccd has installed
    # nothing, so there is no swap for the profile to be stale against.
    if not uuid or fetched_at <= _active_at():
        return None
    accounts = accounts_all()
    owner = next((a for a in accounts if a.get("account_uuid") == uuid), None)
    if not owner:
        return None            # signed into an account ccd does not know
    blob, _ = live_read()
    live = blob.get("claudeAiOauth")
    if not isinstance(live, dict) or not live.get("accessToken"):
        return None
    rt = live.get("refreshToken")
    if rt and any(
        a["name"] != owner["name"]
        and (a.get("claudeAiOauth") or {}).get("refreshToken") == rt
        for a in accounts
    ):
        # This token is already on file under a DIFFERENT account, so the profile
        # is not describing the blob — another account's session wrote it while
        # this one was signing in. Banking would hand this account a credential
        # that answers as somebody else, which is worse than a dead one.
        return None
    if (owner.get("claudeAiOauth") or {}) == live:
        return None            # the snapshot is already current
    return owner["name"], live


def bank_live_oauth():
    """Copy the live credentials into the account file that provably owns them.

    ccd stores a snapshot of a ONE-TIME key: Claude Code rotates the refresh
    token on every use and a `/login` mints a new one, so the snapshot dies the
    moment either happens outside a swap, and only spending it reveals that. The
    asymmetry is the whole design — writing the live blob back costs nothing,
    while testing the stored one costs the very rotation that killed it. So ccd
    copies rather than probes, before every command, which is what makes `/login`
    the only thing the user ever has to do.

    Two conditions must hold, and both are re-checked under the lock because the
    live blob is shared with every Claude Code process on the machine:

        owner  accountUuid names a registered account
        proof  the profile was fetched strictly after our last credential
               install; before that it still names the account a swap left, and
               banking on it would file the incoming tokens under the outgoing
               account

    Rationale, and the residual cases this cannot cover, live in
    docs/multi-account.md §12.0.1 through §12.0.5."""
    if not store_split() and _bank_target() is None:
        return                 # cheap pre-check: keeps the lock uncontended
    try:
        with Lock(LOCK_FILE, wait=False):
            # Under the lock, because a stop can land while we queue for it and
            # copying between stores that disagree is how the split spreads. It is
            # also where a healed store lifts its own stop, which is what makes
            # /login the only thing the user has to do.
            if store_split_now():
                return
            target = _bank_target()
            if target is None:
                return         # the blob moved while we waited
            name, live = target
            # Re-read under the lock: a concurrent rm or add must not be undone
            # by a record we loaded before taking it.
            acct = account_load(name)
            if not acct:
                return         # removed while we waited
            acct["claudeAiOauth"] = live
            # The snapshot really is this fresh. stale_spares() no longer keys on
            # it — a copy is not a refresh, which is the whole of #27.
            # quota_for() retires failure verdicts by credential identity, not
            # by this, so the two never race on second-granular clocks.
            acct["refreshed_at"] = now()
            account_save(name, acct)
    except LockBusy:
        return                 # another ccd holds the store; it banks on its own


# ── OAuth ────────────────────────────────────────────────────────────────────


# The instant this process's network work must be over, or None. urllib bounds
# each socket operation rather than the request, so this is what keeps a decision
# inside the budget the hook that started it actually has: every call is given
# what is left, and a call with nothing left is not made at all.
NET_DEADLINE = None


def net_left():
    """Seconds of network budget remaining, or None when unbounded."""
    if NET_DEADLINE is None:
        return None
    return NET_DEADLINE - time.time()


def _http_json(url, data=None, headers=None, timeout=HTTP_TIMEOUT):
    """Return (status, parsed_json_or_None). Never raises for HTTP errors —
    the caller needs the status to distinguish 401 (dead) from 503 (retry)."""
    left = net_left()
    if left is not None:
        if left <= 0:
            return 0, None      # the budget is gone; a request now cannot finish
        timeout = min(timeout, left)
    req = urllib.request.Request(url, data=data, method="POST" if data else "GET")
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", USER_AGENT)
    for k, v in (headers or {}).items():
        req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode("utf-8", "replace")
            try:
                return r.status, json.loads(body)
            except Exception:
                return r.status, None
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read().decode("utf-8", "replace"))
        except Exception:
            return e.code, None
    except Exception:
        return 0, None


def usage_fetch(access_token):
    status, body = _http_json(
        USAGE_URL,
        headers={
            "Authorization": f"Bearer {access_token}",
            "anthropic-beta": OAUTH_BETA,
        },
    )
    return status, body


def _window(body, key):
    w = (body or {}).get(key)
    if not isinstance(w, dict):
        return None, None
    u = w.get("utilization")
    if not isinstance(u, (int, float)) or isinstance(u, bool):
        return None, None
    reset = w.get("resets_at")
    return int(round(u)), (reset if isinstance(reset, str) else None)


def token_endpoint_order():
    """Remember which endpoint answered last time so the common case is one call."""
    try:
        with open(ENDPOINT_FILE) as f:
            pref = f.read().strip()
        if pref in TOKEN_URLS:
            return (pref,) + tuple(u for u in TOKEN_URLS if u != pref)
    except OSError:
        pass
    return TOKEN_URLS


def claude_ua():
    """User-Agent of the installed Claude Code build, e.g. "claude-cli/2.1.258
    (external, cli)".

    The token endpoint's front door throttles anything that does not present as
    the official client to a trickle — a request/day failed with 429 for weeks
    (anthropics/claude-code#38248 reports the same for other tools). The tokens
    being refreshed ARE Claude Code logins on Claude Code's client_id, so present
    them as the client they belong to, at whatever version is installed."""
    is_ver = lambda s: re.fullmatch(r"\d+(\.\d+)+", s) is not None
    # The native installer makes `claude` a symlink to .../versions/<x.y.z>, so
    # the binary on PATH names the version actually in use — including after a
    # downgrade, when the store still holds newer directories.
    for d in os.environ.get("PATH", "").split(os.pathsep):
        p = os.path.join(d, "claude")
        if os.path.isfile(p) and os.access(p, os.X_OK):
            ver = os.path.basename(os.path.realpath(p))
            if is_ver(ver):
                return f"claude-cli/{ver} (external, cli)"
            break
    # No claude on the hook's PATH: newest in the version store is the best guess.
    store = os.path.join(os.path.expanduser("~"), ".local", "share", "claude", "versions")
    try:
        versions = [v for v in os.listdir(store) if is_ver(v)]
    except OSError:
        versions = []
    ver = max(versions, key=lambda v: [int(x) for x in v.split(".")], default="2.1.0")
    return f"claude-cli/{ver} (external, cli)"


def token_refresh(refresh_token):
    """Exchange a refresh token. Returns (new_oauth_dict, status).

    The response ROTATES the refresh token: the value we sent is dead afterwards.
    Callers must persist the result before doing anything else with it."""
    payload = json.dumps(
        {
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
            "client_id": CLIENT_ID,
        }
    ).encode()
    last = 0
    for url in token_endpoint_order():
        status, body = _http_json(
            url,
            data=payload,
            headers={"Content-Type": "application/json", "User-Agent": claude_ua()},
        )
        last = status
        if status == 200 and isinstance(body, dict) and body.get("access_token"):
            try:
                write_atomic(ENDPOINT_FILE, url + "\n", 0o600)
            except Exception:
                pass
            expires_in = body.get("expires_in")
            oauth = {
                "accessToken": body["access_token"],
                # Anthropic always returns a new one, but fall back rather than
                # writing a null and bricking the account.
                "refreshToken": body.get("refresh_token") or refresh_token,
            }
            if isinstance(expires_in, (int, float)):
                oauth["expiresAt"] = int((time.time() + expires_in) * 1000)
            return oauth, status
        # 400/401 means this refresh token is dead; another endpoint will not
        # revive it. Only keep trying when the endpoint itself looks wrong.
        if status in (400, 401, 403):
            return None, status
    return None, last


def token_expired(oauth, skew=REFRESH_SKEW):
    exp = (oauth or {}).get("expiresAt")
    if not isinstance(exp, (int, float)):
        return True
    return (exp / 1000.0) <= (time.time() + skew)


def refresh_token_dead(oauth):
    exp = (oauth or {}).get("refreshTokenExpiresAt")
    if not isinstance(exp, (int, float)):
        return False
    return (exp / 1000.0) <= time.time()


def account_refresh(name, acct):
    """Refresh one stored account in place. Returns (ok, status_string).

    The exchange and the write it produces happen INSIDE the store lock, as one
    step — the shape keepalive_pass already uses. A probe is a read and can wait
    outside any lock; an exchange is a write that consumes a one-time credential,
    and one that straddles the lock can land on a record somebody re-registered,
    or complete with nowhere left to put it. Holding the lock means neither can
    happen: a lock we cannot take means the exchange never started, and nothing
    that was never spent can be lost.

    Ordering inside matters too: the rotated refresh token is written to disk
    BEFORE the new access token is used for anything. Crashing between the two
    costs one wasted access token; the reverse order costs the whole account."""
    # Cheap "don't start": no point queueing for a lock to do nothing with it.
    if active_name() == name:
        return False, "stale"
    try:
        with Lock(LOCK_FILE, fatal=False):
            # Everything the exchange depends on is established HERE, after the
            # wait. The pre-check above is about the world we saw; a swap can
            # finish, or Claude Code can publish a profile, while we queue.
            #
            fresh = account_load(name)
            if fresh is None:
                # Removed while we waited. The caller's snapshot is not a
                # registration, and saving from it would bring the account back.
                return False, "gone"
            oauth = fresh.get("claudeAiOauth") or {}
            rt = oauth.get("refreshToken")
            if not rt:
                return False, "dead"
            if refresh_token_dead(oauth):
                return False, "dead"
            # The thing an exchange can hurt is a CREDENTIAL, not a name: what
            # makes it harmful is spending the refresh token a live session is
            # carrying, and it is harmful whatever that account happens to be
            # called or whom the pointer names. So compare the token itself.
            #
            # This is also the check that cannot be overtaken. A name can become
            # live between here and the request — Claude Code publishes its
            # profile without touching any lock — but the only way OUR token
            # becomes the live one is a swap, and swaps take the lock we hold.
            #
            # Every readable backend, not the preferred one: with the keychain on
            # A and the file on B, comparing one blob drops B out of view and the
            # exchange spends the token a session is carrying. And a backend that
            # will not answer is unknown, which refuses — it may hold that token.
            # Every refresh token, identifiable credential or not.
            #
            # And never while a stop stands. The stop may name a backend this run
            # does not look at, and that backend may be holding this token.
            if store_split_now():
                return False, "unsure"
            held, blind = live_creds()
            if blind or not held:
                return False, "unsure"
            if any(rt == o.get("refreshToken") for o in held.values()):
                return False, "stale"
            new_oauth, status = token_refresh(rt)
            if not new_oauth:
                return False, ("dead" if status in (400, 401, 403) else "error")
            merged = dict(oauth)
            merged.update(new_oauth)
            # Anthropic does not echo refreshTokenExpiresAt; a successful rotation
            # issues a fresh ~8.5-day window, so advance it ourselves. Without this
            # the account would look dead to refresh_token_dead() forever after the
            # original expiry.
            merged["refreshTokenExpiresAt"] = int((time.time() + 8 * 86400) * 1000)
            fresh["claudeAiOauth"] = merged
            fresh["refreshed_at"] = now()
            # Two different facts, and conflating them is what let six consecutive
            # failures pass unreported. refreshed_at says the snapshot on disk is
            # this fresh, which bank_live_oauth() and swap_to() can write
            # truthfully after a copy. This says the token exchange itself worked,
            # which only happens here.
            fresh["refresh_ok_at"] = now()
            account_save(name, fresh)
    except LockBusy:
        # Somebody else owns the store and kept it. Nothing was spent, so there is
        # nothing to salvage and nothing to report but "not now".
        return False, "busy"
    # The caller measures the credential it is holding, so hand it what was
    # actually stored rather than what it walked in with.
    if fresh is not acct:
        acct.clear()
        acct.update(fresh)
    return True, "ok"


# ── Quota ────────────────────────────────────────────────────────────────────


def _cred_fingerprint(acct):
    """A short, non-secret id for the credential on file, so a cached verdict can
    name the token it measured. A truncated digest because the quota cache is no
    place to keep a token, and cannot be turned back into one."""
    at = ((acct or {}).get("claudeAiOauth") or {}).get("accessToken")
    if not isinstance(at, str) or not at:
        return ""           # no credential to name; every verdict about it is suspect
    return hashlib.sha256(at.encode()).hexdigest()[:16]


def _cache_row_valid(rec, acct):
    """Is this cached verdict still about THIS account's current credential?

    Two independent questions, and both have bitten:

      uuid  `add --force` can point an existing name at a DIFFERENT account. The
            quota cached under that name describes whoever held it before, and
            offering a handoff on it spends somebody else's headroom. Checked for
            every status, `ok` included — cmd_pick --no-probe trusts an `ok` row
            with no network call at all.
      cred  a failure verdict measured against a token that banking has since
            replaced is about a credential that no longer exists; serving it is
            what made a repaired account keep reporting `needs re-login`. Only
            asked of a failure while a uuid is available: a quota reading survives
            a token change, because quota belongs to the account rather than to
            the credential.

    Neither is a deletion, so a concurrent writer holding an older copy of the
    whole cache cannot undo them by writing it back."""
    if not isinstance(rec, dict):
        return False
    uuid = acct.get("account_uuid")
    if not uuid:
        # Registered from a Claude Code that published no identity. Nothing
        # durable distinguishes one holder of this name from the next, so the
        # credential has to answer for the account too, `ok` rows included.
        return rec.get("cred") == _cred_fingerprint(acct)
    if rec.get("uuid") != uuid:
        return False
    if rec.get("status") != "ok" and rec.get("cred") != _cred_fingerprint(acct):
        return False
    return True


def reading_path(name):
    return os.path.join(READINGS_DIR, f"{name}.json")


def reading_lock(name):
    return os.path.join(READINGS_DIR, f".{name}.lock")


def reading_load(name):
    return read_json(reading_path(name)) if valid_name(name) else None


def reading_save(name, rec):
    """Publish one account's reading. Nothing here can touch another account's.

    Two probers of the SAME account can still finish out of order. A reading is
    stamped when its answer arrives, so the later stamp is the later look at the
    server, and an older one does not replace it. A stamp from the future is a
    wrong clock, not a newer reading, and does not block.

    "Check, then replace" is one step, under a lock of the account's own. Without
    it a writer that has passed the check can be descheduled for any length of
    time before its rename, and then puts an old reading back over a newer one —
    nothing bounds that pause, so "they describe the same second" was a hope.
    Only the file work is inside: the network wait that produced `rec` is over
    before this is called. A lock that cannot be had means the reading is not
    published, which is always safe: an unpublished reading proves nothing and
    offers nowhere to go. The lock is a dotfile, so nothing that lists
    readings/*.json ever sees it."""
    ensure_dirs()
    try:
        with Lock(reading_lock(name), fatal=False):
            theirs = (reading_load(name) or {}).get("checked_at")
            if isinstance(theirs, (int, float)) and rec["checked_at"] < theirs <= now():
                return
            write_json(reading_path(name), rec, 0o600)
    except LockBusy:
        return


def reading_drop(name):
    for p in (reading_path(name), reading_lock(name)):
        try:
            os.unlink(p)
        except OSError:
            pass


def reading_fresh(rec, ttl):
    """Is this reading young enough to stand for now? The ONE freshness rule, for
    the swap, the cache-only tick and the proof alike. Age is bounded on both
    sides: a reading from the future is a wrong clock, and after a backward clock
    step it would otherwise sit there "fresh" — pinning a spent verdict and keeping
    a usable account from ever being measured again."""
    ts = (rec or {}).get("checked_at")
    return isinstance(ts, (int, float)) and not isinstance(ts, bool) and 0 <= now() - ts < ttl


def probe_account(name, acct, allow_refresh=True):
    """Read one account's quota, refreshing its token first if needed.

    Returns a record shaped like the files under readings/."""
    rec = {"checked_at": now(), "status": "error"}
    oauth = acct.get("claudeAiOauth") or {}

    if token_expired(oauth):
        if not allow_refresh:
            rec["status"] = "stale"
            return rec
        ok, why = account_refresh(name, acct)
        if not ok:
            rec["status"] = why
            return rec
        oauth = acct.get("claudeAiOauth") or {}

    status, body = usage_fetch(oauth.get("accessToken", ""))
    if status == 401 and allow_refresh:
        # The stored expiry lied (clock skew, or a token revoked early). One
        # refresh, one retry — never a loop.
        ok, why = account_refresh(name, acct)
        if not ok:
            rec["status"] = why
            return rec
        status, body = usage_fetch(
            (acct.get("claudeAiOauth") or {}).get("accessToken", "")
        )
    if status != 200 or not isinstance(body, dict):
        rec["status"] = "dead" if status in (401, 403) else "error"
        rec["http_status"] = status
        return rec

    fh, fhr = _window(body, "five_hour")
    sd, sdr = _window(body, "seven_day")
    if fh is None and sd is None:
        return rec  # unusable payload — stays "error", never treated as headroom
    rec.update(
        {
            "status": "ok",
            "five_hour_percent": fh,
            "seven_day_percent": sd,
            "five_hour_reset": fhr,
            "seven_day_reset": sdr,
        }
    )
    return rec


def cache_ttl_for(status, ttl):
    """Negative caching. Without it a dead or unreachable account is re-probed on
    every hook tick — the hook fires on each prompt and each tool use, so that is
    a network round trip several times a minute for an account that needs a manual
    re-login anyway."""
    if status == "ok":
        return ttl
    if status == "dead":
        return ttl * 4  # only a human re-login changes this
    return 60  # stale/error: transient, retry soon but not every tick


def quota_for(name, acct, ttl=CANDIDATE_TTL, allow_refresh=True):
    rec = reading_load(name)
    if isinstance(rec, dict):
        # Identity before age: a row can be fresh and still be about the wrong
        # account or a replaced token. Clocks cannot answer either question —
        # now() is second-granular, so a bank and a probe in the same second are
        # a tie, and probe_account may refresh mid-probe, which would make a
        # verdict look older than the very token it measured.
        if _cache_row_valid(rec, acct) and reading_fresh(
                rec, cache_ttl_for(rec.get("status"), ttl)):
            return rec
    rec = probe_account(name, acct, allow_refresh=allow_refresh)
    # Stamped after the probe: it may have refreshed the token, and the verdict
    # belongs to whichever credential it ended up measuring.
    rec["cred"] = _cred_fingerprint(acct)
    rec["uuid"] = acct.get("account_uuid")
    # ...and so is the time: when the answer arrived, not when the question was
    # asked. That is what makes "the later stamp wins" mean the later look.
    rec["checked_at"] = now()
    reading_save(name, rec)
    return rec


def has_headroom(rec):
    """No window the account reports may be spent (window_spent).

    A destination is any account that is not spent: 99% is a destination. There
    is no reserve below that — the reserve is what made "not worth hopping to"
    and "spent enough to pay for" the same answer.

    The 7-day window is not optional: an account whose 5h just reset but whose
    weekly is at 99% dies again within minutes, burning a hop and showing the
    user two unexplained screen changes on the way to the same destination."""
    if rec.get("status") != "ok":
        return False
    vals = [
        rec.get("five_hour_percent"),
        rec.get("seven_day_percent"),
    ]
    vals = [v for v in vals if isinstance(v, (int, float))]
    if not vals:
        return False
    return not any(window_spent(v) for v in vals)


def worst(rec):
    vals = [rec.get("five_hour_percent"), rec.get("seven_day_percent")]
    vals = [v for v in vals if isinstance(v, (int, float))]
    return max(vals) if vals else 100


# ── The swap ─────────────────────────────────────────────────────────────────


def swap_guard_read():
    """Accounts an automatic swap has left recently, as {name: (when, window)}.

    A swap must not be sent back to the account it just left as spent: a cached
    row claiming room for a spent account would otherwise walk the session back
    and forth between two of them. Recording where a swap came FROM, rather than
    refusing to leave, is what keeps that impossible without ever stranding a
    session: leaving is always allowed, only returning is held off.

    Lines are `<epoch>TAB<account>TAB<window key>`. Anything else is not a record,
    and anything older than the TTL has stopped describing now."""
    live = {}
    try:
        with open(SWAP_GUARD) as f:
            lines = f.read().splitlines()
    except OSError:
        return live
    cutoff = now() - SWAP_GUARD_TTL
    for line in lines:
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        try:
            when = int(parts[0])
        except ValueError:
            continue
        if when < cutoff or not parts[1]:
            continue
        if parts[1] not in live or when > live[parts[1]][0]:
            live[parts[1]] = (when, parts[2])
    return live


def swap_guard_record(name, window):
    """Remember that a swap has just left `name`, and drop what has aged out.

    One line per account, so the file cannot grow past the store, and the bound is
    time alone — a count evicts entries that still describe now, which is how an
    account a swap had just left became a destination again."""
    live = swap_guard_read()
    live[name] = (now(), window or "none")
    try:
        write_atomic(SWAP_GUARD,
                     "".join(f"{w}\t{n}\t{k}\n" for n, (w, k) in sorted(live.items())))
    except OSError:
        pass            # the swap happened; losing the note is not worth failing it




def swap_to(name, force=False, deadline=None):
    """Replace only the claudeAiOauth subtree of the live blob.

    Called with a session live and mid-turn: the quota hook swaps in place (#57).
    Claude Code reads this store per request and writes it only when it rotates a
    token. Measured: a swapped session kept working for 16.9 hours across two
    refreshes without a restart. The one coordination it needs is Claude Code's
    own locks, held from the first read of the live store to the last check of it
    (claude_code_locks), so a rotation in flight lands before the backup reads.
    `deadline` bounds every wait for a lock, ours and Claude Code's alike, and an
    expired one means no write at all.

    Holding them at the start is not holding them now, so the lease is asked again
    before the bank and before every live-store write, and a lapsed one writes
    nothing (#96).

    Returns (account, installed credential, replaced credential). The first names
    what a confirmation should find live; the second names what it must NOT find,
    which is what lets a legitimate rotation during the settle still confirm.

    The account is loaded INSIDE the lock. Loaded before it, the copy can already
    have been replaced by the time it is written — every refresh mints a new
    one-time token, so installing a snapshot hands the session a token the server
    has retired, which is a dead spare at the worst possible moment."""
    if deadline is None:
        deadline = time.time() + LOCK_TIMEOUT
    # Ours first: Claude Code never takes it, so nothing can wait in a cycle. And
    # no floor under the wait — half a second granted on top of a budget that has
    # run out is half a second in which this process can still start writing.
    with Lock(LOCK_FILE, timeout=max(0.0, deadline - time.time())), \
            claude_code_locks(deadline) as lease:
        split = store_split_now()
        if split:
            die(split_text(split))
        target = account_load(name)
        if not target:
            die(f"no such account: {name}")
        oauth = target.get("claudeAiOauth")
        if not isinstance(oauth, dict) or not oauth.get("accessToken"):
            die(
                f"account '{name}' has no usable credentials — run `claude` and "
                f"sign in with /login as that account"
            )
        blob, sources = live_read()
        if not blob:
            die("could not read the current Claude credentials")

        # Back up whatever Claude Code rotated into the live blob during the
        # session that just ended. Skipping this throws away every token refresh
        # the outgoing account accumulated, and coming back to it later would use
        # a stale — possibly already-rotated-away — refresh token.
        # active_name() prefers accountUuid but falls back to the pointer when
        # Claude Code publishes no identity, and that fallback is the only source
        # on such an install — which is why bank_live_oauth() cannot replace this.
        # When it returns None the session belongs to an unregistered account and
        # there is nothing to bank; writing anywhere would file these tokens
        # under a name that does not own them.
        cur = active_name()
        live_oauth = blob.get("claudeAiOauth")
        # One question for the backup and for the evening below: does the blob
        # live_read() prefers hold a login at all? Banking one that does not
        # overwrites a healthy snapshot with something ccd would refuse to install.
        has_login = bool(cred_identity(live_oauth))
        if cur and has_login:
            prev = account_load(cur)
            if prev:
                prev["claudeAiOauth"] = live_oauth
                prev["refreshed_at"] = now()
                # Only while the locks are still ours. Lost since the read, they
                # were somebody's to refresh under — and what this is about to bank
                # is then a token the server may already have retired, which is a
                # dead spare filed as a live one (#96).
                lease.hold("nothing was changed")
                account_save(cur, prev)

        # Already signed in as the target: the live blob is this account's own and
        # newer than `oauth`, which was read before that backup. Installing it
        # would trade a working token for the stale copy the user asked us to
        # repair. The two live sources must still be put back in step, though —
        # that is the whole reason live_write exists, and a stale
        # ~/.credentials.json beside a good keychain resurrects the old account.
        if cur == name:
            # No write-ahead record here: every backend is being handed what one
            # of them already holds, so a partial failure cannot make them
            # disagree about anything they agreed on before.
            #
            # And only a blob that HOLDS a login. live_read() prefers the keychain,
            # and a keychain left with nothing but mcpOAuth would otherwise be
            # copied over the login in the file, erasing the only credential.
            evened, failed = True, []
            if has_login:
                lease.hold("the credential stores were not touched")
                evened, failed, _ = live_write(blob, sources)
            else:
                warn("the credentials Claude Code is reading hold no login — nothing "
                     "was backed up or copied. Sign in with /login.")
            if not evened:
                # Not fatal: nothing was supposed to change and the credential in
                # use is still good. But a silent failure here is how a stale
                # fallback file survives to resurrect the previous account.
                warn("could not put the credential stores back in step ("
                     + ", ".join(failed) + ")")
        else:
            new_blob = dict(blob)
            new_blob["claudeAiOauth"] = oauth  # surgical: mcpOAuth and friends survive
            targets = write_targets(sources)
            # Write-ahead. Between the first backend taking the new credential and
            # the last, the stores disagree; dying in there with nothing recorded
            # is how the next command files one account's credential under the
            # other's name. So the intent goes down first, and a state directory
            # that cannot hold it means no credential is written at all.
            if not mark_store_split(
                    f"a swap to {name} has not been seen to land on every store",
                    targets):
                die("cannot record what this swap is about to change ("
                    + STORE_SPLIT + ") — refusing to touch the credential stores "
                    "without it")
            # The last look before the write that matters. A lease lost here means
            # the record is standing over stores nothing has touched, so it comes
            # back down: they still agree, and a stop nobody needs would block
            # every bank and swap after this one.
            if lease.lapsed():
                clear_store_split()
                lease.hold("the credential stores were not touched")
            installed, failed, written = live_write(new_blob, sources)
            if not installed:
                # Some backends took the new credential and some did not: the
                # stores now disagree about who is signed in, and the next bank
                # copies one half over the other. Put back what the session is
                # still holding.
                note = ", ".join(failed)
                stuck = list(written)
                if written and lease.lapsed():
                    # Putting it back is a write too, and this one would be made
                    # without the lock — the #67 write over again, in the other
                    # direction, over whatever the lock's new owner is saving. So
                    # the backends that took the new credential keep it, and the
                    # record stands over them.
                    note += ("; did not restore " + ", ".join(written)
                             + " — " + lease.note())
                elif written:
                    _, undo_failed, _ = live_write(blob, sources)
                    # What the ROLLBACK achieved, not what the install attempted: a
                    # backend that refused the new credential refuses the redundant
                    # restore too, and it never moved. Recording that as a split
                    # stops a machine that is perfectly consistent.
                    stuck = [b for b in written if b in undo_failed]
                    if stuck:
                        note += "; could not restore " + ", ".join(stuck)
                if not stuck:
                    clear_store_split()
                    die("failed to write the credential store (" + note + ")")
                mark_store_split(
                    f"{', '.join(stuck)} took {name}'s credential, "
                    f"{', '.join(b for b in targets if b not in stuck)} kept "
                    f"the one before it", targets)
                die("failed to write the credential store (" + note + ")"
                    + "\n     " + split_way_out())
            # Every write succeeded, and that is the best knowledge there is of
            # whose credential is live — so ownership moves now, whatever the
            # verify below finds. Gating the pointer on a READ left B installed
            # under a pointer saying A, and the next backup filed B under A.
            active_set(name)
            # The credential is only half of an account. The other half is what
            # Claude Code cached about the one we just left.
            drop_account_scoped_config()
            # And the third half is what WE cached about it. quota-cache.json holds
            # the signed-in account's usage; after this it describes somebody else,
            # and the statusline's red warning reads it with no idea a swap happened.
            # Deleting beats rewriting: the next hook tick measures the new account,
            # and until then "unknown" is the only honest answer.
            try:
                os.unlink(os.path.join(CCD_DIR, "quota-cache.json"))
            except OSError:
                pass
            # The RECORD is what waits for evidence. Two writes succeeding proves
            # only that ccd wrote twice, and Claude Code's locks bind only a
            # Claude Code that takes them. So it goes away by the same rule as
            # always — stores SEEN to agree — and otherwise stands, stopping every
            # bank, swap and exchange until they are.
            # Not fatal: the swap happened, and a caller told otherwise retries
            # into a store that has already moved.
            split = store_split_now()
            if split:
                warn(f"switched to {name}, but " + split_text(split))
        # What the next confirmation has to match. Taken here, inside the lock,
        # from the very dict that was written — not from a later read, which a
        # rotation could already have moved on.
        installed = _cred_fingerprint(
            target if cur != name else {"claudeAiOauth": blob.get("claudeAiOauth")})
        replaced = _cred_fingerprint({"claudeAiOauth": blob.get("claudeAiOauth")})

    if not force:
        others = claude_processes()
        if others:
            # One credential store, so the swap reaches them as well. What that
            # does and does not move is the same everywhere, and the caller prints
            # it next — so this line says only what is specific to them.
            noun = "session is" if others == 1 else "sessions are"
            warn(f"{others} other Claude Code {noun} running — this moves them to "
                 f"{name} too, from their next token refresh.")
    return target, installed, replaced


def claude_processes():
    try:
        p = subprocess.run(
            ["pgrep", "-x", "claude"], capture_output=True, text=True, timeout=5
        )
    except Exception:
        return 0
    if p.returncode != 0:
        return 0
    return len([x for x in p.stdout.split() if x.strip()])


# ── Commands ─────────────────────────────────────────────────────────────────


def cmd_add(args):
    ensure_dirs()
    blob, _ = live_read()
    oauth = blob.get("claudeAiOauth")
    if not isinstance(oauth, dict) or not oauth.get("accessToken"):
        die("no Claude login found — run `claude` and sign in first")

    uuid, email, _ = live_identity()

    # Re-registering an account ccd already knows is the normal repair for an
    # expired spare, so update it in place instead of demanding --force.
    known = None
    if uuid:
        known = next((a for a in accounts_all() if a.get("account_uuid") == uuid), None)

    name = args.name or (known or {}).get("name")
    if not name:
        # The email local part is the name people would pick anyway; fall back to
        # the plan when no identity is available.
        base = email.split("@")[0] if email else (oauth.get("subscriptionType") or "account")
        base = re.sub(r"[^a-z0-9]+", "-", base.lower()).strip("-") or "account"
        name = base
        i = 2
        while os.path.exists(account_path(name)):
            name = f"{base}{i}"
            i += 1
    if not valid_name(name):
        die("account name must be letters, digits, dot, dash or underscore (max 64)")

    existing = account_load(name)
    if existing and not args.force and not (known and known["name"] == name):
        die(f"account '{name}' already exists — use --force to replace it")

    # One account, one entry. Two names for the same login would present a spare
    # that is really the account that just ran out.
    if known and known["name"] != name and not args.force:
        die(
            f"this login is already registered as '{known['name']}' — "
            f"sign in to the other account first, then run add again"
        )
    if not uuid:
        rt = oauth.get("refreshToken")
        for other in accounts_all():
            if other["name"] == name or not rt:
                continue
            if (other.get("claudeAiOauth") or {}).get("refreshToken") == rt:
                die(
                    f"this login is already registered as '{other['name']}' — "
                    "sign in to the other account first, then run add again"
                )

    priority = args.priority
    if priority is None:
        used = [a.get("priority", 0) for a in accounts_all() if a["name"] != name]
        priority = (max(used) + 1) if used else 1

    acct = {
        "name": name,
        # The email is the label people would type anyway, and Claude Code already
        # knows it — so nobody has to supply one.
        "label": args.label or email or (existing or {}).get("label", ""),
        "account_uuid": uuid,
        "priority": priority,
        "storage": "file",
        "claudeAiOauth": oauth,
        "added_at": (existing or {}).get("added_at") or now(),
        "refreshed_at": now(),
        # Carried across like added_at: re-registering the same account must not
        # erase what we know about its refreshes (#27).
        "refresh_ok_at": (existing or {}).get("refresh_ok_at"),
        "subscription_type": oauth.get("subscriptionType"),
        "rate_limit_tier": oauth.get("rateLimitTier"),
    }
    with Lock(LOCK_FILE):
        account_save(name, acct)
        # Registering records who is signed in; it installs no credentials.
        active_set(name, stamp=False)

    plan = acct["subscription_type"] or "unknown"
    print(f"{C_GRN}✓{C_RESET} registered {C_BOLD}{name}{C_RESET} ({plan}), priority {priority}")
    total = len(account_names())
    if total < 2:
        print(
            f"{C_DIM}  Sign in to your other account (`claude` → /login), then run "
            f"`ccd account add` again.{C_RESET}"
        )
    else:
        print(f"{C_DIM}  {total} accounts registered. `ccd account list` to check quota.{C_RESET}")
    return 0


def cmd_list(args):
    accounts = accounts_all()
    cur = active_name()
    if not accounts:
        if args.json:
            print(json.dumps({"accounts": [], "active": None}))
        else:
            print(f"{C_DIM}No accounts registered. Run `ccd account add`.{C_RESET}")
        return 0

    rows = []
    for a in accounts:
        name = a["name"]
        if name == cur:
            # Claude Code owns the live token; never refresh it from here.
            rec = quota_for(name, a, ttl=CANDIDATE_TTL, allow_refresh=False)
        else:
            rec = quota_for(name, a, ttl=CANDIDATE_TTL, allow_refresh=True)
        rows.append((a, rec))

    if args.json:
        print(
            json.dumps(
                {
                    "active": cur,
                    "accounts": [
                        {
                            "name": a["name"],
                            "label": a.get("label", ""),
                            "priority": a.get("priority"),
                            "subscription_type": a.get("subscription_type"),
                            "active": a["name"] == cur,
                            "quota": rec,
                            "headroom": has_headroom(rec),
                        }
                        for a, rec in rows
                    ],
                },
                ensure_ascii=False,
            )
        )
        return 0

    print(f"\n{C_BOLD}Claude accounts{C_RESET}")
    for a, rec in rows:
        mark = f"{C_GRN}●{C_RESET}" if a["name"] == cur else f"{C_DIM}○{C_RESET}"
        label = a.get("label") or a.get("subscription_type") or ""
        st = rec.get("status")
        if st == "ok":
            fh = rec.get("five_hour_percent")
            sd = rec.get("seven_day_percent")
            parts = []
            if isinstance(fh, (int, float)):
                parts.append(f"5h {fh}%")
            if isinstance(sd, (int, float)):
                parts.append(f"7d {sd}%")
            usage = " · ".join(parts)
            tint = C_GRN if has_headroom(rec) else C_YLW
            body = f"{tint}{usage}{C_RESET}"
        elif st == "dead":
            body = f"{C_RED}needs re-login{C_RESET}"
        elif st == "stale":
            body = f"{C_DIM}token stale{C_RESET}"
        else:
            body = f"{C_DIM}unreachable{C_RESET}"
        print(
            f"  {mark} {a['name']:<14} {C_DIM}p{a.get('priority', '?'):<3}{C_RESET} "
            f"{body}   {C_DIM}{label}{C_RESET}"
        )
    dead = [a["name"] for a, rec in rows if rec.get("status") == "dead"]
    if dead:
        print(
            f"\n{C_YLW}!{C_RESET} re-login needed for: {', '.join(dead)}\n"
            f"{C_DIM}  Run `claude` and sign in with /login as that account. ccd "
            f"stores the new token itself — there is nothing else to run.{C_RESET}"
        )
    return 0


def cmd_rm(args):
    name = args.name
    acct = account_load(name)
    if not acct:
        die(f"no such account: {name}")
    path = account_path(name)
    with Lock(LOCK_FILE):
        # Overwrite before unlinking: the file holds a refresh token that is good
        # for days, and a plain unlink leaves it recoverable on many filesystems.
        try:
            size = os.path.getsize(path)
            with open(path, "r+b") as f:
                f.write(os.urandom(size))
                f.flush()
                os.fsync(f.fileno())
        except OSError:
            pass
        try:
            os.unlink(path)
        except OSError as e:
            die(f"could not remove {path}: {e}")
        reading_drop(name)
        if active_name() == name:
            try:
                os.unlink(ACTIVE_FILE)
            except OSError:
                pass
    print(f"{C_GRN}✓{C_RESET} removed {name}")
    return 0


def cmd_use(args):
    """Switch the active account. With no name, take the best spare as measured
    right now — the one place a person still had to supply a fact ccd measures
    anyway."""
    name = args.name
    if name is None:              # `use ""` stays a bad name, not a request to choose
        a, why = best_target()
        if a is None:
            die("no spare is known to have room — `ccd account list` shows each one"
                if why == "all_exhausted"
                else "no other account is registered — add one with `ccd account add`")
        name = a["name"]
    target, _, _ = swap_to(name, force=args.force)
    if args.json:
        print(
            json.dumps(
                {
                    "account": name,
                    "label": target.get("label", ""),
                    "subscription_type": target.get("subscription_type"),
                },
                ensure_ascii=False,
            )
        )
    else:
        label = target.get("label") or target.get("subscription_type") or ""
        print(f"{C_GRN}✓{C_RESET} switched to {C_BOLD}{name}{C_RESET} {C_DIM}{label}{C_RESET}")
        # The half that moves needs no explanation; the half that does not is the
        # one people read as a failed swap (#12). Say it here, once, rather than
        # leave it to be discovered from a model list that names the old plan.
        print(f"{C_DIM}  Running sessions keep working — their requests bill to "
              f"{name} from the next token refresh. No restart.{C_RESET}")
        print(f"{C_DIM}  What lags: the model list and limits, Fable access and the "
              f"/status identity keep describing the previous account until the "
              f"next launch.{C_RESET}")
    return 0


def cmd_swap(args):
    """Move this session to a spare. Internal: the quota hook.

    Two phases and two outcomes. Measuring is network work, so it happens with no
    lock held; installing is a write, so it happens under the store lock with the
    caller's claim re-checked there — a person running `ccd account use` while we
    measured must not have their swap overwritten by ours.

    Prints `<account>TAB<installed credential>TAB<the credential it replaced>` and
    exits 0, or prints one line saying why not and exits non-zero. Nothing about
    that reason is evidence of anything, and nothing acts on it: whether the paid
    hop is allowed is a separate question with its own proof (cmd_exhausted)."""
    names = account_names()
    if not names:
        return _swap_no("no accounts registered")
    deadline = time.time() + max(0.0, args.deadline)
    try:
        a, rec = best_target(
            no_probe=args.no_probe, deadline=deadline,
            exclude={n: w for n, (_when, w) in swap_guard_read().items()})
        if a is None:
            return _swap_no(rec)
        # One acquisition for the whole install: the claim, the credential and the
        # record are one change or none of them.
        left = max(0.5, deadline - time.time())
        with Lock(LOCK_FILE, timeout=left):
            cur = active_name()
            # Re-read the departures here, not from the snapshot the measurement
            # used: another swap can record one while we measure, and the account
            # it just left is the one account we must not install.
            if _guard_holds(a["name"], rec,
                            {n: w for n, (_w, w) in swap_guard_read().items()}):
                return _swap_no("another swap had just left that account")
            # No name for the signed-in login is a supported install, not a
            # refusal: with one account registered, that account IS the spare
            # (#41). There is simply nothing to compare the claim against.
            if args.from_account and cur and args.from_account != cur:
                return _swap_no("the store moved while this was being decided")
            _, installed, replaced = swap_to(a["name"], force=True,
                                             deadline=deadline)
            if cur:
                swap_guard_record(cur, args.window)
    except SystemExit:
        # die(): the store lock stayed busy for the whole budget, or the account
        # lost its credential between the measurement and the install.
        return _swap_no("could not install the credential")
    except Exception as e:
        return _swap_no(f"{type(e).__name__}")
    print(f"{a['name']}\t{installed}\t{replaced}")
    return 0


def _swap_no(reason):
    """One line, on stderr, for the caller's breadcrumb. Exit 4 for everything:
    the only question worth asking after a failed swap is whether every
    subscription is measurably spent, and no exit code can answer that."""
    print(reason, file=sys.stderr)
    return 4


def _still_spent(rec):
    """Does this reading show a window that is out of room AND still open?

    A window that has reset since it was read says nothing about now, however
    recently it was read — so a window counts only while it is KNOWN to be open:
    its reset time parses, names its timezone, and is in the future. 99% with no
    usable reset can have reset a second later while the row stays fresh for
    minutes; a naive time is a guess about whose clock it was. Neither is proof."""
    for pct, reset in ((rec.get("five_hour_percent"), rec.get("five_hour_reset")),
                       (rec.get("seven_day_percent"), rec.get("seven_day_reset"))):
        if not window_spent(pct):
            continue
        try:
            at = datetime.datetime.fromisoformat(reset.replace("Z", "+00:00"))
        except (AttributeError, ValueError, TypeError):
            continue
        if at.utcoffset() is not None and at.timestamp() > time.time():
            return True
    return False


def subscriptions_proved_spent():
    """Is it PROVED that no subscription can take this session? True or False.

    The one question that may authorise spending the user's money, so it is
    answered from positive evidence and from nothing else:

      - the accounts directory was read — not "listing it failed, so it is empty"
      - every registered account file in it was read
      - the credential stores are not under a stop
      - EVERY registered account — the one the store is on included, no
        exceptions — has a reading that is about its current identity, SUCCEEDED,
        is younger than CANDIDATE_TTL (the age at which a swap stops trusting a
        reading and measures again), and shows a window out of room that is known
        not to have reset. No account registered at all is also proof, vacuously.

    Nobody is excluded, because "the active account" is not this session's to
    define: another session can swap the store onto an account with room while
    this one is at the wall, and a proof that skipped whoever is active would then
    skip exactly the account that could have taken the session.

    It opens no socket, takes no lock, spends no token and writes nothing: the swap
    attempt that comes before it has just measured every spare, the wall re-read
    before THAT has just measured and published the account the store is on
    (cmd_usage), and this reads what they left behind. So a timeout, a 503, a busy store, an expired deadline or a refused
    swap cannot become a yes here — each leaves a row that is stale, failed,
    missing, or shows room, and every one of those is a no.
"""
    if store_split() is not None:
        return False
    try:
        entries = os.listdir(ACCOUNTS_DIR)
    except FileNotFoundError:
        entries = []        # the kernel's own answer: a store that was never created
    # ...and any OTHER failure raises, rather than reading as an empty store.
    names = sorted(e[:-5] for e in entries
                   if e.endswith(".json") and not e.startswith(".") and valid_name(e[:-5]))
    accounts = {n: account_load(n) for n in names}
    if any(a is None for a in accounts.values()):
        return False
    for name, acct in accounts.items():
        rec = reading_load(name)
        if not _cache_row_valid(rec, acct) or rec.get("status") != "ok":
            return False
        if not reading_fresh(rec, CANDIDATE_TTL):
            return False
        if not _still_spent(rec):
            return False
    return True


# The proof, as the hook reads it: this exact word on stdout AND exit 0. Printed in
# one place, as the last thing cmd_exhausted does — so a die(), a SystemExit, an
# uncaught exception or a bare non-zero exit is structurally unable to produce it.
EXHAUSTED_PROOF = "every-subscription-measured-spent"


def cmd_exhausted(args):
    """Internal: the quota hook. See subscriptions_proved_spent()."""
    if subscriptions_proved_spent() is not True:
        return 1
    print(EXHAUSTED_PROOF)
    return 0


def cmd_refresh(args):
    cur = active_name()
    if args.name:
        names = [args.name]
    else:
        names = account_names()
    if not names:
        die("no accounts registered")

    rc = 0
    for name in names:
        if args.inactive_only and name == cur:
            continue
        if name == cur and not args.name:
            # Claude Code owns the live token. Refreshing it here would rotate the
            # refresh token out from under a running session.
            continue
        acct = account_load(name)
        if not acct:
            continue
        ok, why = account_refresh(name, acct)
        if ok:
            print(f"{C_GRN}✓{C_RESET} {name}")
        else:
            rc = 1
            hint = {"dead": "needs re-login",
                    "busy": "the store was busy — try again",
                    "gone": "no longer registered",
                    "stale": "signed in here — Claude Code renews it",
                    "unsure": "cannot see the live credential — not spending it"
                    }.get(why, "unreachable")
            print(f"{C_RED}✗{C_RESET} {name} — {hint}")
    # A clean sweep of every spare is a repair, and the backoff keepalive computes
    # from the failure count no longer describes anything. Only here: writing this
    # marker also resets the schedule it carries, so a single account's success must
    # never claim it — that postpones the pass a DIFFERENT spare is waiting for.
    if rc == 0 and not args.name:
        try:
            write_json(KEEPALIVE_MARK, {"fails": 0}, 0o600)
        except Exception:
            pass
    return rc


def _window_key(rec):
    """The reset timestamps a reading names, in the shape the guard records."""
    return ";".join(
        f"{label}={rec.get(key)}"
        for label, key in (("5h", "five_hour_reset"), ("7d", "seven_day_reset"))
        if isinstance(rec.get(key), str) and rec.get(key)
    )


def _guard_holds(name, rec, exclude):
    """Is this account still the one a swap just left?

    Only a window both sides can name can say the situation has changed. When the
    record says `none`, or the candidate's own reading names no window, we cannot
    tell — and cannot tell is not permission to go back."""
    recorded = (exclude or {}).get(name)
    if recorded is None:
        return False
    if not recorded or recorded == "none":
        return True
    theirs = _window_key(rec)
    if not theirs:
        return True
    # Same windows, or nothing to compare. Half an answer — one window named
    # where the record names two — cannot say a reset happened, and guessing
    # that it did is how a loop guard stops guarding.
    mine = dict(p.split("=", 1) for p in recorded.split(";") if "=" in p)
    yours = dict(p.split("=", 1) for p in theirs.split(";") if "=" in p)
    if set(mine) != set(yours):
        return True
    return mine == yours


def best_target(no_probe=False, exclude=None, deadline=None):
    """(account, reading) for the best place to hand off, or (None, reason).

    One selection rule for every caller — the hook, the statusline, and a person
    typing `ccd account use` — so they can differ only in what they pass in.

    `exclude` is {name: window} for the accounts a swap has just left
    (swap_guard_read). A name alone is not enough to keep one out: the record says
    which windows it was written in, and an account whose own reading now names
    different resets has had a reset since — a new situation, and a destination
    again. On a two-account install that difference is the whole escape.

    `deadline` is a wall-clock instant past which no candidate is worth a network
    probe: this runs inside a hook that is killed on its timeout, and one usable
    spare behind nine expired ones can spend the whole budget before the swap even
    starts. Past it the rest are judged on cache alone, which costs nothing and
    can still say yes. It bounds each request too (NET_DEADLINE), because urllib
    bounds socket operations rather than requests."""
    global NET_DEADLINE
    cur = active_name()
    candidates = [a for a in accounts_all() if a["name"] != cur]
    if not candidates:
        return None, "no_candidate"

    scored = []
    outer, NET_DEADLINE = NET_DEADLINE, deadline
    try:
        for a in candidates:
            if no_probe or (deadline is not None and time.time() >= deadline):
                # Cached-only mode for latency-sensitive callers (the prompt hook).
                # Never opens a socket: a stale answer that costs nothing beats a
                # fresh one that freezes the user's prompt for seconds.
                rec = reading_load(a["name"])
                # The identity check earns its place most here: this path hands off
                # on a cached `ok` without opening a socket, so a row left behind by
                # a name that now points at another account would spend that
                # account's quota.
                if not _cache_row_valid(rec, a) or rec.get("status") != "ok":
                    continue
                if not reading_fresh(rec, CANDIDATE_TTL * 2):
                    continue
            else:
                rec = quota_for(a["name"], a)
            if has_headroom(rec) and not _guard_holds(a["name"], rec, exclude):
                scored.append((a.get("priority", 999), worst(rec), a, rec))
    finally:
        NET_DEADLINE = outer
    if not scored:
        return None, "all_exhausted"

    scored.sort(key=lambda t: (t[0], t[1]))
    _, _, a, rec = scored[0]
    return a, rec


def cmd_pick(args):
    """Print where a handoff would go. Exit 0 with a pick, 1 without."""
    a, rec = best_target(args.no_probe)
    if a is None:
        if args.json:
            print(json.dumps({"account": None, "reason": rec}))
        return 1
    if args.json:
        print(
            json.dumps(
                {
                    "account": a["name"],
                    "label": a.get("label", ""),
                    "subscription_type": a.get("subscription_type"),
                    "five_hour_percent": rec.get("five_hour_percent"),
                    "seven_day_percent": rec.get("seven_day_percent"),
                    "reason": "headroom",
                },
                ensure_ascii=False,
            )
        )
    else:
        print(a["name"])
    return 0


def detach():
    """Leave the caller's process group, for a job the caller must not be able to kill.

    Claude Code cancels a statusline render that is still running when the next update
    arrives, and kills a hook that outruns its timeout — both by process group, which a
    plain `&` child is still in. Caught there mid token-exchange, the server has already
    rotated the refresh token and nothing has saved the replacement: the spare dies,
    which is the failure ccd exists to prevent. The fork is what lets the caller's `&`
    return at once; setsid is what puts the survivor out of that group's reach."""
    if not hasattr(os, "fork"):
        return
    if os.fork() > 0:
        os._exit(0)
    os.setsid()


def cmd_keepalive(args):
    """Keep stored refresh tokens alive, and with --pick re-measure the spares after.

    A refresh token lasts ~8.5 days and each successful refresh mints a new one,
    so a daily touch keeps an unused account usable indefinitely. Without this the
    spare account dies quietly and the user finds out at the exact moment they
    needed it — precisely the failure ccd exists to prevent.

    This is the one background job every trigger starts: each hook tick, and each
    statusline render whose quota reading is past the TTL (#54). keepalive and the
    pick both spend one-time refresh tokens — quota_for() refreshes an expired one
    on the way — so the whole job holds one lock, and a trigger that finds it held
    has nothing to do. A kernel lock dies with its holder: nothing is left behind to
    reclaim, so there is no reclaim to race."""
    # One registered account with an unregistered login is a supported install, and that
    # account IS the spare (#41) — so the pick runs on one, while the keepalive pass
    # keeps its own bound (there is nothing to keep alive without a spare to keep).
    if not account_names():
        return 0
    global NET_DEADLINE
    try:
        with Lock(REFRESH_LOCK, wait=False):
            # Nothing waits on this pass, but a swap waits on the lock it holds.
            # An endpoint that answers slowly enough would starve every swap on
            # the machine; an unfinished pass costs nothing and is retried next
            # tick.
            outer, NET_DEADLINE = NET_DEADLINE, time.time() + KEEPALIVE_BUDGET
            try:
                stale = keepalive_pass(args.force)
                if args.pick:
                    best_target(False, deadline=NET_DEADLINE)
            finally:
                NET_DEADLINE = outer
    except LockBusy:
        return 0
    if stale and args.report:
        print(stale_message(stale))
    return 0


def keepalive_pass(force):
    """Refresh the spares that are due; returns those still stale, or [] if none ran."""
    if len(account_names()) < 2:
        return []
    # One transaction under the store lock: the due check, every account read, the
    # refresh, and the stamp. Checked outside it, a pass could read a refresh token
    # that a `ccd account` command was rotating away at the same moment.
    try:
        with Lock(LOCK_FILE, wait=False):
            due, fails = keepalive_due()
            if not due and not force:
                return []
            cur = active_name()
            failed = []
            for name in account_names():
                if name == cur:
                    continue
                acct = account_load(name)
                if not acct:
                    continue
                oauth = acct.get("claudeAiOauth") or {}
                if not token_expired(oauth, skew=KEEPALIVE_INTERVAL):
                    continue
                ok, why = account_refresh(name, acct)
                if not ok:
                    failed.append(name)
            # Stamp the outcome AFTER the pass, never before it. Stamping first
            # meant a failed attempt still consumed the whole interval, so the
            # spare got one all-or-nothing try per day and a run of bad windows
            # killed it in silence.
            try:
                write_json(KEEPALIVE_MARK, {"fails": fails + 1 if failed else 0}, 0o600)
            except Exception:
                pass
            stale = stale_spares()
            stale_breadcrumb(stale)
            return stale
    except LockBusy:
        return []


def keepalive_due():
    """(is a pass due now, consecutive failures so far).

    The wait grows with consecutive failures so a transient outage is retried
    within minutes while a persistent one settles back to the daily cadence
    instead of hammering an endpoint that is already refusing us."""
    try:
        age = time.time() - os.path.getmtime(KEEPALIVE_MARK)
    except OSError:
        return True, 0
    # Older ccd wrote this file empty; read_json turns that into None, which is
    # the same "no failures recorded" the first successful pass writes.
    fails = (read_json(KEEPALIVE_MARK) or {}).get("fails")
    fails = fails if isinstance(fails, int) and fails > 0 else 0
    if fails:
        wait = min(KEEPALIVE_RETRY_MIN * (2 ** (fails - 1)), KEEPALIVE_INTERVAL)
    else:
        wait = KEEPALIVE_INTERVAL
    return age >= wait, fails


def stale_spares():
    """Spare accounts whose stored token has gone too long without a refresh.

    Keyed on age, not on the last error. The user's exposure is identical
    whether the refresh failed with 429, 500, or a dropped connection, and
    keying on the error class is exactly what let a 429 pass unreported.

    The age is of the last SUCCESSFUL refresh. refreshed_at cannot answer that:
    bank_live_oauth() and swap_to() write it after copying the live blob, which is
    an honest claim about the snapshot and says nothing about the token exchange.
    Keying on it meant every hop reset this clock while the refresh path kept
    failing — six consecutive failures, and never a word (#27).

    Without refresh_ok_at this falls back to added_at, which is deliberately harsh:
    an account registered long ago reads as stale at once, even if it refreshed
    yesterday, because a pre-upgrade refreshed_at cannot be told apart from a copy.
    The alternative is to trust it and reproduce the bug. The false alarm names the
    command that fixes it, and the first successful refresh stamps the field, so it
    corrects itself within a keepalive interval."""
    cur = active_name()
    out = []
    for name in account_names():
        if name == cur:
            continue
        acct = account_load(name)
        if not acct:
            continue
        ts = acct.get("refresh_ok_at") or acct.get("added_at")
        if not isinstance(ts, (int, float)):
            continue
        age = now() - ts
        if age < STALE_WARN_AFTER:
            continue
        rt = (acct.get("claudeAiOauth") or {}).get("refreshTokenExpiresAt")
        left = None
        if isinstance(rt, (int, float)):
            left = int((rt / 1000.0 - time.time()) // 86400)
        out.append({"name": name, "days": int(age // 86400), "days_left": left})
    return out


def stale_message(stale):
    parts = []
    for s in stale:
        left = s["days_left"]
        if left is None:
            when = "re-login window unknown"
        elif left < 0:
            when = "already past re-login"
        else:
            when = f"{left}d before it needs a re-login"
        parts.append(f"{s['name']} (last refreshed {s['days']}d ago, {when})")
    return (
        "[ccd] Tell the user now: these spare Claude accounts stopped refreshing "
        "and cannot receive a quota handoff — " + "; ".join(parts)
        + ". Recover while the window is open: `ccd account refresh` needs no "
        "re-login. If that fails, run `claude` and sign in with /login as that "
        "account — ccd stores the new token itself, with no further command."
    )


def stale_breadcrumb(stale):
    """Hand the warning to the hook, or clear it once the accounts recover.

    The rendered text is what gets stored, not the accounts behind it: the hook
    only ever forwards this verbatim, and rebuilding the sentence there would be
    the same wording maintained in two languages."""
    try:
        if stale:
            write_json(STALE_FILE, {"message": stale_message(stale)}, 0o600)
        else:
            os.unlink(STALE_FILE)
    except Exception:
        pass


def cmd_usage(args):
    """Live quota for the login Claude Code is signed in as, in the same shape a
    claude-dashboard reading has.

    This is what lets the quota hook work with no dashboard installed, and it
    answers for a login nobody registered as an account. The live token belongs
    to Claude Code, so this never refreshes it: an expiring one reports nothing
    rather than rotating a credential another process owns. There is no refresh
    path in here at all, which is what lets the wall use it.

    A reading that succeeds is ALSO published as that account's own reading, when
    the token measured is provably the registered account's: the proof that may
    authorise paying reads readings/, and what the wall has just seen must be
    what it sees — not a 99% from thirty seconds ago speaking for an account that
    has just been measured at 100."""
    global NET_DEADLINE
    if args.deadline is not None:
        NET_DEADLINE = time.time() + max(0.0, args.deadline)
    blob, _ = live_read()
    oauth = blob.get("claudeAiOauth") or {}
    token = oauth.get("accessToken") or ""
    # Whose credential this is, asked BEFORE the measurement. Asked after, a swap
    # landing mid-request would put somebody else's name on these numbers.
    measured = active_name()
    claude = {"available": False, "error": True}
    rc = 1
    if token and not token_expired(oauth):
        status, body = usage_fetch(token)
        if status == 200 and isinstance(body, dict):
            fh, fhr = _window(body, "five_hour")
            sd, sdr = _window(body, "seven_day")
            # Both windows missing means the payload told us nothing. An empty
            # reading must never stand in for a real one: everything downstream
            # treats a number as proof the quota really is spent.
            if fh is not None or sd is not None:
                claude = {
                    "available": True,
                    "error": False,
                    "fiveHourPercent": fh,
                    "fiveHourReset": fhr,
                    "sevenDayPercent": sd,
                    "sevenDayReset": sdr,
                }
                rc = 0
                # Identity-bound: only when the token just measured IS the one on
                # file for the account named. The prologue has banked the live
                # credential where it could prove ownership; where it could not,
                # these numbers are about a login ccd cannot name, and are not
                # filed under anybody's.
                acct = account_load(measured) if measured else None
                if acct and _cred_fingerprint(acct) == _cred_fingerprint({"claudeAiOauth": oauth}):
                    reading_save(measured, {
                        "status": "ok", "checked_at": now(),
                        "cred": _cred_fingerprint(acct), "uuid": acct.get("account_uuid"),
                        "five_hour_percent": fh, "seven_day_percent": sd,
                        "five_hour_reset": fhr, "seven_day_reset": sdr})
    if args.json:
        # Whose reading this is. A decision taken on it is only about that
        # account, and between taking one and acting on it another session can
        # swap — at which point the numbers describe somebody else entirely.
        print(json.dumps({"claude": claude, "account": measured},
                         ensure_ascii=False))
    else:
        parts = [
            f"{lab} {claude[k]}%"
            for lab, k in (("5h", "fiveHourPercent"), ("7d", "sevenDayPercent"))
            if isinstance(claude.get(k), (int, float))
        ]
        print(" · ".join(parts) if parts else "no reading")
    return rc


def cmd_current(args):
    """What backbone and account is this session on? Used by the statusline and
    doctor, both of which must answer without touching the network."""
    cur = active_name()
    acct = account_load(cur) if cur else None
    total = len(account_names())
    on_fallback = bool(os.environ.get("CCD_ACTIVE"))
    # The identity of the credential Claude Code will actually read. A plan is not
    # an account — two accounts on one plan agree about every plan field there is,
    # so only the credential itself can confirm that a swap landed.
    live_oauth = (live_read()[0].get("claudeAiOauth") or {})
    info = {
        "backbone": "openrouter" if on_fallback else "subscription",
        "account": cur,
        "label": (acct or {}).get("label", "") or "",
        "subscription_type": (acct or {}).get("subscription_type"),
        "registered": total,
        "live": {"cred": _cred_fingerprint({"claudeAiOauth": live_oauth})},
        # What the store holds for that same account. A confirmation needs both:
        # the credential it installed, and the one a rotation ccd recorded since
        # — anything else live is nobody's in particular.
        "stored_cred": _cred_fingerprint(acct),
    }
    if args.json:
        print(json.dumps(info, ensure_ascii=False))
    else:
        if on_fallback:
            print("openrouter")
        else:
            print(cur or "unknown")
    return 0


# ── Entry point ──────────────────────────────────────────────────────────────


def main(argv):
    p = argparse.ArgumentParser(prog="ccd account", add_help=True)
    p.add_argument("--no-color", action="store_true")
    sub = p.add_subparsers(dest="cmd")

    a = sub.add_parser("add", help="register the currently signed-in account")
    a.add_argument("--name")
    a.add_argument("--label", default="")
    a.add_argument("--priority", type=int)
    a.add_argument("--force", action="store_true")
    a.set_defaults(fn=cmd_add)

    a = sub.add_parser("list", help="show accounts and quota")
    a.add_argument("--json", action="store_true")
    a.set_defaults(fn=cmd_list)

    a = sub.add_parser("rm", help="remove an account")
    a.add_argument("name")
    a.set_defaults(fn=cmd_rm)

    a = sub.add_parser("use", help="switch the active account (no name: the best spare)")
    a.add_argument("name", nargs="?")
    a.add_argument("--json", action="store_true")
    a.add_argument("--force", action="store_true")
    a.set_defaults(fn=cmd_use)

    a = sub.add_parser("refresh", help="refresh stored tokens")
    a.add_argument("name", nargs="?")
    a.add_argument("--all", action="store_true")
    a.add_argument("--inactive-only", action="store_true")
    a.set_defaults(fn=cmd_refresh)

    a = sub.add_parser("pick", help="choose the best handoff target")
    a.add_argument("--json", action="store_true")
    a.add_argument(
        "--no-probe",
        action="store_true",
        help="decide from cached quota only; never make a network call",
    )
    a.set_defaults(fn=cmd_pick)

    a = sub.add_parser("swap", help="pick a spare and install it in one transaction (internal)")
    a.add_argument("--from", dest="from_account", default="",
                   help="the account the caller measured; refuse if we are elsewhere")
    a.add_argument("--window", default="", help="the reset windows the reading named")
    a.add_argument("--no-probe", action="store_true")
    a.add_argument("--deadline", type=float, default=60.0,
                   help="seconds this decision may spend, lock wait included")
    a.set_defaults(fn=cmd_swap)

    a = sub.add_parser("exhausted",
                       help="is it proved that no subscription can take the session? (internal)")
    a.set_defaults(fn=cmd_exhausted)

    a = sub.add_parser("keepalive", help="keep spare tokens alive (internal)")
    a.add_argument("--force", action="store_true")
    a.add_argument("--report", action="store_true")
    a.add_argument("--pick", action="store_true", help="then re-measure the spares")
    a.add_argument("--detach", action="store_true", help="run out of the caller's process group")
    a.set_defaults(fn=cmd_keepalive)

    a = sub.add_parser("usage", help="live quota for the signed-in login (internal)")
    a.add_argument("--json", action="store_true")
    a.add_argument("--deadline", type=float, default=None,
                   help="seconds this measurement may spend")
    a.set_defaults(fn=cmd_usage)

    a = sub.add_parser("current", help="active backbone and account (internal)")
    a.add_argument("--json", action="store_true")
    a.set_defaults(fn=cmd_current)

    args = p.parse_args(argv)
    if getattr(args, "detach", False):
        detach()                      # before anything is opened or locked
    color(not args.no_color and sys.stdout.isatty())
    if not getattr(args, "fn", None):
        p.print_help()
        return 0
    # A question, asked before anything below can act: no directory made, no
    # credential banked, no pointer repaired. The proof reads and answers.
    if args.fn is cmd_exhausted:
        return cmd_exhausted(args)
    ensure_dirs()
    # Make the store true before anything reads it. Without this every command
    # below reasons about a snapshot that may have gone dead days ago.
    bank_live_oauth()
    return args.fn(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
