#!/usr/bin/env bash
# Automatic quota handoff — runs the real claude and relaunches it on the other
# backbone when the quota-guard hook asks for it.
#
# Installed indirectly: `ccd setup --auto` writes a small resolver at
# ~/.local/bin/claude that execs the newest copy of THIS file, so a plugin
# update takes effect without re-running setup.
#
# Contract with scripts/quota-guard.sh:
#   - we export CCD_HANDOFF (a per-launch random token) and CCD_HANDOFF_STATE
#     (the state path that token implies). The hook signals only when BOTH are
#     present and consistent, so a session is never ended with nothing to catch it
#   - the hook writes that state file and SIGHUPs claude
#   - claude exits 129 (128+SIGHUP) after running its SessionEnd hooks
#   - we read the file and relaunch the same conversation on the other backbone
#
# Every exit code other than 129 is passed through untouched, so this is
# invisible until a handoff actually happens.
set -u

# A session that lasted at least this long was doing real work, so the burst
# ends. Tunable only so the test suite can exercise both sides. This is a time
# threshold, not an assumption about how long the backbone ladder is, so it does
# not need to scale with the number of registered accounts.
HOP_RESET_SECONDS=${CCD_HOP_RESET_SECONDS:-60}

# Same literal every other component uses. Kept as a plain $HOME derivation, not
# an override, so the handoff-state path this script computes can never drift
# from the one quota-guard.sh computes for its interlock check.
CCD_HOME="$HOME/.claude/ccd"

# Resolve the real claude WITHOUT `command -v`, which would find the resolver
# that invoked us. Skip by identity rather than by directory name: comparing
# resolved paths stays correct when claude is legitimately installed in the same
# directory, and when $HOME differs from what it was at install time.
real_claude() {
  local d c self="${CCD_SHIM_PATH:-}"
  local IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    c="$d/claude"
    { [ -x "$c" ] && [ ! -d "$c" ]; } || continue
    if [ -n "$self" ] && [ "$(cd "$d" 2>/dev/null && pwd)/claude" = "$self" ]; then
      continue
    fi
    # Belt and braces: skip anything carrying the shim's signature even when
    # CCD_SHIM_PATH is unset (a stale shim in another PATH directory, or this
    # script invoked directly). Running a shim here would nest launchers.
    # Whole-line match, so a real claude that merely mentions ccd is not skipped.
    # Keep this literal identical to CCD_SHIM_SIG in bin/ccd.
    head -c 4096 "$c" 2>/dev/null \
      | grep -qxF '# ccd-auto-handoff-shim v1 (managed by: ccd setup --auto)' && continue
    printf '%s' "$c"
    return 0
  done
  return 1
}

# Read one field from the handoff file. Empty when absent, unreadable, or of an
# unexpected type — every caller treats empty as "no handoff".
hf() {
  [ -f "$CCD_STATE" ] || return 0
  python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    if not isinstance(d, dict):
        raise ValueError
except Exception:
    raise SystemExit(0)
v = d.get(sys.argv[2])
print(v if isinstance(v, str) else ("true" if v is True else ""))
' "$CCD_STATE" "$1" 2>/dev/null
}

ccd_bin() {
  ls -d "$HOME/.claude/plugins/cache"/*/ccd/*/bin/ccd 2>/dev/null | sort -V | tail -1
}

# ccd-account ships beside this file; prefer the sibling so a plugin update moves
# both together, and fall back to the newest installed copy when this script was
# invoked through a path that does not carry its siblings.
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd) || SELF_DIR=""
ccd_account_bin() {
  [ -n "$SELF_DIR" ] && [ -x "$SELF_DIR/ccd-account" ] && {
    printf '%s' "$SELF_DIR/ccd-account"; return 0; }
  local t
  t=$(ls -d "$HOME/.claude/plugins/cache"/*/ccd/*/bin/ccd-account 2>/dev/null | sort -V | tail -1)
  [ -n "$t" ] && { printf '%s' "$t"; return 0; }
  return 1
}

# ── Burst tracking (docs/multi-account.md §5.2) ──────────────────────────────
# Loop protection remembers WHERE we have been rather than HOW MANY times we
# moved. A hop counter has to encode the ladder length as a constant, and the
# ladder is `registered accounts + 1` — a number that differs per user. With
# three accounts a cap of 3 would be reached before the final OpenRouter fallback
# was ever tried, so the guard against looping would block the escape instead.
#
# A burst is a run of relaunches with no real work between them. Each destination
# may be visited once per burst; the set is handed to `ccd-account pick` as its
# exclusion list, so an exhausted account simply stops being offered and the
# ladder drains naturally toward the final fallback.
visited=""
visited_has() { case " $visited " in *" $1 "*) return 0 ;; esac; return 1; }
visited_add() { visited_has "$1" || visited="${visited:+$visited }$1"; }

# Comma-separated for the hook, which passes it straight to `ccd-account pick`.
export_visited() {
  if [ -n "$visited" ]; then
    CCD_BURST_VISITED=$(printf '%s' "$visited" | tr ' ' ',')
  else
    CCD_BURST_VISITED=""
  fi
  export CCD_BURST_VISITED
}

# Runaway backstop, recomputed from the store each hop rather than fixed. If the
# visited set is doing its job this is never reached — tripping it means a bug,
# not a user with many accounts.
account_count() {
  local n
  n=$(ls "$CCD_HOME/accounts"/*.json 2>/dev/null | wc -l | tr -d ' ')
  case "$n" in ''|*[!0-9]*) echo 0 ;; *) echo "$n" ;; esac
}

# Does a transcript exist for this session? A session that ended before its first
# exchange has none, and `--resume` on it fails with "No conversation found",
# which would leave the user staring at an error instead of a working session.
# Claude Code stores transcripts as ~/.claude/projects/<slug>/<session-id>.jsonl,
# where the slug is the cwd with non-alphanumerics replaced by '-'.
has_transcript() {
  local sid="$1" base="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
  [ -d "$base" ] || return 1
  ls "$base"/*/"$sid".jsonl >/dev/null 2>&1
}

REAL=$(real_claude) || { echo "ccd: real claude not found on PATH" >&2; exit 127; }

# A per-launch token, not a constant. It is the hook's interlock (only a launcher
# sets it) AND the owner tag on the handoff state. Without it, two concurrent
# sessions share one file: the second to exit 129 — for any reason — would
# consume the first's handoff, resume the WRONG conversation, and leave the
# session that was actually signalled with nothing to bring it back.
# Inheriting a token would make a nested launcher share the outer one's state,
# so a fresh one is minted per launch. An override exists for the test suite,
# which needs to know the state path — but it goes into a FILENAME that this
# script later deletes, so anything but the exact generated shape is refused:
# a value containing `/../` would otherwise escape ~/.claude/ccd entirely.
# Clear any inherited token first. A nested launcher must not reuse its parent's
# — they would share one state file and each would delete it on exit.
CCD_HANDOFF=""
# Exactly the generated shape: 32 lowercase hex. Anything else is refused, since
# the value becomes a filename this script later deletes. Length matters as much
# as the character set: an over-long name makes the state write fail, and a
# signal sent against state that was never written strands the session.
valid_token() {
  case "$1" in
    *[!0-9a-f]*|'') return 1 ;;
    *) [ "${#1}" -eq 32 ] ;;
  esac
}
if [ -n "${CCD_HANDOFF_TOKEN:-}" ]; then
  if valid_token "$CCD_HANDOFF_TOKEN"; then
    CCD_HANDOFF="$CCD_HANDOFF_TOKEN"
  else
    echo "ccd: invalid CCD_HANDOFF_TOKEN — ignoring" >&2
  fi
fi
if [ -z "$CCD_HANDOFF" ]; then
  # Fail closed rather than fall back to something predictable: a guessable
  # token is a state file another process can plant or consume.
  CCD_HANDOFF=$(
    python3 -c 'import secrets; print(secrets.token_hex(16))' 2>/dev/null \
    || od -An -tx1 -N16 /dev/urandom 2>/dev/null | tr -d ' \n'
  )
  if ! valid_token "$CCD_HANDOFF"; then
    echo "ccd: no secure random source — automatic handoff disabled" >&2
    exec "$REAL" "$@"
  fi
fi
export CCD_HANDOFF
# State is per-launcher too, so a stale file from another session is never even
# opened. The token is validated hex, so it is safe in a filename.
CCD_STATE="$HOME/.claude/ccd/handoff-$CCD_HANDOFF.json"
trap 'rm -f "$CCD_STATE" 2>/dev/null' EXIT
export CCD_HANDOFF_STATE="$CCD_STATE"

# The cap exists to stop a relaunch LOOP, not to limit how many times a long
# session may legitimately change backbone. Quota dying, recovering, and dying
# again over a workday is normal, so a lifetime counter would strand the user on
# the third ordinary transition. Count only relaunches that arrive in quick
# succession, and forget them once a session has run for a useful stretch.
# One loop, one backbone per iteration. Both legs go through the SAME checks:
# an unrelated SIGHUP (closing terminal, user kill) on either backbone must exit
# rather than silently switch, and exit 129 alone never implies intent.
hops=0                         # backstop only; the real guard is `visited`
backbone=subscription          # which binary this iteration runs
args=("$@")                    # arguments for it
resuming=0                     # did we ask this leg to restore a conversation?
last_sid=""                    # the one it was asked to restore

# A headless run is not relaunchable: the relaunch carries `--resume <id>` but no
# prompt, so there is nothing to answer, and ccd refuses a launch with no terminal
# anyway — the user would get "exit Claude Code first" where they expected output.
# There is also nobody sitting at a prompt to benefit.
#
# `-p`/`--print` is only one way in. Claude Code also goes non-interactive when
# its output is not a terminal (`claude "prompt" > out.txt`), so use the same
# predicate ccd itself uses, captured now — stdio is still the caller's here.
headless=0
{ [ -t 0 ] && [ -t 1 ]; } || headless=1
for a in ${1+"$@"}; do
  case "$a" in -p|--print) headless=1 ;; esac
done
while :; do
  session_start=$(date +%s 2>/dev/null || echo 0)
  export_visited
  if [ "$backbone" = "fallback" ]; then
    t=$(ccd_bin)
    if [ -z "$t" ]; then
      printf 'ccd: plugin not found — resume with: claude --resume %s\n' "${sid:-<session>}" >&2
      exit 1
    fi
    "$t" ${args+"${args[@]}"}
  else
    "$REAL" ${args+"${args[@]}"}
  fi
  rc=$?

  # A relaunch we asked to --resume, that dies immediately with an error, could
  # not open the transcript ("No conversation found", exit 1). The handoff itself
  # worked; only the restore failed. Leaving the user staring at that error right
  # after an automatic switch is the worst possible ending, so carry on in a fresh
  # session instead — and say so, because a lost thread must never be silent.
  now=$(date +%s 2>/dev/null || echo 0)
  if [ "$resuming" -eq 1 ] && [ "$rc" -ne 0 ] && [ "$rc" -ne 129 ] \
     && [ "$((now - session_start))" -lt 15 ]; then
    printf '\n\033[33m⚠ 이전 대화를 복원하지 못했습니다 — 새 세션으로 이어갑니다\033[0m\n' >&2
    printf '\033[2m   대화는 남아 있습니다: claude --resume %s\033[0m\n' "$last_sid" >&2
    resuming=0
    case "$backbone" in
      fallback) args=(go) ;;
      *)        args=() ;;
    esac
    continue
  fi

  [ "$rc" -eq 129 ] || exit "$rc"

  # A session that ran a while was working, not thrashing: the burst is over, so
  # every destination becomes available again. Quota dying, recovering, and dying
  # again over a workday is normal and must never be mistaken for a loop.
  if [ "$((now - session_start))" -ge "$HOP_RESET_SECONDS" ]; then
    hops=0
    visited=""
  fi

  # 129 without armed state belonging to THIS launcher means something else sent
  # SIGHUP. Pass it through rather than inventing a relaunch.
  [ "$(hf armed)" = "true" ] || exit "$rc"
  [ "$(hf token)" = "$CCD_HANDOFF" ] || exit "$rc"
  sid=$(hf session_id)
  if [ "$headless" -eq 1 ]; then
    printf 'ccd: quota exhausted during a non-interactive run — not relaunching.\n     Continue in a terminal with: ccd --resume %s\n' "$sid" >&2
    exit "$rc"
  fi
  dir=$(hf direction)
  acct=$(hf account)
  [ -n "$sid" ] || exit "$rc"

  # Where this hop is headed, as a single name in the destination space
  # {account names} ∪ {fallback}. Visiting one twice inside a burst is the
  # definition of a loop.
  case "$dir" in
    to_account)      dest="$acct" ;;
    to_fallback)     dest="fallback" ;;
    *)               dest="" ;;
  esac
  if [ -n "$dest" ] && visited_has "$dest"; then
    printf 'ccd: 갈 수 있는 백본을 모두 시도했습니다 — 중단합니다.\n     이어서 하려면: claude --resume %s\n' "$sid" >&2
    exit "$rc"
  fi

  # Resuming a session that never got a transcript fails outright. That happens
  # when a session ends before its first exchange — there is no conversation to
  # carry over, so start a fresh one on the new backbone instead of erroring.
  # `ccd` with no arguments prints status rather than launching, and bare
  # `claude` is the right way to start fresh, so the two differ here.
  resumed=1
  if ! has_transcript "$sid"; then resumed=0; fi

  # Disarm BEFORE relaunching: if the far side dies immediately, the next 129
  # finds no armed state and exits instead of looping.
  rm -f "$CCD_STATE" 2>/dev/null || true

  # Backstop, derived from the store rather than hardcoded: accounts + fallback,
  # plus one for the return-to-subscription leg. `visited` already bounds a burst
  # to exactly this, so reaching it means something is wrong (the store changed
  # mid-burst, or a destination is not being recorded) — not that the user owns
  # a lot of accounts.
  # Floor at 3 so a store with no accounts behaves EXACTLY as before this feature
  # existed — same cap, same message, same exit. Multi-account only ever raises it.
  hops=$((hops + 1))
  ceiling=$(( $(account_count) + 2 ))
  [ "$ceiling" -lt 3 ] && ceiling=3
  if [ "$hops" -ge "$ceiling" ]; then
    printf 'ccd: too many consecutive handoffs — stopping.\n     Resume with: claude --resume %s\n' "$sid" >&2
    exit "$rc"
  fi

  [ -n "$dest" ] && visited_add "$dest"

  case "$dir" in
    to_account)
      # Another Claude subscription still has quota. This is the cheap hop: the
      # conversation stays on the subscription backbone, nothing is billed, and
      # only the credential underneath changes.
      ab=$(ccd_account_bin)
      if [ -z "$ab" ] || [ -z "$acct" ]; then
        printf 'ccd: 계정 전환 도구를 찾지 못했습니다 — 이어서 하려면: claude --resume %s\n' "$sid" >&2
        exit "$rc"
      fi
      # The swap happens HERE, between sessions: claude has exited and the
      # relaunch has not started, so nothing else holds the credentials. That is
      # what lets this be a plain write with no coordination.
      if ! swap_out=$("$ab" --no-color use "$acct" --force 2>&1); then
        printf 'ccd: %s 계정으로 전환하지 못했습니다 — 이어서 하려면: claude --resume %s\n' "$acct" "$sid" >&2
        printf '%s\n' "$swap_out" >&2
        exit "$rc"
      fi
      # Coming back from OpenRouter this is essential, and from the subscription
      # it is a no-op — either way the new session must not inherit a backbone
      # override that would silently keep billing.
      unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL \
            ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
            ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL \
            ANTHROPIC_CUSTOM_MODEL_OPTION ANTHROPIC_CUSTOM_MODEL_OPTION_NAME \
            CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS \
            CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_MAX_OUTPUT_TOKENS \
            CCD_ACTIVE 2>/dev/null || true
      if [ "$resumed" -eq 1 ]; then
        printf '\n\033[32m▶ ✓ 쿼타 소진 — %s 계정으로 같은 대화를 이어갑니다 (구독, 무과금)\033[0m\n' "$acct"
        args=(--resume "$sid"); resuming=1; last_sid="$sid"
      else
        printf '\n\033[32m▶ ✓ 쿼타 소진 — %s 계정에서 새 세션으로 시작합니다 (구독, 무과금)\033[0m\n' "$acct"
        args=()
      fi
      backbone=subscription
      ;;
    to_fallback)
      if [ "$resumed" -eq 1 ]; then
        printf '\n\033[33m▶ 🍩 Claude 쿼타 소진 — 같은 대화를 OpenRouter에서 이어갑니다 (유료)\033[0m\n'
        printf '\033[2m   회복되면 구독으로 자동 복귀합니다\033[0m\n'
        args=(--resume "$sid"); resuming=1; last_sid="$sid"
      else
        printf '\n\033[33m▶ 🍩 Claude 쿼타 소진 — OpenRouter에서 새 세션으로 시작합니다 (유료)\033[0m\n'
        printf '\033[2m   회복되면 구독으로 자동 복귀합니다\033[0m\n'
        args=(go)
      fi
      backbone=fallback
      ;;
    to_subscription)
      # Returning to the subscription means returning to it completely. ccd runs
      # as our child so its exports cannot reach us, but clear them anyway: a
      # session that says "구독으로 복귀" while still pointed at OpenRouter is the
      # single worst outcome this feature can produce, and the cost of being
      # certain is one unset.
      unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL \
            ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
            ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL \
            ANTHROPIC_CUSTOM_MODEL_OPTION ANTHROPIC_CUSTOM_MODEL_OPTION_NAME \
            CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS \
            CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_MAX_OUTPUT_TOKENS \
            CCD_ACTIVE 2>/dev/null || true
      if [ "$resumed" -eq 1 ]; then
        printf '\n\033[32m▶ ✓ Claude 쿼타 회복 — 같은 대화를 구독으로 이어갑니다 (과금 종료)\033[0m\n'
        args=(--resume "$sid"); resuming=1; last_sid="$sid"
      else
        printf '\n\033[32m▶ ✓ Claude 쿼타 회복 — 구독으로 돌아왔습니다 (OpenRouter 과금 종료)\033[0m\n'
        args=()
      fi
      backbone=subscription
      ;;
    *)
      # Unrecognized direction: fail closed rather than guessing a backbone.
      printf 'ccd: unrecognized handoff direction — resume with: claude --resume %s\n' "$sid" >&2
      exit "$rc"
      ;;
  esac
done
