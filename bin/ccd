#!/usr/bin/env bash
# ccd = the donut spare for Claude Code (repo: cc-donut)
#
# When the Claude subscription quota runs out, keep the Claude Code shell
# (tools, hooks, skills, and conversation history) and swap only the model to a low-cost OpenRouter model.
#
#   ccd                    Current status, assigned models, and usage
#   ccd -c                 Switch and resume the last conversation  <- emergency command
#   ccd go                 Switch into a new session
#   ccd -c --opus kimi     Use kimi for the opus slot for this run only
#   ccd -c --model provider/model  Resume with this model as the sonnet/current slot
#   ccd pick               Choose models for the haiku/sonnet/opus slots (saved)
#   ccd models             Model catalog (slugs to paste into /model in a session)
#   ccd key                Enter the OpenRouter API key (no editor needed)
#   ccd account list       Registered Claude accounts and their quota
#   ccd account add        Register the currently signed-in account as a spare
#   ccd doctor [key]       Validate with one API round trip before starting claude
#   ccd off                Run with the subscription again
#
# With two or more accounts registered, quota exhaustion moves the conversation to
# a spare subscription first and only reaches OpenRouter when every one is spent.
#
# Switching back costs nothing. ANTHROPIC_AUTH_TOKEN masks the claude.ai login only
# in that process. Run `claude` in a new terminal to return to the subscription automatically.
# Never use /logout; it actually logs you out.
set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DIR="${CCD_PROVIDERS_DIR:-${CLAUDE_PROVIDERS_DIR:-$HOME/.claude/ccd/providers}}"
KEYS="$DIR/keys.env"
CONF="$DIR/openrouter.env"
CATALOG="$DIR/models.conf"
TIERS="$DIR/tiers.env"          # ccd pick saves here; when present, it overrides CONF defaults.
CCD_DIR="$HOME/.claude/ccd"
RUN_STATE="$CCD_DIR/run-state.json"
OUTAGE_STATE="$CCD_DIR/outage-state.json"   # Total for the quota outage, preserved across restarts.
QUOTA_CACHE="$CCD_DIR/quota-cache.json"
PRICE_CACHE="$CCD_DIR/price-cache.json"   # also carries per-slug provider context lengths
mkdir -p "$CCD_DIR"
[ "$DIR" = "$HOME/.claude/ccd/providers" ] && mkdir -p "$DIR"

bootstrap_config() {
  mkdir -p "$DIR"
  if [ ! -f "$CONF" ]; then
    if [ -f "$SELF_DIR/../templates/openrouter.env" ]; then
      cp "$SELF_DIR/../templates/openrouter.env" "$CONF"
    else
      cat > "$CONF" <<'CCD_OPENROUTER_ENV'
# OpenRouter backbone configuration — generated by ccd.
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
CCD_ROUTING="${CCD_ROUTING:-floor}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek/deepseek-v4-flash"
export ANTHROPIC_DEFAULT_SONNET_MODEL="openai/gpt-5.6-luna"
export ANTHROPIC_DEFAULT_OPUS_MODEL="moonshotai/kimi-k3"
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1000000"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="64000"
CCD_OPENROUTER_ENV
    fi
  fi
  if [ ! -f "$CATALOG" ]; then
    if [ -f "$SELF_DIR/../templates/models.conf" ]; then
      cp "$SELF_DIR/../templates/models.conf" "$CATALOG"
    else
      cat > "$CATALOG" <<'CCD_MODELS_CONF'
# OpenRouter model catalog — generated by ccd.
# Format: key slug in/out-price description
flash   deepseek/deepseek-v4-flash   0.11/0.22    Cheapest. For exploration/grep. No independent verification (caution)
luna    openai/gpt-5.6-luna          0.10/0.60    Frontier. Default everyday coding model
kimi    moonshotai/kimi-k3           2.90/14.00   Frontier. Opus slot: hard problems and debugging
sol     openai/gpt-5.6-sol           5.00/30.00   Frontier. Only for truly hard problems
terra   openai/gpt-5.6-terra         1.00/6.00    Frontier. Previous opus default
glm51   z-ai/glm-5.1                 0.98/4.30    Measured in Claude Code itself
CCD_MODELS_CONF
    fi
  fi
  if [ ! -f "$KEYS" ]; then
    printf 'OPENROUTER_API_KEY=""\n' > "$KEYS"
    chmod 600 "$KEYS"
  fi
}
bootstrap_config

if [ -f "$SELF_DIR/../QUOTA-SOS.md" ] && { [ ! -f "$CCD_DIR/QUOTA-SOS.md" ] || ! cmp -s "$SELF_DIR/../QUOTA-SOS.md" "$CCD_DIR/QUOTA-SOS.md"; }; then
  cp "$SELF_DIR/../QUOTA-SOS.md" "$CCD_DIR/QUOTA-SOS.md"
fi

r=$'\033[0m'; d=$'\033[2m'; b=$'\033[1m'
grn=$'\033[32m'; ylw=$'\033[33m'; red=$'\033[31m'; cyn=$'\033[36m'

die() { printf '%sccd: %s%s\n' "$red" "$*" "$r" >&2; exit 1; }

# Catalog lookup: key -> slug (a direct slug passes through unchanged).
slug_of() {
  local k="$1" s
  s=$(awk -v k="$k" '!/^#/ && NF>=2 && $1==k {print $2; exit}' "$CATALOG" 2>/dev/null)
  [ -n "$s" ] && { printf '%s' "$s"; return 0; }
  case "$k" in */*) printf '%s' "$k"; return 0 ;; esac   # Pass through anything that looks like a slug.
  return 1
}
note_of() { awk -v k="$1" '!/^#/ && NF>=2 && $1==k {$1="";$2="";$3="";sub(/^ +/,"");print;exit}' "$CATALOG" 2>/dev/null; }
price_of() { awk -v k="$1" '!/^#/ && NF>=3 && $1==k {print $3; exit}' "$CATALOG" 2>/dev/null; }
key_of() { awk -v s="$1" '!/^#/ && NF>=2 && $2==s {print $1; exit}' "$CATALOG" 2>/dev/null; }

# The bounded metadata warm set lives in models.conf by key, not in this script.
# Ignore missing/retired keys so an older user catalog remains usable.
prewarm_catalog_slugs() {
  local keys k s
  keys=$(awk '/^# ccd-prewarm:/ {for (i=3; i<=NF; i++) printf "%s ", $i; exit}' "$CATALOG" 2>/dev/null)
  for k in $keys; do
    s=$(slug_of "$k") && printf '%s\n' "$s"
  done
}

valid_bare_slug() {
  case "$1" in
    ''|-*|*'['*|*']'*|*:*|*'?'*|*'#'*|*'://'*|*' '*|*$'\t'*|*$'\n'*|*/*/*|/*|*/)
      return 1 ;;
    */*) ;;
    *) return 1 ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]
}

load_env() {
  # An already-exported OPENROUTER_API_KEY wins over keys.env — the standard
  # env-var override convention used by MCP servers and official plugins.
  local env_key="${OPENROUTER_API_KEY:-}"
  # shellcheck disable=SC1090
  [ -f "$KEYS" ] && { set -a; . "$KEYS"; set +a; }
  [ -n "$env_key" ] && OPENROUTER_API_KEY="$env_key"
  # shellcheck disable=SC1090
  . "$CONF"
  # shellcheck disable=SC1090
  [ -f "$TIERS" ] && . "$TIERS"
}

require_key() {
  if [ -z "${OPENROUTER_API_KEY:-}" ]; then
    printf '%sccd: OPENROUTER_API_KEY is empty.%s\n' "$red" "$r" >&2
    printf '  1) Create a key: %shttps://openrouter.ai/keys%s\n' "$cyn" "$r" >&2
    printf '  2) Save it:     %sccd key%s  (just paste it)\n' "$b" "$r" >&2
    printf '  %sSet this up while quota remains. Claude cannot help after it reaches zero.%s\n' "$d" "$r" >&2
    exit 1
  fi
}

# Read the key through a native macOS dialog when no terminal is available (such as Claude Code ! commands).
key_from_dialog() {
  osascript <<'OSA' 2>/dev/null
try
  set res to display dialog "OpenRouter API key\n\nPaste your key below. It is stored locally in ~/.claude/ccd/providers/keys.env (chmod 600) and never leaves this machine." with title "ccd" default answer "" with hidden answer buttons {"Cancel", "Save"} default button "Save"
  if button returned of res is "Save" then
    return text returned of res
  end if
end try
return ""
OSA
}

# Set the key without an editor. Input is never echoed on screen.
set_key() {
  local k=""
  if [ -t 0 ]; then
    # Real terminal: read hidden input in place.
    printf 'Paste the OpenRouter key and press Enter %s(input is hidden)%s\n' "$d" "$r"
    printf '  Create one: %shttps://openrouter.ai/keys%s\n> ' "$cyn" "$r"
    stty -echo 2>/dev/null; read -r k; stty echo 2>/dev/null; printf '\n'
  else
    # No stdin terminal: try piped input, then the controlling terminal
    # (covers Claude Code `!` commands and other embedded shells — works headless
    # on Linux), then the macOS dialog as a last resort.
    read -t 1 -r k 2>/dev/null || k=""
    if [ -z "$k" ] && (exec < /dev/tty) 2>/dev/null; then
      printf 'Paste the OpenRouter key and press Enter %s(input is hidden)%s\n> ' "$d" "$r" > /dev/tty
      stty -echo < /dev/tty 2>/dev/null
      IFS= read -r k < /dev/tty
      stty echo < /dev/tty 2>/dev/null
      printf '\n' > /dev/tty
    fi
    if [ -z "$k" ]; then
      command -v osascript >/dev/null 2>&1 \
        || die "No terminal available here. In Claude Code, type '! ccd key' (runs with your terminal, input hidden) — or run 'ccd key' in any terminal."
      printf '%sA dialog is open. Paste the key there.%s\n' "$d" "$r"
      k=$(key_from_dialog)
      [ -n "$k" ] || die "Canceled or empty input. Nothing changed."
    fi
  fi
  [ -n "$k" ] || die "Empty input. Nothing changed."
  case "$k" in
    sk-or-*) ;;
    *) printf '%sWarning: OpenRouter keys usually start with sk-or-. Saving anyway.%s\n' "$ylw" "$r" ;;
  esac
  # Replace the existing line or append it. Python safely handles slashes in the value.
  KEYVAL="$k" python3 - "$KEYS" <<'PY'
import os, re, sys
p = sys.argv[1]; v = os.environ["KEYVAL"]
s = open(p).read()
line = f'OPENROUTER_API_KEY="{v}"'
s2, n = re.subn(r'^OPENROUTER_API_KEY=.*$', line, s, count=1, flags=re.M)
open(p, 'w').write(s2 if n else s.rstrip("\n") + "\n" + line + "\n")
PY
  chmod 600 "$KEYS"
  local tail code result
  tail="${k: -4}"
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -H "Authorization: Bearer $k" "https://openrouter.ai/api/v1/key" 2>/dev/null) || code="network"
  if [ "$code" = "200" ]; then
    result="✓ key saved & verified (sk-or-…$tail)"
    printf '%s%s%s\n' "$grn" "$result" "$r"
    [ -t 0 ] || osascript -e 'display notification "✓ OpenRouter key verified" with title "ccd"' >/dev/null 2>&1 || true
  else
    result="⚠ saved, but verification failed (HTTP $code) — run ccd doctor (sk-or-…$tail)"
    printf '%s%s%s\n' "$ylw" "$result" "$r"
    [ -t 0 ] || osascript -e 'display notification "⚠ OpenRouter key verification failed — run ccd doctor" with title "ccd"' >/dev/null 2>&1 || true
  fi
}

# Add the routing suffix to a slug unless one is already present.
with_routing() {
  case "$1" in *:*) printf '%s' "$1" ;; *) printf '%s:%s' "$1" "${CCD_ROUTING:-floor}" ;; esac
}

# Cache key helper: combine slug with current routing.
cache_key_for() {
  local slug="$1"
  case "$slug" in *:*) printf '%s' "$slug" ;; *) printf '%s:%s' "$slug" "${CCD_ROUTING:-floor}" ;; esac
}

# Append Claude Code's local [1m] context hint whenever cached OpenRouter endpoint
# data proves every default-pool provider for this slug serves MORE than the 200K
# fallback window. Behind a gateway Claude Code budgets 200K unless the model ID
# carries this hint; it strips the suffix before the request reaches the provider,
# so the wire format stays "slug:floor". Unverified/stale/malformed cache -> no
# hint, which keeps the safe 200K budget instead of risking silent failures.
#
# [1m] only opens the 1M budget; the EFFECTIVE window is then set by
# CLAUDE_CODE_AUTO_COMPACT_WINDOW (capped by Claude Code at the model window), which
# apply_tiers derives from the smallest verified pool minimum — so a slug whose
# cheapest provider serves 912K is budgeted ~839K, not 200K and not a fake 1M.
with_context_hint() {
  local m="$1" min_ctx
  case "$m" in *'[1m]') printf '%s' "$m"; return 0 ;; esac   # idempotent
  # Use routing-aware cache key.
  local ck
  ck=$(cache_key_for "$m")
  min_ctx=$(python3 - "$PRICE_CACHE" "$ck" 2>/dev/null <<'PY'
import json, math, sys, time
CACHE_TTL, FUTURE_GRACE = 86400, 300   # shared cache-freshness policy
try:
    entry = json.load(open(sys.argv[1])).get("models", {}).get(sys.argv[2]) or {}
    v = entry.get("min_context_length")
    # bool is a subclass of int — exclude it explicitly
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        raise ValueError
    # Entries older than CACHE_TTL are unknown (the launch-time prefetch refreshes
    # them); future-dated entries beyond FUTURE_GRACE are poisoned or clock-skewed.
    age = time.time() - float(entry.get("fetched_at", 0))
    if not math.isfinite(age) or age > CACHE_TTL or age < -FUTURE_GRACE:
        raise ValueError
    print(int(v))
except Exception:
    pass
PY
)
  case "$min_ctx" in
    ''|*[!0-9]*) printf '%s' "$m" ;;
    *) [ "$min_ctx" -gt 200000 ] && printf '%s[1m]' "$m" || printf '%s' "$m" ;;
  esac
}

# Effective auto-compact window for the hinted slots: the smallest verified pool
# minimum, minus headroom for the response (MAX_OUTPUT_TOKENS=64000) and compaction
# slop. Callers pass only slugs that just passed with_context_hint, so cache
# freshness is prechecked here by construction.
compact_window_for() {  # $1..$N = base slugs that received [1m]
  # Convert each slug to its routing-aware cache key.
  local cks=()
  for s in "$@"; do
    cks+=("$(cache_key_for "$s")")
  done
  python3 - "$PRICE_CACHE" "${cks[@]}" 2>/dev/null <<'PY'
import json, sys
try:
    models = json.load(open(sys.argv[1])).get("models", {})
    mins = []
    for ck in sys.argv[2:]:
        v = (models.get(ck) or {}).get("min_context_length")
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            mins.append(int(v))
    if mins:
        m = min(mins)
        print(int(min(m * 0.92, m - 40000)))
except Exception:
    pass
PY
}

# Forget a context entry after a forced refresh fails. A direct --model launch
# promises fresh selected-model verification; retaining an older successful entry
# would let it apply [1m] and a compact window the provider no longer supports.
invalidate_context_slug() {  # $1 = bare slug (without routing)
  local ck
  ck=$(cache_key_for "$1")
  python3 - "$PRICE_CACHE" "$ck" <<'PY'
import fcntl, json, os, sys, tempfile
path, cache_key = sys.argv[1], sys.argv[2]
lock = open(path + ".lock", "a")
fcntl.flock(lock, fcntl.LOCK_EX)
try:
    try:
        cache = json.load(open(path))
    except Exception:
        cache = {}
    models = cache.get("models")
    if not isinstance(models, dict) or cache_key not in models:
        raise SystemExit(0)
    del models[cache_key]
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".price-cache.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(cache, f)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
finally:
    fcntl.flock(lock, fcntl.LOCK_UN)
    lock.close()
PY
}

# Print unique slugs whose provider metadata is absent, malformed, stale, or
# future-dated. This is deliberately the same fail-closed freshness rule used by
# with_context_hint; callers decide whether to wait or warm in the background.
# Output: routing-aware slugs (with routing suffix) ready for ccd-price-fetch.
stale_context_slugs() {
  # Convert input slugs to routing-aware cache keys.
  local cks=()
  for s in "$@"; do
    cks+=("$(cache_key_for "$s")")
  done
  python3 - "$PRICE_CACHE" "${cks[@]}" 2>/dev/null <<'PY'
import json, math, sys, time
CACHE_TTL, FUTURE_GRACE = 86400, 300
try:
    models = json.load(open(sys.argv[1])).get("models", {})
except Exception:
    models = {}
now = time.time()
for ck in dict.fromkeys(sys.argv[2:]):
    entry = models.get(ck) or {}
    try:
        age = now - float(entry.get("fetched_at", 0))
    except Exception:
        age = float("inf")
    if not math.isfinite(age) or age > CACHE_TTL or age < -FUTURE_GRACE:
        # Output the routing-aware slug (cache key) for caller compatibility.
        print(ck)
PY
}

# Resolve all three model slots into environment variables after applying one-time overrides.
apply_tiers() {
  local hinted_slugs="" RESOLVED
  # RESOLVED is intentionally written in the caller's scope (bash dynamic scoping):
  # command substitution would lose the hinted_slugs append.
  resolve_slot() { # $1 = raw slot value; $2 = hint|nohint; RESOLVED = routed (+ hinted) value
    local v b
    v=$(with_routing "$1")
    [ "$2" = "hint" ] && v=$(with_context_hint "$v")
    case "$v" in
      *'[1m]') b="${v%\[1m\]}"; hinted_slugs="$hinted_slugs ${b%%:*}" ;;
    esac
    RESOLVED="$v"
  }
  # Only the conversation-driving slots (sonnet/opus) get [1m]. Claude Code has ONE
  # global auto-compact window per process, sized below from the hinted slots'
  # smallest verified pool — hinting a small chore model (flash pool min 262K)
  # would crush that window to ~222K for EVERY model, kimi included. Unhinted, the
  # haiku slot keeps the safe 200K budget, always below its real ceiling.
  resolve_slot "$ANTHROPIC_DEFAULT_HAIKU_MODEL"  nohint; ANTHROPIC_DEFAULT_HAIKU_MODEL="$RESOLVED"
  resolve_slot "$ANTHROPIC_DEFAULT_SONNET_MODEL" hint;   ANTHROPIC_DEFAULT_SONNET_MODEL="$RESOLVED"
  resolve_slot "$ANTHROPIC_DEFAULT_OPUS_MODEL"   hint;   ANTHROPIC_DEFAULT_OPUS_MODEL="$RESOLVED"
  ANTHROPIC_DEFAULT_FABLE_MODEL="$ANTHROPIC_DEFAULT_OPUS_MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
         ANTHROPIC_DEFAULT_OPUS_MODEL  ANTHROPIC_DEFAULT_FABLE_MODEL
  export ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
  export CLAUDE_CODE_SUBAGENT_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"

  # Fourth slot: always show the cheapest model at the bottom of the picker.
  resolve_slot "$(slug_of flash)" nohint
  export ANTHROPIC_CUSTOM_MODEL_OPTION="$RESOLVED"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="cheapest (${CCD_ROUTING:-floor})"

  # One global window per process: the smallest hinted ceiling (policy: see
  # with_context_hint). Unhinted slots keep their own 200K boundary.
  if [ -n "$hinted_slugs" ]; then
    local cw
    cw=$(compact_window_for $hinted_slugs)
    [ -n "$cw" ] && export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$cw"
  fi
}

show_models() {
  load_env
  printf '%sModel catalog%s  %s(price = input/output $ per 1M tokens)%s\n\n' "$b" "$r" "$d" "$r"
  awk '!/^#/ && NF>=4 {printf "  %-9s %-38s %-14s %s\n", $1, $2, $3, substr($0, index($0,$4))}' "$CATALOG"
  printf '\n%sTo switch during a session, enter the slug directly:%s  %s/model moonshotai/kimi-k3:%s%s\n' \
    "$d" "$r" "$b" "${CCD_ROUTING:-floor}" "$r"
  printf '%sFor a verified extended pool, follow the statusline’s exact [1m] command; it is a local Claude Code hint, not provider capacity.%s\n' "$d" "$r"
  printf '%sTo restart/resume a different model with a launch-time context budget:%s  %sccd -c --model provider/model%s\n' "$d" "$r" "$b" "$r"
  printf '%sTo persistently change the three slots:%s  %sccd pick%s\n' "$d" "$r" "$b" "$r"
}

tier_row() { # $1=alias $2=slug $3=purpose
  local k p; k=$(key_of "$2"); p=$(price_of "${k:-}")
  printf '  %s%-7s%s → %-36s %s%-13s %s%s\n' "$b" "$1" "$r" "$2" "$d" "${p:-?}" "$3" "$r"
}

status() {
  load_env
  printf '%sccd — Claude Code backbone switcher%s\n\n' "$b" "$r"

  printf '%sCurrent shell%s\n' "$b" "$r"
  if [ -n "${CCD_ACTIVE:-}" ]; then
    printf '  %sExternal backbone active%s\n' "$ylw" "$r"
  else
    printf '  %sAnthropic subscription%s — using claude.ai login\n' "$grn" "$r"
  fi
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    printf '  OpenRouter key: %sconfigured%s\n' "$grn" "$r"
  else
    printf '  OpenRouter key: %sempty%s → set it now with %sccd key%s\n' "$red" "$r" "$b" "$r"
  fi
  case "${CCD_ROUTING:-floor}" in
    floor)  printf '  Routing: %s:floor%s — lowest-cost provider for the model (minimum cost)\n' "$cyn" "$r" ;;
    exacto) printf '  Routing: %s:exacto%s — provider with reliable tool calls (higher cost)\n' "$cyn" "$r" ;;
    *)      printf '  Routing: %s:%s%s\n' "$cyn" "$CCD_ROUTING" "$r" ;;
  esac
  [ -f "$TIERS" ] && printf '  Assignment: %scustom (ccd pick)%s\n' "$cyn" "$r"

  printf '\n%sModels assigned to the three slots%s %s(switch instantly with /model)%s\n' "$b" "$r" "$d" "$r"
  tier_row "haiku"  "$ANTHROPIC_DEFAULT_HAIKU_MODEL"  "cheap chores · exploration"
  tier_row "sonnet" "$ANTHROPIC_DEFAULT_SONNET_MODEL" "default · everyday coding"
  tier_row "opus"   "$ANTHROPIC_DEFAULT_OPUS_MODEL"   "hard decisions · debugging"

  # What to do when quota dies depends on whether anything will do it for you.
  # Telling someone who turned automation ON to type the manual commands is the
  # kind of small lie that makes people distrust the automation.
  if is_ccd_shim "$CCD_SHIM_DIR/claude"; then
    printf '\n%sWhen quota runs out%s %s(automatic handoff is on)%s\n' "$b" "$r" "$grn" "$r"
    if shim_leads_path; then
      printf '  %sNothing to type.%s The conversation moves to OpenRouter by itself,\n' "$grn" "$r"
      printf '  and returns to your subscription when the window resets.\n'
      # The manual route still works and always will. Automation you cannot step
      # around is worse than no automation — show the way out, quietly.
      printf '  %sIf it ever does not fire: /exit, then ccd -c (the manual route still works)%s\n' "$d" "$r"
    else
      printf '  %s⚠ installed, but not active in this shell.%s Open a new terminal, or:\n' "$ylw" "$r"
      printf '    %s%s%s\n' "$b" "$CCD_PATH_LINE" "$r"
    fi
    printf '  %sTurn it off with: ccd setup --no-auto%s\n' "$d" "$r"
  else
    printf '\n%sWhen quota runs out — these two commands%s\n' "$b" "$r"
    printf '  %s1. /exit%s        End the current session %s(required)%s\n' "$b" "$r" "$d" "$r"
    printf '  %s2. ccd -c%s       In the same terminal; restores the conversation\n' "$b" "$r"
    printf '  %sWant this to happen by itself next time? Run: ccd setup --auto%s\n' "$d" "$r"
  fi
  printf '\n%sOther commands%s\n' "$b" "$r"
  printf '  %sccd pick%s        Change the three model slots\n' "$b" "$r"
  printf '  %sccd models%s      Full catalog and prices\n' "$b" "$r"
  printf '  %sccd doctor%s      Diagnose problems first\n' "$b" "$r"
  printf '\n  %sDetailed procedure: ~/.claude/ccd/QUOTA-SOS.md%s\n' "$d" "$r"
}

pick() {
  load_env
  [ -f "$CATALOG" ] || die "Catalog not found: $CATALOG"
  local keys=() i=1 k
  while read -r k; do keys+=("$k"); done < <(awk '!/^#/ && NF>=4 {print $1}' "$CATALOG")

  printf '%sAssign models to three slots%s  %s(Enter = keep current)%s\n\n' "$b" "$r" "$d" "$r"
  i=1
  for k in "${keys[@]}"; do
    printf '  %s%2d%s) %-9s %-36s %s%s  %s%s\n' "$b" "$i" "$r" "$k" \
      "$(slug_of "$k")" "$d" "$(price_of "$k")" "$(note_of "$k")" "$r"
    i=$((i+1))
  done
  printf '\n'

  local out="" tier cur ans idx sel
  for tier in HAIKU SONNET OPUS; do
    case "$tier" in
      HAIKU)  cur="$ANTHROPIC_DEFAULT_HAIKU_MODEL";  hint="cheap chores · exploration" ;;
      SONNET) cur="$ANTHROPIC_DEFAULT_SONNET_MODEL"; hint="default · everyday coding" ;;
      OPUS)   cur="$ANTHROPIC_DEFAULT_OPUS_MODEL";   hint="hard decisions · debugging" ;;
    esac
    printf '%s%s%s (%s)\n  Current: %s\n  Enter a number or key> ' "$b" "$tier" "$r" "$hint" "$cur"
    read -r ans || ans=""
    sel="$cur"
    if [ -n "$ans" ]; then
      if [ "$ans" -eq "$ans" ] 2>/dev/null; then
        idx=$((ans-1))
        [ "$idx" -ge 0 ] && [ "$idx" -lt "${#keys[@]}" ] && sel=$(slug_of "${keys[$idx]}") \
          || { printf '%s  Number out of range. Keeping current value.%s\n' "$ylw" "$r"; }
      else
        sel=$(slug_of "$ans") || { printf '%s  Unknown key. Keeping current value.%s\n' "$ylw" "$r"; sel="$cur"; }
      fi
    fi
    out+="export ANTHROPIC_DEFAULT_${tier}_MODEL=\"$sel\"\n"
    printf '  %s→ %s%s\n\n' "$grn" "$sel" "$r"
  done

  { printf '# Generated by ccd pick. Delete this file to restore openrouter.env defaults.\n'; printf "%b" "$out"; } > "$TIERS"
  printf '%sSaved: %s%s\n' "$grn" "$TIERS" "$r"
  printf '%sTakes effect on the next ccd run.%s\n' "$d" "$r"
}

doctor() {
  load_env; require_key; apply_tiers
  # "Why did nothing happen?" is the question the first user test ended on.
  # Installed is not active, and active in some shell is not supervising THIS one.
  printf '\n%sAutomatic handoff%s\n' "$b" "$r"
  if is_ccd_shim "$CCD_SHIM_DIR/claude"; then
    printf '  %s✓%s installed at %s\n' "$grn" "$r" "$(tilde "$CCD_SHIM_DIR/claude")"
    if shim_leads_path; then
      printf '  %s✓%s active in this shell — `claude` starts the supervised launcher\n' "$grn" "$r"
    else
      printf '  %s✗ not active in this shell%s — `claude` here is the plain one\n' "$red" "$r"
      printf '      %sOpen a new terminal, or run: %s%s\n' "$d" "$CCD_PATH_LINE" "$r"
    fi
    if [ -n "${CCD_HANDOFF:-}" ]; then
      printf '  %s✓%s this session is supervised — a quota handoff will fire here\n' "$grn" "$r"
    elif [ -n "${CLAUDECODE:-}" ]; then
      printf '  %s✗ this session is NOT supervised%s — nothing will hand off from here\n' "$red" "$r"
      printf '      %sIt started before the launcher was on PATH. /exit, then run claude again.%s\n' "$d" "$r"
    fi
  else
    printf '  %s· off%s — turn it on with: ccd setup --auto\n' "$d" "$r"
  fi

  # Spare subscriptions. A dead spare is worth reporting loudly: it looks fine in
  # every other view, and its failure only surfaces at the moment of the handoff.
  printf '\n%sSpare Claude accounts%s\n' "$b" "$r"
  if [ ! -x "$SELF_DIR/ccd-account" ]; then
    printf '  %s· unavailable%s — ccd-account is missing from this install\n' "$d" "$r"
  else
    local acct_json
    acct_json=$("$SELF_DIR/ccd-account" --no-color list --json 2>/dev/null)
    ACCT_JSON="$acct_json" ACCT_DIR="$CCD_DIR/accounts" python3 - <<'PY'
import json, os, stat
try:
    d = json.loads(os.environ.get("ACCT_JSON") or "")
except Exception:
    d = None
G, Y, R, DIM, RS = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"
if not isinstance(d, dict) or not d.get("accounts"):
    print(f"  {DIM}· none registered{RS} — with a second Claude subscription, "
          f"quota exhaustion moves there before OpenRouter")
    print(f"      {DIM}Register the current login:  ccd account add{RS}")
    raise SystemExit(0)
accounts = d["accounts"]
for a in accounts:
    q = a.get("quota") or {}
    st = q.get("status")
    mark = f"{G}●{RS}" if a.get("active") else f"{DIM}○{RS}"
    if st == "ok":
        parts = [f"{lbl} {q[k]}%" for k, lbl in
                 (("five_hour_percent", "5h"), ("seven_day_percent", "7d"))
                 if isinstance(q.get(k), (int, float))]
        tint = G if a.get("headroom") else Y
        body = f"{tint}{' · '.join(parts)}{RS}"
    elif st == "dead":
        body = f"{R}needs re-login — cannot receive a handoff{RS}"
    else:
        body = f"{DIM}quota unreadable{RS}"
    role = "active" if a.get("active") else "spare"
    print(f"  {mark} {a['name']:<14} {DIM}{role:<6}{RS} {body}")
spares = [a for a in accounts if not a.get("active")]
if not spares:
    print(f"      {DIM}Only one account registered — sign in to another "
          f"(/login) and run `ccd account add`.{RS}")
elif not any(a.get("headroom") for a in spares):
    print(f"      {DIM}No spare has room right now; a handoff would go to "
          f"OpenRouter.{RS}")
# The store holds refresh tokens good for days. Loose permissions matter.
p = os.environ["ACCT_DIR"]
try:
    mode = stat.S_IMODE(os.stat(p).st_mode)
    if mode & 0o077:
        print(f"  {R}✗{RS} {p} is mode {mode:o} — should be 700. Fix: chmod 700 {p}")
    bad = [f for f in os.listdir(p) if f.endswith(".json")
           and stat.S_IMODE(os.stat(os.path.join(p, f)).st_mode) & 0o077]
    if bad:
        print(f"  {R}✗{RS} world/group-readable account files: {', '.join(bad)}")
except OSError:
    pass
PY
  fi

  local model="$ANTHROPIC_MODEL"
  [ $# -ge 1 ] && { model=$(slug_of "$1") || die "Unknown model key: $1"; model=$(with_routing "$model"); }
  # The [1m] hint is Claude Code-local — never send it to the provider.
  model="${model%\[1m\]}"
  printf '%s→ Validating %s / %s...%s\n' "$d" "$ANTHROPIC_BASE_URL" "$model" "$r"
  local code
  code=$(curl -sS -o /tmp/ccd-doctor.json -w '%{http_code}' \
    -X POST "$ANTHROPIC_BASE_URL/v1/messages" \
    -H "Authorization: Bearer $ANTHROPIC_AUTH_TOKEN" \
    -H "anthropic-version: 2023-06-01" -H "content-type: application/json" \
    -d "{\"model\":\"$model\",\"max_tokens\":8,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" \
    --max-time 45) || die "Network failure — cannot reach $ANTHROPIC_BASE_URL"

  case "$code" in
    200) printf '%s✓ OK%s — ready to switch with `ccd -c`.\n' "$grn" "$r" ;;
    401|403) printf '%s✗ %s authentication rejected%s — the OpenRouter key is invalid or expired.\n' "$red" "$code" "$r" ;;
    402) printf '%s✗ 402%s — insufficient OpenRouter balance. Add credits.\n' "$red" "$r" ;;
    400|404) printf '%s△ %s%s — authentication passed; the model slug is probably invalid.\n' "$ylw" "$code" "$r"
             printf '  Response: %s\n' "$(head -c 300 /tmp/ccd-doctor.json)"
             printf '  %sCheck the slug at openrouter.ai/models and update %s.%s\n' "$d" "$CATALOG" "$r" ;;
    *)   printf '%s✗ HTTP %s%s\n  Response: %s\n' "$red" "$code" "$r" "$(head -c 300 /tmp/ccd-doctor.json)" ;;
  esac

  # Context budget per slot: refresh each slug's provider data, then report what
  # apply_tiers will do. Rows show each model's own ceiling; the footer shows the
  # one process-wide window Claude Code actually uses (smallest hinted ceiling).
  printf '\n%sContext budget per slot%s %s([1m] on sonnet/opus; auto-compact = smallest verified pool − headroom)%s\n' "$b" "$d" "$r"
  local slot sm base refreshed ceiling cw hinted_bases=""
  for slot in HAIKU SONNET OPUS; do
    case "$slot" in
      HAIKU)  sm="$ANTHROPIC_DEFAULT_HAIKU_MODEL" ;;
      SONNET) sm="$ANTHROPIC_DEFAULT_SONNET_MODEL" ;;
      OPUS)   sm="$ANTHROPIC_DEFAULT_OPUS_MODEL" ;;
    esac
    base="${sm%\[1m\]}"; base="${base%%:*}"
    # Fetch under the SAME routing-aware key the readers below use; a bare-key
    # write would land in a different cache entry and every row would read as
    # "ctx unknown" even right after a successful refresh.
    [ -x "$SELF_DIR/ccd-price-fetch" ] && "$SELF_DIR/ccd-price-fetch" "$(cache_key_for "$base")" >/dev/null 2>&1
    # Recompute the hint from the JUST-refreshed cache — the value wired at apply_tiers
    # time is stale by one refresh, and the row must show what the next launch will do.
    case "$slot" in
      HAIKU)  refreshed="${sm%\[1m\]}" ;;                    # chore slot: never hinted
      *)      refreshed=$(with_context_hint "${sm%\[1m\]}") ;;
    esac
    ceiling=""
    case "$refreshed" in
      *'[1m]') hinted_bases="$hinted_bases $base"; ceiling=$(compact_window_for "$base") ;;
    esac
    python3 - "$PRICE_CACHE" "$(cache_key_for "$base")" "$slot" "$refreshed" "$ceiling" "$base" <<'PY'
import json, math, sys, time
CACHE_TTL, FUTURE_GRACE = 86400, 300   # shared cache-freshness policy
cache, cache_key, slot, wired, ceiling, base = sys.argv[1:7]
try:
    entry = json.load(open(cache)).get("models", {}).get(cache_key) or {}
except Exception:
    entry = {}
lo, hi = entry.get("min_context_length"), entry.get("max_context_length")
def num(v): return isinstance(v, (int, float)) and not isinstance(v, bool)
fresh = False
try:
    age = time.time() - float(entry.get("fetched_at", 0))
    fresh = math.isfinite(age) and age <= CACHE_TTL and age >= -FUTURE_GRACE
except Exception:
    fresh = False
hint = "applied" if wired.endswith("[1m]") else "not applied"
ctx = ""
if num(lo) and fresh:
    ctx = f"providers {int(lo):,}–{int(hi):,} ctx" if num(hi) and hi != lo else f"providers {int(lo):,} ctx"
if wired.endswith("[1m]") and ceiling:
    print(f"  {slot:<6} → {base:<34} {ctx} → ceiling ~{int(ceiling):,} ([1m] {hint})")
else:
    if not ctx:
        why = "ctx unknown, stays"
    elif num(lo) and lo > 200000:
        why = f"{ctx}, but slot stays"                     # chore slot: deliberate
    else:
        why = f"pool min {int(lo):,} ≤ 200K, stays"
    print(f"  {slot:<6} → {base:<34} {why} → 200K budget ([1m] {hint})")
PY
  done
  if [ -n "$hinted_bases" ]; then
    cw=$(compact_window_for $hinted_bases)
    [ -n "$cw" ] && printf '  %ssession auto-compact window: %s (smallest hinted ceiling)%s\n' "$d" "$cw" "$r"
  fi
}

# Read cumulative usage for the current OpenRouter key. Return empty on error so ccd can still start.
openrouter_usage() {
  curl -fsS --max-time 5 \
    -H "Authorization: Bearer $ANTHROPIC_AUTH_TOKEN" \
    "$ANTHROPIC_BASE_URL/v1/key" 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin).get("data", {})
    value = data.get("usage")
    print(float(value)) if isinstance(value, (int, float)) else None
except Exception:
    pass
' 2>/dev/null
}

# Record the cost baseline and weekly quota state when ccd starts.
# The key is used only in the header and is never stored in this file.
#
# Fetching the usage baseline can delay claude on a slow network, so do it in the
# background: first write null to the state file and start claude immediately, then
# fill the baseline after a successful fetch. Until then, the statusline shows
# "spend n/a" and becomes accurate on the first hook update.
fill_baseline_async() {
  (
    u=$(openrouter_usage)
    [ -n "$u" ] || exit 0
    CCD_U="$u" python3 - "$RUN_STATE" "$OUTAGE_STATE" <<'PY' 2>/dev/null
import json, os, sys, tempfile

def write_atomic(p, obj):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".ccd-state.")
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, p)
    os.chmod(p, 0o600)

usage = float(os.environ["CCD_U"])
run_path, outage_path = sys.argv[1], sys.argv[2]

try:
    state = json.load(open(run_path))
except Exception:
    raise SystemExit(0)
# Do not overwrite state if the hook has already started calculating costs.
if state.get("baseline_usage_usd") is None and state.get("ccd_spend_usd") is None:
    state["baseline_usage_usd"] = usage
    write_atomic(run_path, state)

# Outage baseline: preserved across ccd restarts.
# Create it only when missing (the first ccd run in this quota outage).
# quota-guard clears it when it detects a Claude quota reset (100 -> 0).
if not os.path.exists(outage_path):
    write_atomic(outage_path, {
        "started_at": state.get("started_at"),
        "baseline_usage_usd": usage,
        "outage_spend_usd": 0.0,
    })
PY
  ) >/dev/null 2>&1 &
}

init_run_state() {
  local usage="" started five five_reset seven seven_reset
  started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  read -r five five_reset seven seven_reset < <(python3 - "$QUOTA_CACHE" 2>/dev/null <<'PY'
import json, sys
try:
    c = json.load(open(sys.argv[1])).get("claude") or {}
    v = lambda key: "" if not isinstance(c.get(key), (int, float)) else int(c[key])
    print(v("fiveHourPercent"), c.get("fiveHourReset") or "", v("sevenDayPercent"), c.get("sevenDayReset") or "")
except Exception:
    print("   ")
PY
)
  RUN_STARTED="$started" RUN_USAGE="$usage" RUN_FIVE="$five" RUN_FIVE_RESET="$five_reset" RUN_SEVEN="$seven" RUN_SEVEN_RESET="$seven_reset" \
    python3 - "$RUN_STATE" <<'PY'
import json, os, sys, tempfile
p = sys.argv[1]
def number(name):
    try: return float(os.environ[name])
    except (KeyError, ValueError): return None
state = {
    "started_at": os.environ["RUN_STARTED"],
    "baseline_usage_usd": number("RUN_USAGE"),
    "ccd_spend_usd": None,
    "cost_updated_at": None,
    "initial_five_hour_percent": number("RUN_FIVE"),
    "last_five_hour_percent": number("RUN_FIVE"),
    "initial_five_hour_reset": os.environ.get("RUN_FIVE_RESET") or None,
    "last_five_hour_reset": os.environ.get("RUN_FIVE_RESET") or None,
    "initial_seven_day_percent": number("RUN_SEVEN"),
    "last_seven_day_percent": number("RUN_SEVEN"),
    "initial_seven_day_reset": os.environ.get("RUN_SEVEN_RESET") or None,
    "last_seven_day_reset": os.environ.get("RUN_SEVEN_RESET") or None,
    "recovery_notified_window": None,
    "recovery_notified_reset": None,
}
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".run-state.")
with os.fdopen(fd, "w") as f:
    json.dump(state, f, ensure_ascii=False)
    f.write("\n")
os.replace(tmp, p)
os.chmod(p, 0o600)
PY
}

# ── Entry point ───────────────────────────────────────────────────────────
# The auto-handoff shim gets its own directory rather than ~/.local/bin, which is
# where the official installer already puts `claude` — a symlink into
# ~/.local/share/claude/versions/. Shadowing it there would break the only link to
# the real binary, and a Claude Code update would rewrite that symlink and silently
# remove the shim. Its own directory needs a PATH entry to be found, which is the
# one line `ccd setup --auto` offers to add.
# Paths in messages read better as ~/... than as /Users/someone/... — these lines
# are about a file the user may want to look at, not about being precise.
tilde() { case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

CCD_SHIM_DIR="$CCD_DIR/bin"
# Ownership decides whether we overwrite or delete a file the user may have put
# there. A substring match is not good enough for that: a hand-written wrapper
# with "ccd launcher" in a comment would be treated as ours. Match the whole
# signature line, and keep this literal byte-identical to the one in the generated
# shim below. Bounded read — the real claude may be a big binary.
CCD_SHIM_SIG='# ccd-auto-handoff-shim v1 (managed by: ccd setup --auto)'
is_ccd_shim() {
  [ -f "$1" ] || return 1
  head -c 4096 "$1" 2>/dev/null | grep -qxF "$CCD_SHIM_SIG"
}

# The PATH line is written as a marked pair so removal is exact — we never edit a
# line we did not write.
CCD_PATH_SIG='# ccd-auto-handoff-path v1 (managed by: ccd setup --auto)'
CCD_PATH_LINE='export PATH="$HOME/.claude/ccd/bin:$PATH"'

# Which startup file to edit. Only the shells whose syntax the line above is valid
# in: fish and friends get told what to do rather than handed something broken.
rc_file() {
  case "${SHELL##*/}" in
    zsh)  printf '%s' "${ZDOTDIR:-$HOME}/.zshrc" ;;
    bash) if [ -f "$HOME/.bashrc" ]; then printf '%s' "$HOME/.bashrc"
          elif [ -f "$HOME/.bash_profile" ]; then printf '%s' "$HOME/.bash_profile"
          elif [ -f "$HOME/.profile" ]; then printf '%s' "$HOME/.profile"
          else printf '%s' "$HOME/.bashrc"; fi ;;
    *)    return 1 ;;
  esac
}

# Removal must not depend on rc_file() answering the same way it did at install
# time — bash reads different files for login and interactive shells, and a
# ~/.bashrc created later would move the answer and strand our line in the old
# file. So record every file we actually wrote to, and clean exactly those.
CCD_PATH_TARGET="$CCD_DIR/auto-path"
record_path_target() {
  grep -qxF "$1" "$CCD_PATH_TARGET" 2>/dev/null && return 0
  printf '%s\n' "$1" >> "$CCD_PATH_TARGET" 2>/dev/null
}
rc_candidates() {
  printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.zshrc" \
    "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"
}

# Is the shim already the first `claude` on PATH? Then nothing needs adding —
# the user may well have wired it up themselves.
shim_leads_path() {
  local d c
  local IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    c="$d/claude"
    { [ -x "$c" ] && [ ! -d "$c" ]; } || continue
    is_ccd_shim "$c" && return 0
    return 1
  done
  return 1
}

path_line_present() { [ -f "$1" ] && grep -qxF "$CCD_PATH_SIG" "$1"; }

# Take back exactly what we wrote: our marker, and the line after it only when it
# is still verbatim the export we put there. If the user edited that line it is
# theirs now — drop the marker and leave their edit alone. Deleting a line we did
# not write is the one failure mode this whole design exists to avoid.
remove_path_line() {
  local rc="$1" tmp target
  path_line_present "$rc" || return 0
  # Rewrite the file a symlink points at, rather than replacing the symlink.
  target=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$rc" 2>/dev/null)
  [ -n "$target" ] || target="$rc"
  tmp=$(mktemp "$target.ccd.XXXXXX") || return 1
  if ! awk -v sig="$CCD_PATH_SIG" -v line="$CCD_PATH_LINE" '
    skip      { skip = 0; if ($0 == line) next }
    $0 == sig { skip = 1; next }
    { print }
  ' "$target" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  # Swap atomically. Copying back over the original would truncate it first, so a
  # failure partway through would leave someone's startup file empty — the file
  # is either the old one or the new one, never a ruin of both.
  python3 - "$target" "$tmp" <<'CCD_SWAP' || { rm -f "$tmp"; return 1; }
import os, shutil, sys
target, tmp = sys.argv[1], sys.argv[2]
shutil.copymode(target, tmp)
try:
    st = os.stat(target)
    os.chown(tmp, st.st_uid, st.st_gid)
except OSError:
    pass          # not ours to give away; the mode is what matters
os.replace(tmp, target)
CCD_SWAP
}

# Clean the files we recorded writing to — and only those. The marker is an
# ownership assertion in a line WE appended; the same text sitting in someone's
# startup file (inside a heredoc, a docstring, a pasted snippet) is their data.
# Editing it would break the promise this whole design rests on, so unrecorded
# copies get pointed at, never touched.
remove_path_line_everywhere() {
  local f removed=1 failed=0
  if [ -f "$CCD_PATH_TARGET" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      path_line_present "$f" || continue
      if remove_path_line "$f"; then
        printf '✓ PATH line removed from %s\n' "$(tilde "$f")"
        removed=0
      else
        printf '%s⚠ could not rewrite %s — remove the ccd PATH line by hand%s\n' "$ylw" "$(tilde "$f")" "$r"
        failed=1
      fi
    done <<RC_RECORDED
$(awk '!seen[$0]++' "$CCD_PATH_TARGET" 2>/dev/null)
RC_RECORDED
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    grep -qxF "$f" "$CCD_PATH_TARGET" 2>/dev/null && continue
    path_line_present "$f" \
      && printf '%s⚠ a ccd PATH line also appears in %s — left alone, since we did not write it%s\n' \
           "$ylw" "$(tilde "$f")" "$r"
  done <<RC_OTHERS
$(rc_candidates)
RC_OTHERS
  # Keep the record when something failed, so a retry still knows where to look.
  if [ "$failed" -eq 1 ]; then
    return 1
  fi
  rm -f "$CCD_PATH_TARGET"
  return "$removed"
}

setup() {
  local launcher="$HOME/.local/bin/ccd" statusline_launcher="$CCD_DIR/statusline-launcher.sh"
  local settings="$HOME/.claude/settings.json"
  local auto=0 assume_yes=0 auto_next=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --auto)    auto=1; shift ;;
      --no-auto) auto=-1; shift ;;
      --yes|-y)  assume_yes=1; shift ;;
      *) die "Usage: ccd setup [--auto|--no-auto] [--yes]" ;;
    esac
  done
  mkdir -p "$HOME/.local/bin" "$CCD_DIR" "$HOME/.claude"
  [ -L "$launcher" ] && rm "$launcher"
  cat > "$launcher" <<'CCD_LAUNCHER'
#!/usr/bin/env bash
# ccd launcher — resolves the newest installed ccd plugin. Regenerated by `ccd setup`.
t=$(ls -d "$HOME/.claude/plugins/cache"/*/ccd/*/bin/ccd 2>/dev/null | sort -V | tail -1)
[ -n "$t" ] || { echo "ccd: plugin not found — reinstall the ccd plugin" >&2; exit 1; }
exec "$t" "$@"
CCD_LAUNCHER
  chmod +x "$launcher"
  cat > "$statusline_launcher" <<'CCD_STATUSLINE_LAUNCHER'
#!/usr/bin/env bash
# ccd statusline launcher — resolves the newest installed ccd plugin. Regenerated by `ccd setup`.
t=$(ls -d "$HOME/.claude/plugins/cache"/*/ccd/*/bin/ccd-statusline 2>/dev/null | sort -V | tail -1)
[ -n "$t" ] || exit 0
exec "$t"
CCD_STATUSLINE_LAUNCHER
  chmod +x "$statusline_launcher"

  # Automatic handoff is opt-in: it shadows the `claude` command, which is too
  # invasive to install without being asked. --auto installs, --no-auto removes,
  # and a bare `ccd setup` leaves whatever is already there alone.
  local claude_shim="$CCD_SHIM_DIR/claude"
  case "$auto" in
    1)
      mkdir -p "$CCD_SHIM_DIR"
      # Never clobber a claude the user put here themselves — uninstall protects
      # it, so install must too, or we would delete what we refuse to.
      if { [ -e "$claude_shim" ] || [ -L "$claude_shim" ]; } \
         && ! is_ccd_shim "$claude_shim"; then
        printf '%s✗ %s already exists and is not a ccd shim — not touching it.%s\n' "$red" "$(tilde "$claude_shim")" "$r" >&2
        printf '  %sMove or remove it first, then re-run: ccd setup --auto%s\n' "$d" "$r" >&2
        return 1
      fi
      [ -L "$claude_shim" ] && rm "$claude_shim"
      cat > "$claude_shim" <<'CCD_CLAUDE_SHIM'
#!/usr/bin/env bash
# ccd-auto-handoff-shim v1 (managed by: ccd setup --auto)
# Automatic quota handoff. Regenerated by `ccd setup --auto`.
# Resolves the newest installed ccd plugin, so plugin updates apply without
# re-running setup. CCD_SHIM_PATH lets the handoff script skip this file when it
# looks for the real claude on PATH.
self=$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")
t=$(ls -d "$HOME/.claude/plugins/cache"/*/ccd/*/bin/ccd-handoff 2>/dev/null | sort -V | tail -1)
if [ -z "$t" ]; then
  # Never strand the user: fall through to the real claude if the plugin is gone.
  # Compare resolved paths, not strings — a relative PATH entry or a different
  # spelling of this file's own directory would otherwise re-exec us forever.
  IFS=: read -ra _dirs <<< "$PATH"
  for d in "${_dirs[@]}"; do
    [ -n "$d" ] || continue
    [ -x "$d/claude" ] && [ ! -d "$d/claude" ] || continue
    [ "$(cd "$d" 2>/dev/null && pwd)/claude" = "$self" ] && continue
    exec "$d/claude" "$@"
  done
  echo "ccd: neither the ccd plugin nor claude was found" >&2; exit 127
fi
CCD_SHIM_PATH="$self" exec "$t" "$@"
CCD_CLAUDE_SHIM
      chmod +x "$claude_shim"
      printf '✓ automatic handoff installed at %s\n' "$(tilde "$claude_shim")"
      printf '  %sWhen your Claude quota runs out, sessions continue on OpenRouter —%s\n' "$d" "$r"
      printf '  %spaid per token with your own key — and return to your subscription%s\n' "$d" "$r"
      printf '  %sby themselves when the quota resets.%s\n' "$d" "$r"

      # The shim is only reachable if its directory comes before the real claude
      # on PATH. Ask before editing a startup file: --auto is consent to install
      # the feature, not blanket consent to rewrite the user's dotfiles.
      if shim_leads_path; then
        printf '✓ already first on PATH — `claude` hands off on quota exhaustion\n'
      else
        local rc reply="" do_edit=0
        if rc=$(rc_file) && ! path_line_present "$rc"; then
          printf '\n  One line is still needed so your shell finds it first:\n'
          printf '    %s%s%s\n' "$b" "$CCD_PATH_LINE" "$r"
          # Consent, explicitly — but ask wherever a human can actually answer.
          # `ccd setup` is routinely run as a `!` command inside Claude Code,
          # where stdin is a pipe; `ccd key` already reaches past that to
          # /dev/tty for the same reason. Only when there is no controlling
          # terminal at all do we treat it as scripted and change nothing.
          if [ "$assume_yes" -eq 1 ]; then
            do_edit=1
          elif [ -t 0 ] && [ -t 1 ]; then
            printf '  Add it to %s? %s[Y/n]%s ' "$(tilde "$rc")" "$d" "$r"
            read -r reply || reply=n
            case "${reply:-y}" in y|Y|yes|YES) do_edit=1 ;; esac
          elif (exec < /dev/tty) 2>/dev/null; then
            printf '  Add it to %s? %s[Y/n]%s ' "$(tilde "$rc")" "$d" "$r" > /dev/tty
            read -r reply < /dev/tty || reply=n
            printf '\n' > /dev/tty
            case "${reply:-y}" in y|Y|yes|YES) do_edit=1 ;; esac
          fi
          if [ "$do_edit" -eq 1 ]; then
            # Record ownership BEFORE editing. Removal only ever touches files we
            # recorded, so an edit that escaped the record could never be taken
            # back out — and setup would still have claimed success. A record with
            # no edit behind it is harmless by comparison: removal finds no marker.
            if ! record_path_target "$rc" 2>/dev/null; then
              printf '%s⚠ could not record ownership in %s — leaving %s alone.%s\n' \
                "$ylw" "$(tilde "$CCD_PATH_TARGET")" "$(tilde "$rc")" "$r"
              printf '  %sAdd the line yourself, then open a new terminal.%s\n' "$d" "$r"
            elif { printf '\n%s\n%s\n' "$CCD_PATH_SIG" "$CCD_PATH_LINE" >> "$rc"; } 2>/dev/null; then
              printf '✓ added to %s\n' "$(tilde "$rc")"
              auto_next="source $(tilde "$rc")"
            else
              printf '%s⚠ could not write %s — add the line yourself%s\n' "$ylw" "$(tilde "$rc")" "$r"
            fi
          else
            printf '  %sSkipped — automatic handoff is installed but not active yet.%s\n' "$ylw" "$r"
            printf '  %sAdd that line yourself, or re-run: ccd setup --auto --yes%s\n' "$d" "$r"
          fi
        elif [ -n "${rc:-}" ]; then
          printf '✓ PATH line already in %s — open a new terminal if `claude` is not ours yet\n' "$(tilde "$rc")"
        else
          printf '\n  %sAdd this to your shell startup file, then open a new terminal:%s\n' "$d" "$r"
          printf '    %s%s%s\n' "$b" "$CCD_PATH_LINE" "$r"
        fi
      fi
      ;;
    -1)
      if is_ccd_shim "$claude_shim"; then
        rm "$claude_shim"; printf '✓ automatic handoff disabled\n'
      elif [ -e "$claude_shim" ] || [ -L "$claude_shim" ]; then
        printf '%s⚠ %s is not a ccd shim — left alone%s\n' "$ylw" "$(tilde "$claude_shim")" "$r"
      fi
      # Take the PATH line back out with the shim: an entry pointing at a
      # directory we just emptied is litter in someone's startup file.
      remove_path_line_everywhere || true
      ;;
  esac

  python3 - "$settings" <<'PY'
import json, os, sys, tempfile
p = sys.argv[1]
if os.path.exists(p):
    with open(p, encoding="utf-8") as f: data = json.load(f)
else: data = {}
hooks = data.get("hooks")
if isinstance(hooks, dict):
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list): continue
        kept_groups = []
        for group in groups:
            if not isinstance(group, dict):
                kept_groups.append(group); continue
            entries = group.get("hooks")
            if isinstance(entries, list):
                entries = [entry for entry in entries if not (
                    isinstance(entry, dict) and isinstance(entry.get("command"), str)
                    and "quota-guard.sh" in entry["command"])]
                if entries:
                    group["hooks"] = entries; kept_groups.append(group)
            else: kept_groups.append(group)
        if kept_groups: hooks[event] = kept_groups
        else: del hooks[event]
    if not hooks: del data["hooks"]
data["statusLine"] = {"type": "command", "command": "bash ~/.claude/ccd/statusline-launcher.sh"}
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".settings.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2); f.write("\n")
    os.replace(tmp, p)
finally:
    if os.path.exists(tmp): os.unlink(tmp)
PY

  printf '✓ ccd command installed (~/.local/bin/ccd)\n'
  printf '✓ statusline wired — dashboard output preserved\n'
  printf '→ In a running Claude Code session: /reload-plugins activates the hooks\n'
  case ":$PATH:" in *:"$HOME/.local/bin":*) ;; *) printf '→ Add to PATH: export PATH="$HOME/.local/bin:$PATH"\n' ;; esac
  if python3 - "$KEYS" <<'PY' >/dev/null 2>&1
import re, sys
try: text = open(sys.argv[1], encoding="utf-8").read()
except OSError: raise SystemExit(1)
m = re.search(r'^\s*(?:export\s+)?OPENROUTER_API_KEY\s*=\s*(.*?)\s*$', text, re.M)
if not m: raise SystemExit(1)
value = m.group(1)
if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'": value = value[1:-1]
raise SystemExit(0 if value else 1)
PY
  then printf '→ Verify anytime: ccd doctor\n'; else printf '→ Before quota runs out: set your OpenRouter key with `ccd key`\n'; fi
  # Last line on screen, because it is the only one that still needs doing. Buried
  # mid-output it reads as trivia — which is how someone ends up testing a handoff
  # in a shell that never had the launcher on PATH.
  if [ -n "$auto_next" ]; then
    printf '\n%s→ One thing left: that PATH line only reaches shells started from now on.%s\n' "$b" "$r"
    printf '%s     Open a new terminal, or run:  %s%s\n' "$b" "$auto_next" "$r"
  fi
}

uninstall() {
  local purge=0 launcher="$HOME/.local/bin/ccd"
  local statusline_launcher="$CCD_DIR/statusline-launcher.sh"
  local settings="$HOME/.claude/settings.json" statusline_result dashboard=""
  [ "$#" -le 1 ] || die "Usage: ccd uninstall [--purge]"
  case "${1:-}" in
    "") ;;
    --purge) purge=1 ;;
    *) die "Usage: ccd uninstall [--purge]" ;;
  esac

  dashboard=$(ls -d "$HOME/.claude/plugins/cache/claude-dashboard/claude-dashboard"/*/dist/index.js 2>/dev/null | sort -V | tail -1)
  statusline_result=$(python3 - "$settings" "$dashboard" <<'PY'
import json, os, sys, tempfile
p, dashboard = sys.argv[1:]
if not os.path.exists(p):
    print("removed")
    raise SystemExit(0)
with open(p, encoding="utf-8") as f:
    data = json.load(f)
status = data.get("statusLine")
command = status.get("command") if isinstance(status, dict) else None
changed = isinstance(command, str) and "statusline-launcher.sh" in command
result = "unchanged"
if changed:
    if dashboard:
        data["statusLine"] = {"type": "command", "command": "node " + dashboard}
        result = "dashboard"
    else:
        del data["statusLine"]
        result = "removed"
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".settings.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, p)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
elif status is None:
    result = "removed"
elif isinstance(command, str) and command.startswith("node ") and "/claude-dashboard/" in command:
    result = "dashboard"
print(result)
PY
  )

  case "$statusline_result" in
    dashboard) printf '✓ statusline restored (claude-dashboard)\n' ;;
    removed) printf '✓ statusline entry removed\n' ;;
    *) printf '✓ statusline left unchanged\n' ;;
  esac

  if [ -f "$launcher" ] && grep -q 'ccd launcher' "$launcher"; then
    rm "$launcher"
  elif [ -e "$launcher" ] || [ -L "$launcher" ]; then
    printf '⚠ ccd command not removed — ~/.local/bin/ccd is not a ccd launcher\n'
  fi
  # The auto-handoff shim shadows `claude`, so removing it matters more than the
  # rest: leaving one behind after uninstall would keep intercepting every launch.
  local claude_shim="$CCD_SHIM_DIR/claude"
  if is_ccd_shim "$claude_shim"; then
    rm "$claude_shim"
    printf '✓ automatic-handoff shim removed\n'
  elif [ -e "$claude_shim" ] || [ -L "$claude_shim" ]; then
    printf '⚠ %s left alone — not a ccd shim\n' "$(tilde "$claude_shim")"
  fi
  remove_path_line_everywhere || true
  [ -e "$statusline_launcher" ] || [ -L "$statusline_launcher" ] && rm "$statusline_launcher"
  printf '✓ launchers removed\n'

  if [ "$purge" -eq 1 ]; then
    rm -rf "$CCD_DIR"
    printf '✓ key, config, and state purged (~/.claude/ccd/)\n'
  else
    printf '✓ key & state kept (~/.claude/ccd/) — remove everything with: ccd uninstall --purge\n'
  fi
  printf '→ Finish in a terminal: claude plugin uninstall ccd@cc-donut && claude plugin marketplace remove cc-donut\n'
  printf '→ In a running session: /reload-plugins unloads the hooks — no restart needed\n'
}

# Exec the REAL claude, never the auto-handoff shim at ~/.local/bin/claude.
#
# A bare `exec claude` would find that shim first and start a SECOND handoff
# launcher underneath this one. The inner launcher inherits the OpenRouter
# environment we just exported, so when it later relaunches "back to the
# subscription" it hands the user a session that is still on OpenRouter — and
# the outer loop's hop cap no longer governs the round trip. One launcher
# supervises one session; ccd is always the supervised process, never a new
# supervisor. Skipping the shim also keeps `ccd off` honest.
exec_claude() {
  local d c self="${CCD_SHIM_PATH:-}"
  local IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    c="$d/claude"
    { [ -x "$c" ] && [ ! -d "$c" ]; } || continue
    # Identity first (the shim tells us its own path), then the ownership marker
    # for the case where ccd was invoked straight from a shell. Read a bounded
    # prefix: the real claude may be a large binary, and the marker sits on
    # line 2 of a 13-line script.
    [ -n "$self" ] && [ "$(cd "$d" 2>/dev/null && pwd)/claude" = "$self" ] && continue
    is_ccd_shim "$c" && continue
    exec "$c" "$@"
  done
  die "claude not found on PATH"
}

case "${1:-}" in
  ""|status|help|-h|--help) status; exit 0 ;;
  setup)  shift; setup "$@"; exit 0 ;;
  uninstall) shift; uninstall "$@"; exit 0 ;;
  key)    set_key; exit 0 ;;
  models) [ -f "$CATALOG" ] || die "Catalog not found: $CATALOG"; show_models; exit 0 ;;
  pick)   pick; exit 0 ;;
  account)
          shift
          [ -x "$SELF_DIR/ccd-account" ] || die "ccd-account is missing from this install"
          exec "$SELF_DIR/ccd-account" "$@" ;;
  doctor) shift; doctor "$@"; exit 0 ;;
  off)    shift
          unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL \
                ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
                ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL \
                ANTHROPIC_CUSTOM_MODEL_OPTION ANTHROPIC_CUSTOM_MODEL_OPTION_NAME \
                CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS \
                CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_MAX_OUTPUT_TOKENS \
                CCD_ACTIVE 2>/dev/null
          printf '%s▶ Running with Anthropic subscription%s\n' "$grn" "$r"
          exec_claude "$@" ;;
  go)     shift ;;
esac

load_env; require_key

# One-time override: --haiku/--sonnet/--opus <key|slug>. --model is intentionally
# stricter: it is the restart/resume escape hatch, so it accepts only a bare
# provider/model slug and must never leak to claude as an unknown flag or prompt.
args=()
selected_model=""
seen_sonnet=0
while [ $# -gt 0 ]; do
  case "$1" in
    --model)
      [ $# -ge 2 ] || die "--model requires a bare provider/model slug"
      [ -z "$selected_model" ] || die "--model may be specified once"
      valid_bare_slug "$2" || die "--model must be a bare provider/model slug (no routing or [1m])"
      selected_model="$2"
      shift 2 ;;
    --haiku|--sonnet|--opus)
      [ $# -ge 2 ] || die "$1 requires a model key (see ccd models)"
      s=$(slug_of "$2") || die "Unknown model key: $2"
      case "$1" in
        --haiku)  ANTHROPIC_DEFAULT_HAIKU_MODEL="$s" ;;
        --sonnet) ANTHROPIC_DEFAULT_SONNET_MODEL="$s"; seen_sonnet=1 ;;
        --opus)   ANTHROPIC_DEFAULT_OPUS_MODEL="$s" ;;
      esac
      shift 2 ;;
    --routing)
      [ $# -ge 2 ] || die "--routing requires floor, free, exacto, or nitro"
      case "$2" in floor|free|exacto|nitro) CCD_ROUTING="$2" ;; *) die "--routing requires floor, free, exacto, or nitro" ;; esac
      shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
[ -z "$selected_model" ] || [ "$seen_sonnet" -eq 0 ] || die "--model and --sonnet are ambiguous; use one"
[ -z "$selected_model" ] || ANTHROPIC_DEFAULT_SONNET_MODEL="$selected_model"

# Without an interactive screen (Claude Code ! command, script, or pipe), claude
# falls into headless mode and reports a misleading "provide a prompt" error.
# Allow it only when headless mode was explicitly requested with -p/--print.
# Checked BEFORE any network work: a refused launch must not pay the prefetch cost.
headless=0
for a in ${args+"${args[@]}"}; do
  case "$a" in -p|--print) headless=1 ;; esac
done
if [ "$headless" -eq 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  printf '\n%s✋ Exit Claude Code first.%s\n\n' "$red" "$r" >&2
  printf '  %s1.%s  %s/exit%s      %s← end the current session%s\n' "$b" "$r" "$b" "$r" "$d" "$r" >&2
  printf '  %s2.%s  %sccd -c%s     %s← in the same terminal; restores that conversation%s\n\n' \
    "$b" "$r" "$b" "$r" "$d" "$r" >&2
  printf '  %sReason: the backbone is chosen when claude starts and cannot change inside a running session.%s\n' "$d" "$r" >&2
  printf '  %sThe "last conversation" requested by -c is this active session, which creates a conflict.%s\n\n' "$d" "$r" >&2
  exit 1
fi

# Instant feedback before anything that can block (the prefetch below can take
# seconds on a stale cache) — never leave the terminal silent after `ccd -c`.
# A supervised launch was just explained by the launcher one line above; saying
# "switching backbone" again is noise at the moment the user wants to get back
# to work. Keep only what the launcher cannot know: which models answer now.
[ -n "${CCD_HANDOFF:-}" ] || printf '%s▶ Switching backbone: OpenRouter%s\n' "$ylw" "$r"

# apply_tiers budgets from the cached provider data. On a cache miss/stale entry the
# slot would launch at 200K even when the model serves far more — the exact failure
# ccd exists to prevent — so refresh the three slots synchronously (bounded by
# ccd-price-fetch's --max-time) BEFORE applying. ccd only works when OpenRouter is
# reachable anyway; a failed fetch just keeps the safe 200K default for this run.
if [ -x "$SELF_DIR/ccd-price-fetch" ]; then
  # Use routing-aware slugs for cache lookup and prefetch.
  slot_slugs=("${ANTHROPIC_DEFAULT_HAIKU_MODEL%%:*}" "${ANTHROPIC_DEFAULT_SONNET_MODEL%%:*}" "${ANTHROPIC_DEFAULT_OPUS_MODEL%%:*}")
  # An explicit restart model must be freshly verified even when its cache entry
  # is younger than the TTL: that option promises a selected-model launch budget.
  stale_slugs=$(stale_context_slugs "${slot_slugs[@]}")
  # Force-refresh the explicit selected model even when it is cached: this launch
  # path commits its global compact budget to that exact provider pool.
  # --model takes a BARE slug, but every reader (with_context_hint,
  # compact_window_for) looks the entry up under the routing-aware key — so route
  # it here too. Refreshing the bare key would write a cache entry nothing reads,
  # leaving a stale routing-aware entry to grant [1m] the pool no longer supports.
  selected_key=""
  if [ -n "$selected_model" ]; then
    selected_key=$(cache_key_for "$selected_model")
    stale_slugs=$(printf '%s\n%s\n' "$stale_slugs" "$selected_key" | awk 'NF && !seen[$0]++')
  fi
  if [ -n "$stale_slugs" ]; then
    printf '   %s⏳ refreshing provider data (first run or stale cache)%s\n' "$d" "$r"
    refresh_pids=""
    for s in $stale_slugs; do
      "$SELF_DIR/ccd-price-fetch" "$s" >/dev/null 2>&1 &
      refresh_pids="$refresh_pids $!:$s"
    done
    for pair in $refresh_pids; do
      pid=${pair%%:*}; slug=${pair#*:}
      if ! wait "$pid" && [ -n "$selected_key" ] && [ "$slug" = "$selected_key" ]; then
        invalidate_context_slug "$slug"
      fi
    done
  fi
fi

apply_tiers
export CCD_ACTIVE=1

if [ -n "${CCD_HANDOFF:-}" ]; then
  printf '%s▶ OpenRouter: haiku %s / sonnet %s / opus %s%s\n' "$ylw" \
    "$ANTHROPIC_DEFAULT_HAIKU_MODEL" "$ANTHROPIC_DEFAULT_SONNET_MODEL" \
    "$ANTHROPIC_DEFAULT_OPUS_MODEL" "$r"
  printf '%s   /model 로 전환 · 비용은 statusline · 복귀 안 되면 /exit 후 claude · /logout 금지%s\n' "$d" "$r"
else
  printf '   haiku %s / sonnet %s / opus %s\n' \
    "$ANTHROPIC_DEFAULT_HAIKU_MODEL" "$ANTHROPIC_DEFAULT_SONNET_MODEL" "$ANTHROPIC_DEFAULT_OPUS_MODEL"
  printf '%s   Switch instantly with /model haiku|sonnet|opus or /model <slug>.%s\n' "$d" "$r"
  printf '%s   Statusline adds: model·effort │ price per 1M │ run cost. Updates on prompts/tools.%s\n' "$d" "$r"
  printf '%s   To return to the subscription, /exit then run claude in the same terminal. Never /logout.%s\n' "$d" "$r"
fi

# Warm the curated Pareto/default set only after visible launch feedback. These
# detached writers share ccd-price-fetch's lock/atomic merge path with statusline
# refreshes, and never delay the dashboard or the selected-slot safety gate.
if [ -x "$SELF_DIR/ccd-price-fetch" ]; then
  prewarm_slugs=$(prewarm_catalog_slugs | awk '!seen[$0]++')
  prewarm_stale=$(stale_context_slugs $prewarm_slugs)
  if [ -n "$prewarm_stale" ]; then
    prewarm_count=$(printf '%s\n' "$prewarm_stale" | wc -l | tr -d ' ')
    printf '   %s⏳ warming %s catalog candidates in background%s\n' "$d" "$prewarm_count" "$r"
    (
      running=0
      for s in $prewarm_stale; do
        "$SELF_DIR/ccd-price-fetch" "$s" >/dev/null 2>&1 &
        running=$((running + 1))
        if [ "$running" -ge 3 ]; then wait; running=0; fi
      done
      wait
    ) >/dev/null 2>&1 &
  fi
fi

init_run_state
fill_baseline_async
# Claude Code takes a few seconds to boot and draw. After an automatic handoff
# that silence follows a banner the user did not ask for, which reads as a hang —
# one of them called it "the dashboard taking 5 seconds". ccd's own share of that
# gap is a fraction of a second; the rest is not ours to speed up, but it is ours
# to account for.
if [ -n "${CCD_HANDOFF:-}" ]; then
  printf '%s   Claude Code 여는 중…%s\n' "$d" "$r"
else
  printf '%s   Starting Claude Code...%s\n' "$d" "$r"
fi
# No detached price re-fetch here: the sync prefetch above already refreshed stale
# entries, fresh entries are good for a day, and the statusline fetches anything
# else lazily on its own. Three extra API hits per launch bought nothing.
exec_claude ${args+"${args[@]}"}
