#!/usr/bin/env bash
# ccd = the donut spare for Claude Code (repo: cc-donut)
#
# When the Claude subscription quota runs out, keep the Claude Code shell
# (tools, hooks, skills, and conversation history) and swap only the model to a low-cost OpenRouter model.
#
#   ccd                    Current status, assigned models, and usage
#   ccd -c                 Switch and resume the last conversation  <- emergency command
#   ccd go                 Switch into a new session
#   ccd -c --opus kimi     Use kimi for the opus slot for this run only
#   ccd pick               Choose models for the haiku/sonnet/opus slots (saved)
#   ccd models             Model catalog (slugs to paste into /model in a session)
#   ccd key                Enter the OpenRouter API key (no editor needed)
#   ccd doctor [key]       Validate with one API round trip before starting claude
#   ccd off                Run with the subscription again
#
# Switching back costs nothing. ANTHROPIC_AUTH_TOKEN masks the claude.ai login only
# in that process. Run `claude` in a new terminal to return to the subscription automatically.
# Never use /logout; it actually logs you out.
set -uo pipefail

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DIR="${CCD_PROVIDERS_DIR:-${CLAUDE_PROVIDERS_DIR:-$HOME/.claude/ccd/providers}}"
KEYS="$DIR/keys.env"
CONF="$DIR/openrouter.env"
CATALOG="$DIR/models.conf"
TIERS="$DIR/tiers.env"          # ccd pick saves here; when present, it overrides CONF defaults.
CCD_DIR="$HOME/.claude/ccd"
RUN_STATE="$CCD_DIR/run-state.json"
OUTAGE_STATE="$CCD_DIR/outage-state.json"   # Total for the quota outage, preserved across restarts.
QUOTA_CACHE="$CCD_DIR/quota-cache.json"
PRICE_CACHE="$CCD_DIR/price-cache.json"   # also carries per-slug provider context lengths
mkdir -p "$CCD_DIR"
[ "$DIR" = "$HOME/.claude/ccd/providers" ] && mkdir -p "$DIR"

bootstrap_config() {
  mkdir -p "$DIR"
  if [ ! -f "$CONF" ]; then
    if [ -f "$SELF_DIR/../templates/openrouter.env" ]; then
      cp "$SELF_DIR/../templates/openrouter.env" "$CONF"
    else
      cat > "$CONF" <<'CCD_OPENROUTER_ENV'
# OpenRouter backbone configuration — generated by ccd.
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
CCD_ROUTING="${CCD_ROUTING:-floor}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek/deepseek-v4-flash"
export ANTHROPIC_DEFAULT_SONNET_MODEL="openai/gpt-5.6-luna"
export ANTHROPIC_DEFAULT_OPUS_MODEL="moonshotai/kimi-k3"
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1000000"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="64000"
CCD_OPENROUTER_ENV
    fi
  fi
  if [ ! -f "$CATALOG" ]; then
    if [ -f "$SELF_DIR/../templates/models.conf" ]; then
      cp "$SELF_DIR/../templates/models.conf" "$CATALOG"
    else
      cat > "$CATALOG" <<'CCD_MODELS_CONF'
# OpenRouter model catalog — generated by ccd.
# Format: key slug in/out-price description
flash   deepseek/deepseek-v4-flash   0.11/0.22    Cheapest. For exploration/grep. No independent verification (caution)
luna    openai/gpt-5.6-luna          0.10/0.60    Frontier. Default everyday coding model
kimi    moonshotai/kimi-k3           2.90/14.00   Frontier. Opus slot: hard problems and debugging
sol     openai/gpt-5.6-sol           5.00/30.00   Frontier. Only for truly hard problems
terra   openai/gpt-5.6-terra         1.00/6.00    Frontier. Previous opus default
glm51   z-ai/glm-5.1                 0.98/4.30    Measured in Claude Code itself
CCD_MODELS_CONF
    fi
  fi
  if [ ! -f "$KEYS" ]; then
    printf 'OPENROUTER_API_KEY=""\n' > "$KEYS"
    chmod 600 "$KEYS"
  fi
}
bootstrap_config

if [ -f "$SELF_DIR/../QUOTA-SOS.md" ] && { [ ! -f "$CCD_DIR/QUOTA-SOS.md" ] || ! cmp -s "$SELF_DIR/../QUOTA-SOS.md" "$CCD_DIR/QUOTA-SOS.md"; }; then
  cp "$SELF_DIR/../QUOTA-SOS.md" "$CCD_DIR/QUOTA-SOS.md"
fi

r=$'\033[0m'; d=$'\033[2m'; b=$'\033[1m'
grn=$'\033[32m'; ylw=$'\033[33m'; red=$'\033[31m'; cyn=$'\033[36m'

die() { printf '%sccd: %s%s\n' "$red" "$*" "$r" >&2; exit 1; }

# Catalog lookup: key -> slug (a direct slug passes through unchanged).
slug_of() {
  local k="$1" s
  s=$(awk -v k="$k" '!/^#/ && NF>=2 && $1==k {print $2; exit}' "$CATALOG" 2>/dev/null)
  [ -n "$s" ] && { printf '%s' "$s"; return 0; }
  case "$k" in */*) printf '%s' "$k"; return 0 ;; esac   # Pass through anything that looks like a slug.
  return 1
}
note_of() { awk -v k="$1" '!/^#/ && NF>=2 && $1==k {$1="";$2="";$3="";sub(/^ +/,"");print;exit}' "$CATALOG" 2>/dev/null; }
price_of() { awk -v k="$1" '!/^#/ && NF>=3 && $1==k {print $3; exit}' "$CATALOG" 2>/dev/null; }
key_of() { awk -v s="$1" '!/^#/ && NF>=2 && $2==s {print $1; exit}' "$CATALOG" 2>/dev/null; }

load_env() {
  # An already-exported OPENROUTER_API_KEY wins over keys.env — the standard
  # env-var override convention used by MCP servers and official plugins.
  local env_key="${OPENROUTER_API_KEY:-}"
  # shellcheck disable=SC1090
  [ -f "$KEYS" ] && { set -a; . "$KEYS"; set +a; }
  [ -n "$env_key" ] && OPENROUTER_API_KEY="$env_key"
  # shellcheck disable=SC1090
  . "$CONF"
  # shellcheck disable=SC1090
  [ -f "$TIERS" ] && . "$TIERS"
}

require_key() {
  if [ -z "${OPENROUTER_API_KEY:-}" ]; then
    printf '%sccd: OPENROUTER_API_KEY is empty.%s\n' "$red" "$r" >&2
    printf '  1) Create a key: %shttps://openrouter.ai/keys%s\n' "$cyn" "$r" >&2
    printf '  2) Save it:     %sccd key%s  (just paste it)\n' "$b" "$r" >&2
    printf '  %sSet this up while quota remains. Claude cannot help after it reaches zero.%s\n' "$d" "$r" >&2
    exit 1
  fi
}

# Read the key through a native macOS dialog when no terminal is available (such as Claude Code ! commands).
key_from_dialog() {
  osascript <<'OSA' 2>/dev/null
try
  set res to display dialog "OpenRouter API key\n\nPaste your key below. It is stored locally in ~/.claude/ccd/providers/keys.env (chmod 600) and never leaves this machine." with title "ccd" default answer "" with hidden answer buttons {"Cancel", "Save"} default button "Save"
  if button returned of res is "Save" then
    return text returned of res
  end if
end try
return ""
OSA
}

# Set the key without an editor. Input is never echoed on screen.
set_key() {
  local k=""
  if [ -t 0 ]; then
    # Real terminal: read hidden input in place.
    printf 'Paste the OpenRouter key and press Enter %s(input is hidden)%s\n' "$d" "$r"
    printf '  Create one: %shttps://openrouter.ai/keys%s\n> ' "$cyn" "$r"
    stty -echo 2>/dev/null; read -r k; stty echo 2>/dev/null; printf '\n'
  else
    # No stdin terminal: try piped input, then the controlling terminal
    # (covers Claude Code `!` commands and other embedded shells — works headless
    # on Linux), then the macOS dialog as a last resort.
    read -t 1 -r k 2>/dev/null || k=""
    if [ -z "$k" ] && (exec < /dev/tty) 2>/dev/null; then
      printf 'Paste the OpenRouter key and press Enter %s(input is hidden)%s\n> ' "$d" "$r" > /dev/tty
      stty -echo < /dev/tty 2>/dev/null
      IFS= read -r k < /dev/tty
      stty echo < /dev/tty 2>/dev/null
      printf '\n' > /dev/tty
    fi
    if [ -z "$k" ]; then
      command -v osascript >/dev/null 2>&1 \
        || die "No terminal available here. In Claude Code, type '! ccd key' (runs with your terminal, input hidden) — or run 'ccd key' in any terminal."
      printf '%sA dialog is open. Paste the key there.%s\n' "$d" "$r"
      k=$(key_from_dialog)
      [ -n "$k" ] || die "Canceled or empty input. Nothing changed."
    fi
  fi
  [ -n "$k" ] || die "Empty input. Nothing changed."
  case "$k" in
    sk-or-*) ;;
    *) printf '%sWarning: OpenRouter keys usually start with sk-or-. Saving anyway.%s\n' "$ylw" "$r" ;;
  esac
  # Replace the existing line or append it. Python safely handles slashes in the value.
  KEYVAL="$k" python3 - "$KEYS" <<'PY'
import os, re, sys
p = sys.argv[1]; v = os.environ["KEYVAL"]
s = open(p).read()
line = f'OPENROUTER_API_KEY="{v}"'
s2, n = re.subn(r'^OPENROUTER_API_KEY=.*$', line, s, count=1, flags=re.M)
open(p, 'w').write(s2 if n else s.rstrip("\n") + "\n" + line + "\n")
PY
  chmod 600 "$KEYS"
  local tail code result
  tail="${k: -4}"
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 -H "Authorization: Bearer $k" "https://openrouter.ai/api/v1/key" 2>/dev/null) || code="network"
  if [ "$code" = "200" ]; then
    result="✓ key saved & verified (sk-or-…$tail)"
    printf '%s%s%s\n' "$grn" "$result" "$r"
    [ -t 0 ] || osascript -e 'display notification "✓ OpenRouter key verified" with title "ccd"' >/dev/null 2>&1 || true
  else
    result="⚠ saved, but verification failed (HTTP $code) — run ccd doctor (sk-or-…$tail)"
    printf '%s%s%s\n' "$ylw" "$result" "$r"
    [ -t 0 ] || osascript -e 'display notification "⚠ OpenRouter key verification failed — run ccd doctor" with title "ccd"' >/dev/null 2>&1 || true
  fi
}

# Add the routing suffix to a slug unless one is already present.
with_routing() {
  case "$1" in *:*) printf '%s' "$1" ;; *) printf '%s:%s' "$1" "${CCD_ROUTING:-floor}" ;; esac
}

# Append Claude Code's local [1m] context hint whenever cached OpenRouter endpoint
# data proves every default-pool provider for this slug serves MORE than the 200K
# fallback window. Behind a gateway Claude Code budgets 200K unless the model ID
# carries this hint; it strips the suffix before the request reaches the provider,
# so the wire format stays "slug:floor". Unverified/stale/malformed cache -> no
# hint, which keeps the safe 200K budget instead of risking silent failures.
#
# [1m] only opens the 1M budget; the EFFECTIVE window is then set by
# CLAUDE_CODE_AUTO_COMPACT_WINDOW (capped by Claude Code at the model window), which
# apply_tiers derives from the smallest verified pool minimum — so a slug whose
# cheapest provider serves 912K is budgeted ~839K, not 200K and not a fake 1M.
with_context_hint() {
  local m="$1" min_ctx
  case "$m" in *'[1m]') printf '%s' "$m"; return 0 ;; esac   # idempotent
  min_ctx=$(python3 - "$PRICE_CACHE" "${m%%:*}" 2>/dev/null <<'PY'
import json, math, sys, time
CACHE_TTL, FUTURE_GRACE = 86400, 300   # shared cache-freshness policy
try:
    entry = json.load(open(sys.argv[1])).get("models", {}).get(sys.argv[2]) or {}
    v = entry.get("min_context_length")
    # bool is a subclass of int — exclude it explicitly
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        raise ValueError
    # Entries older than CACHE_TTL are unknown (the launch-time prefetch refreshes
    # them); future-dated entries beyond FUTURE_GRACE are poisoned or clock-skewed.
    age = time.time() - float(entry.get("fetched_at", 0))
    if not math.isfinite(age) or age > CACHE_TTL or age < -FUTURE_GRACE:
        raise ValueError
    print(int(v))
except Exception:
    pass
PY
)
  case "$min_ctx" in
    ''|*[!0-9]*) printf '%s' "$m" ;;
    *) [ "$min_ctx" -gt 200000 ] && printf '%s[1m]' "$m" || printf '%s' "$m" ;;
  esac
}

# Effective auto-compact window for the hinted slots: the smallest verified pool
# minimum, minus headroom for the response (MAX_OUTPUT_TOKENS=64000) and compaction
# slop. Callers pass only slugs that just passed with_context_hint, so cache
# freshness is prechecked here by construction.
compact_window_for() {  # $1..$N = base slugs that received [1m]
  python3 - "$PRICE_CACHE" "$@" 2>/dev/null <<'PY'
import json, sys
try:
    models = json.load(open(sys.argv[1])).get("models", {})
    mins = []
    for slug in sys.argv[2:]:
        v = (models.get(slug) or {}).get("min_context_length")
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            mins.append(int(v))
    if mins:
        m = min(mins)
        print(int(min(m * 0.92, m - 40000)))
except Exception:
    pass
PY
}

# Resolve all three model slots into environment variables after applying one-time overrides.
apply_tiers() {
  local hinted_slugs="" RESOLVED
  # RESOLVED is intentionally written in the caller's scope (bash dynamic scoping):
  # command substitution would lose the hinted_slugs append.
  resolve_slot() { # $1 = raw slot value; $2 = hint|nohint; RESOLVED = routed (+ hinted) value
    local v b
    v=$(with_routing "$1")
    [ "$2" = "hint" ] && v=$(with_context_hint "$v")
    case "$v" in
      *'[1m]') b="${v%\[1m\]}"; hinted_slugs="$hinted_slugs ${b%%:*}" ;;
    esac
    RESOLVED="$v"
  }
  # Only the conversation-driving slots (sonnet/opus) get [1m]. Claude Code has ONE
  # global auto-compact window per process, sized below from the hinted slots'
  # smallest verified pool — hinting a small chore model (flash pool min 262K)
  # would crush that window to ~222K for EVERY model, kimi included. Unhinted, the
  # haiku slot keeps the safe 200K budget, always below its real ceiling.
  resolve_slot "$ANTHROPIC_DEFAULT_HAIKU_MODEL"  nohint; ANTHROPIC_DEFAULT_HAIKU_MODEL="$RESOLVED"
  resolve_slot "$ANTHROPIC_DEFAULT_SONNET_MODEL" hint;   ANTHROPIC_DEFAULT_SONNET_MODEL="$RESOLVED"
  resolve_slot "$ANTHROPIC_DEFAULT_OPUS_MODEL"   hint;   ANTHROPIC_DEFAULT_OPUS_MODEL="$RESOLVED"
  ANTHROPIC_DEFAULT_FABLE_MODEL="$ANTHROPIC_DEFAULT_OPUS_MODEL"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
         ANTHROPIC_DEFAULT_OPUS_MODEL  ANTHROPIC_DEFAULT_FABLE_MODEL
  export ANTHROPIC_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"
  export CLAUDE_CODE_SUBAGENT_MODEL="$ANTHROPIC_DEFAULT_SONNET_MODEL"

  # Fourth slot: always show the cheapest model at the bottom of the picker.
  resolve_slot "$(slug_of flash)" nohint
  export ANTHROPIC_CUSTOM_MODEL_OPTION="$RESOLVED"
  export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="cheapest (${CCD_ROUTING:-floor})"

  # One global window per process: the smallest hinted ceiling (policy: see
  # with_context_hint). Unhinted slots keep their own 200K boundary.
  if [ -n "$hinted_slugs" ]; then
    local cw
    cw=$(compact_window_for $hinted_slugs)
    [ -n "$cw" ] && export CLAUDE_CODE_AUTO_COMPACT_WINDOW="$cw"
  fi
}

show_models() {
  load_env
  printf '%sModel catalog%s  %s(price = input/output $ per 1M tokens)%s\n\n' "$b" "$r" "$d" "$r"
  awk '!/^#/ && NF>=4 {printf "  %-9s %-38s %-14s %s\n", $1, $2, $3, substr($0, index($0,$4))}' "$CATALOG"
  printf '\n%sTo switch during a session, enter the slug directly:%s  %s/model moonshotai/kimi-k3:%s%s\n' \
    "$d" "$r" "$b" "${CCD_ROUTING:-floor}" "$r"
  printf '%sTo persistently change the three slots:%s  %sccd pick%s\n' "$d" "$r" "$b" "$r"
}

tier_row() { # $1=alias $2=slug $3=purpose
  local k p; k=$(key_of "$2"); p=$(price_of "${k:-}")
  printf '  %s%-7s%s → %-36s %s%-13s %s%s\n' "$b" "$1" "$r" "$2" "$d" "${p:-?}" "$3" "$r"
}

status() {
  load_env
  printf '%sccd — Claude Code backbone switcher%s\n\n' "$b" "$r"

  printf '%sCurrent shell%s\n' "$b" "$r"
  if [ -n "${CCD_ACTIVE:-}" ]; then
    printf '  %sExternal backbone active%s\n' "$ylw" "$r"
  else
    printf '  %sAnthropic subscription%s — using claude.ai login\n' "$grn" "$r"
  fi
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    printf '  OpenRouter key: %sconfigured%s\n' "$grn" "$r"
  else
    printf '  OpenRouter key: %sempty%s → set it now with %sccd key%s\n' "$red" "$r" "$b" "$r"
  fi
  case "${CCD_ROUTING:-floor}" in
    floor)  printf '  Routing: %s:floor%s — lowest-cost provider for the model (minimum cost)\n' "$cyn" "$r" ;;
    exacto) printf '  Routing: %s:exacto%s — provider with reliable tool calls (higher cost)\n' "$cyn" "$r" ;;
    *)      printf '  Routing: %s:%s%s\n' "$cyn" "$CCD_ROUTING" "$r" ;;
  esac
  [ -f "$TIERS" ] && printf '  Assignment: %scustom (ccd pick)%s\n' "$cyn" "$r"

  printf '\n%sModels assigned to the three slots%s %s(switch instantly with /model)%s\n' "$b" "$r" "$d" "$r"
  tier_row "haiku"  "$ANTHROPIC_DEFAULT_HAIKU_MODEL"  "cheap chores · exploration"
  tier_row "sonnet" "$ANTHROPIC_DEFAULT_SONNET_MODEL" "default · everyday coding"
  tier_row "opus"   "$ANTHROPIC_DEFAULT_OPUS_MODEL"   "hard decisions · debugging"

  printf '\n%sWhen quota runs out — these two commands%s\n' "$b" "$r"
  printf '  %s1. /exit%s        End the current session %s(required)%s\n' "$b" "$r" "$d" "$r"
  printf '  %s2. ccd -c%s       In the same terminal; restores the conversation\n' "$b" "$r"
  printf '\n%sOther commands%s\n' "$b" "$r"
  printf '  %sccd pick%s        Change the three model slots\n' "$b" "$r"
  printf '  %sccd models%s      Full catalog and prices\n' "$b" "$r"
  printf '  %sccd doctor%s      Diagnose problems first\n' "$b" "$r"
  printf '\n  %sDetailed procedure: ~/.claude/ccd/QUOTA-SOS.md%s\n' "$d" "$r"
}

pick() {
  load_env
  [ -f "$CATALOG" ] || die "Catalog not found: $CATALOG"
  local keys=() i=1 k
  while read -r k; do keys+=("$k"); done < <(awk '!/^#/ && NF>=4 {print $1}' "$CATALOG")

  printf '%sAssign models to three slots%s  %s(Enter = keep current)%s\n\n' "$b" "$r" "$d" "$r"
  i=1
  for k in "${keys[@]}"; do
    printf '  %s%2d%s) %-9s %-36s %s%s  %s%s\n' "$b" "$i" "$r" "$k" \
      "$(slug_of "$k")" "$d" "$(price_of "$k")" "$(note_of "$k")" "$r"
    i=$((i+1))
  done
  printf '\n'

  local out="" tier cur ans idx sel
  for tier in HAIKU SONNET OPUS; do
    case "$tier" in
      HAIKU)  cur="$ANTHROPIC_DEFAULT_HAIKU_MODEL";  hint="cheap chores · exploration" ;;
      SONNET) cur="$ANTHROPIC_DEFAULT_SONNET_MODEL"; hint="default · everyday coding" ;;
      OPUS)   cur="$ANTHROPIC_DEFAULT_OPUS_MODEL";   hint="hard decisions · debugging" ;;
    esac
    printf '%s%s%s (%s)\n  Current: %s\n  Enter a number or key> ' "$b" "$tier" "$r" "$hint" "$cur"
    read -r ans || ans=""
    sel="$cur"
    if [ -n "$ans" ]; then
      if [ "$ans" -eq "$ans" ] 2>/dev/null; then
        idx=$((ans-1))
        [ "$idx" -ge 0 ] && [ "$idx" -lt "${#keys[@]}" ] && sel=$(slug_of "${keys[$idx]}") \
          || { printf '%s  Number out of range. Keeping current value.%s\n' "$ylw" "$r"; }
      else
        sel=$(slug_of "$ans") || { printf '%s  Unknown key. Keeping current value.%s\n' "$ylw" "$r"; sel="$cur"; }
      fi
    fi
    out+="export ANTHROPIC_DEFAULT_${tier}_MODEL=\"$sel\"\n"
    printf '  %s→ %s%s\n\n' "$grn" "$sel" "$r"
  done

  { printf '# Generated by ccd pick. Delete this file to restore openrouter.env defaults.\n'; printf "%b" "$out"; } > "$TIERS"
  printf '%sSaved: %s%s\n' "$grn" "$TIERS" "$r"
  printf '%sTakes effect on the next ccd run.%s\n' "$d" "$r"
}

doctor() {
  load_env; require_key; apply_tiers
  local model="$ANTHROPIC_MODEL"
  [ $# -ge 1 ] && { model=$(slug_of "$1") || die "Unknown model key: $1"; model=$(with_routing "$model"); }
  # The [1m] hint is Claude Code-local — never send it to the provider.
  model="${model%\[1m\]}"
  printf '%s→ Validating %s / %s...%s\n' "$d" "$ANTHROPIC_BASE_URL" "$model" "$r"
  local code
  code=$(curl -sS -o /tmp/ccd-doctor.json -w '%{http_code}' \
    -X POST "$ANTHROPIC_BASE_URL/v1/messages" \
    -H "Authorization: Bearer $ANTHROPIC_AUTH_TOKEN" \
    -H "anthropic-version: 2023-06-01" -H "content-type: application/json" \
    -d "{\"model\":\"$model\",\"max_tokens\":8,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" \
    --max-time 45) || die "Network failure — cannot reach $ANTHROPIC_BASE_URL"

  case "$code" in
    200) printf '%s✓ OK%s — ready to switch with `ccd -c`.\n' "$grn" "$r" ;;
    401|403) printf '%s✗ %s authentication rejected%s — the OpenRouter key is invalid or expired.\n' "$red" "$code" "$r" ;;
    402) printf '%s✗ 402%s — insufficient OpenRouter balance. Add credits.\n' "$red" "$r" ;;
    400|404) printf '%s△ %s%s — authentication passed; the model slug is probably invalid.\n' "$ylw" "$code" "$r"
             printf '  Response: %s\n' "$(head -c 300 /tmp/ccd-doctor.json)"
             printf '  %sCheck the slug at openrouter.ai/models and update %s.%s\n' "$d" "$CATALOG" "$r" ;;
    *)   printf '%s✗ HTTP %s%s\n  Response: %s\n' "$red" "$code" "$r" "$(head -c 300 /tmp/ccd-doctor.json)" ;;
  esac

  # Context budget per slot: refresh each slug's provider data, then report what
  # apply_tiers will do. Rows show each model's own ceiling; the footer shows the
  # one process-wide window Claude Code actually uses (smallest hinted ceiling).
  printf '\n%sContext budget per slot%s %s([1m] on sonnet/opus; auto-compact = smallest verified pool − headroom)%s\n' "$b" "$d" "$r"
  local slot sm base refreshed ceiling cw hinted_bases=""
  for slot in HAIKU SONNET OPUS; do
    case "$slot" in
      HAIKU)  sm="$ANTHROPIC_DEFAULT_HAIKU_MODEL" ;;
      SONNET) sm="$ANTHROPIC_DEFAULT_SONNET_MODEL" ;;
      OPUS)   sm="$ANTHROPIC_DEFAULT_OPUS_MODEL" ;;
    esac
    base="${sm%\[1m\]}"; base="${base%%:*}"
    [ -x "$SELF_DIR/ccd-price-fetch" ] && "$SELF_DIR/ccd-price-fetch" "$base" >/dev/null 2>&1
    # Recompute the hint from the JUST-refreshed cache — the value wired at apply_tiers
    # time is stale by one refresh, and the row must show what the next launch will do.
    case "$slot" in
      HAIKU)  refreshed="${sm%\[1m\]}" ;;                    # chore slot: never hinted
      *)      refreshed=$(with_context_hint "${sm%\[1m\]}") ;;
    esac
    ceiling=""
    case "$refreshed" in
      *'[1m]') hinted_bases="$hinted_bases $base"; ceiling=$(compact_window_for "$base") ;;
    esac
    python3 - "$PRICE_CACHE" "$base" "$slot" "$refreshed" "$ceiling" <<'PY'
import json, math, sys, time
CACHE_TTL, FUTURE_GRACE = 86400, 300   # shared cache-freshness policy
cache, base, slot, wired, ceiling = sys.argv[1:6]
try:
    entry = json.load(open(cache)).get("models", {}).get(base) or {}
except Exception:
    entry = {}
lo, hi = entry.get("min_context_length"), entry.get("max_context_length")
def num(v): return isinstance(v, (int, float)) and not isinstance(v, bool)
fresh = False
try:
    age = time.time() - float(entry.get("fetched_at", 0))
    fresh = math.isfinite(age) and age <= CACHE_TTL and age >= -FUTURE_GRACE
except Exception:
    fresh = False
hint = "applied" if wired.endswith("[1m]") else "not applied"
ctx = ""
if num(lo) and fresh:
    ctx = f"providers {int(lo):,}–{int(hi):,} ctx" if num(hi) and hi != lo else f"providers {int(lo):,} ctx"
if wired.endswith("[1m]") and ceiling:
    print(f"  {slot:<6} → {base:<34} {ctx} → ceiling ~{int(ceiling):,} ([1m] {hint})")
else:
    if not ctx:
        why = "ctx unknown, stays"
    elif num(lo) and lo > 200000:
        why = f"{ctx}, but slot stays"                     # chore slot: deliberate
    else:
        why = f"pool min {int(lo):,} ≤ 200K, stays"
    print(f"  {slot:<6} → {base:<34} {why} → 200K budget ([1m] {hint})")
PY
  done
  if [ -n "$hinted_bases" ]; then
    cw=$(compact_window_for $hinted_bases)
    [ -n "$cw" ] && printf '  %ssession auto-compact window: %s (smallest hinted ceiling)%s\n' "$d" "$cw" "$r"
  fi
}

# Read cumulative usage for the current OpenRouter key. Return empty on error so ccd can still start.
openrouter_usage() {
  curl -fsS --max-time 5 \
    -H "Authorization: Bearer $ANTHROPIC_AUTH_TOKEN" \
    "$ANTHROPIC_BASE_URL/v1/key" 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin).get("data", {})
    value = data.get("usage")
    print(float(value)) if isinstance(value, (int, float)) else None
except Exception:
    pass
' 2>/dev/null
}

# Record the cost baseline and weekly quota state when ccd starts.
# The key is used only in the header and is never stored in this file.
#
# Fetching the usage baseline can delay claude on a slow network, so do it in the
# background: first write null to the state file and start claude immediately, then
# fill the baseline after a successful fetch. Until then, the statusline shows
# "spend n/a" and becomes accurate on the first hook update.
fill_baseline_async() {
  (
    u=$(openrouter_usage)
    [ -n "$u" ] || exit 0
    CCD_U="$u" python3 - "$RUN_STATE" "$OUTAGE_STATE" <<'PY' 2>/dev/null
import json, os, sys, tempfile

def write_atomic(p, obj):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".ccd-state.")
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, p)
    os.chmod(p, 0o600)

usage = float(os.environ["CCD_U"])
run_path, outage_path = sys.argv[1], sys.argv[2]

try:
    state = json.load(open(run_path))
except Exception:
    raise SystemExit(0)
# Do not overwrite state if the hook has already started calculating costs.
if state.get("baseline_usage_usd") is None and state.get("ccd_spend_usd") is None:
    state["baseline_usage_usd"] = usage
    write_atomic(run_path, state)

# Outage baseline: preserved across ccd restarts.
# Create it only when missing (the first ccd run in this quota outage).
# quota-guard clears it when it detects a Claude quota reset (100 -> 0).
if not os.path.exists(outage_path):
    write_atomic(outage_path, {
        "started_at": state.get("started_at"),
        "baseline_usage_usd": usage,
        "outage_spend_usd": 0.0,
    })
PY
  ) >/dev/null 2>&1 &
}

init_run_state() {
  local usage="" started five five_reset seven seven_reset
  started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  read -r five five_reset seven seven_reset < <(python3 - "$QUOTA_CACHE" 2>/dev/null <<'PY'
import json, sys
try:
    c = json.load(open(sys.argv[1])).get("claude") or {}
    v = lambda key: "" if not isinstance(c.get(key), (int, float)) else int(c[key])
    print(v("fiveHourPercent"), c.get("fiveHourReset") or "", v("sevenDayPercent"), c.get("sevenDayReset") or "")
except Exception:
    print("   ")
PY
)
  RUN_STARTED="$started" RUN_USAGE="$usage" RUN_FIVE="$five" RUN_FIVE_RESET="$five_reset" RUN_SEVEN="$seven" RUN_SEVEN_RESET="$seven_reset" \
    python3 - "$RUN_STATE" <<'PY'
import json, os, sys, tempfile
p = sys.argv[1]
def number(name):
    try: return float(os.environ[name])
    except (KeyError, ValueError): return None
state = {
    "started_at": os.environ["RUN_STARTED"],
    "baseline_usage_usd": number("RUN_USAGE"),
    "ccd_spend_usd": None,
    "cost_updated_at": None,
    "initial_five_hour_percent": number("RUN_FIVE"),
    "last_five_hour_percent": number("RUN_FIVE"),
    "initial_five_hour_reset": os.environ.get("RUN_FIVE_RESET") or None,
    "last_five_hour_reset": os.environ.get("RUN_FIVE_RESET") or None,
    "initial_seven_day_percent": number("RUN_SEVEN"),
    "last_seven_day_percent": number("RUN_SEVEN"),
    "initial_seven_day_reset": os.environ.get("RUN_SEVEN_RESET") or None,
    "last_seven_day_reset": os.environ.get("RUN_SEVEN_RESET") or None,
    "recovery_notified_window": None,
    "recovery_notified_reset": None,
}
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".run-state.")
with os.fdopen(fd, "w") as f:
    json.dump(state, f, ensure_ascii=False)
    f.write("\n")
os.replace(tmp, p)
os.chmod(p, 0o600)
PY
}

# ── Entry point ───────────────────────────────────────────────────────────
setup() {
  local launcher="$HOME/.local/bin/ccd" statusline_launcher="$CCD_DIR/statusline-launcher.sh"
  local settings="$HOME/.claude/settings.json"
  mkdir -p "$HOME/.local/bin" "$CCD_DIR" "$HOME/.claude"
  [ -L "$launcher" ] && rm "$launcher"
  cat > "$launcher" <<'CCD_LAUNCHER'
#!/usr/bin/env bash
# ccd launcher — resolves the newest installed ccd plugin. Regenerated by `ccd setup`.
t=$(ls -d "$HOME/.claude/plugins/cache"/*/ccd/*/bin/ccd 2>/dev/null | sort -V | tail -1)
[ -n "$t" ] || { echo "ccd: plugin not found — reinstall the ccd plugin" >&2; exit 1; }
exec "$t" "$@"
CCD_LAUNCHER
  chmod +x "$launcher"
  cat > "$statusline_launcher" <<'CCD_STATUSLINE_LAUNCHER'
#!/usr/bin/env bash
# ccd statusline launcher — resolves the newest installed ccd plugin. Regenerated by `ccd setup`.
t=$(ls -d "$HOME/.claude/plugins/cache"/*/ccd/*/bin/ccd-statusline 2>/dev/null | sort -V | tail -1)
[ -n "$t" ] || exit 0
exec "$t"
CCD_STATUSLINE_LAUNCHER
  chmod +x "$statusline_launcher"

  python3 - "$settings" <<'PY'
import json, os, sys, tempfile
p = sys.argv[1]
if os.path.exists(p):
    with open(p, encoding="utf-8") as f: data = json.load(f)
else: data = {}
hooks = data.get("hooks")
if isinstance(hooks, dict):
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list): continue
        kept_groups = []
        for group in groups:
            if not isinstance(group, dict):
                kept_groups.append(group); continue
            entries = group.get("hooks")
            if isinstance(entries, list):
                entries = [entry for entry in entries if not (
                    isinstance(entry, dict) and isinstance(entry.get("command"), str)
                    and "quota-guard.sh" in entry["command"])]
                if entries:
                    group["hooks"] = entries; kept_groups.append(group)
            else: kept_groups.append(group)
        if kept_groups: hooks[event] = kept_groups
        else: del hooks[event]
    if not hooks: del data["hooks"]
data["statusLine"] = {"type": "command", "command": "bash ~/.claude/ccd/statusline-launcher.sh"}
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".settings.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2); f.write("\n")
    os.replace(tmp, p)
finally:
    if os.path.exists(tmp): os.unlink(tmp)
PY

  printf '✓ ccd command installed (~/.local/bin/ccd)\n'
  printf '✓ statusline wired — dashboard output preserved\n'
  printf '→ Restart Claude Code to activate hooks + statusline\n'
  case ":$PATH:" in *:"$HOME/.local/bin":*) ;; *) printf '→ Add to PATH: export PATH="$HOME/.local/bin:$PATH"\n' ;; esac
  if python3 - "$KEYS" <<'PY' >/dev/null 2>&1
import re, sys
try: text = open(sys.argv[1], encoding="utf-8").read()
except OSError: raise SystemExit(1)
m = re.search(r'^\s*(?:export\s+)?OPENROUTER_API_KEY\s*=\s*(.*?)\s*$', text, re.M)
if not m: raise SystemExit(1)
value = m.group(1)
if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'": value = value[1:-1]
raise SystemExit(0 if value else 1)
PY
  then printf '→ Verify anytime: ccd doctor\n'; else printf '→ Before quota runs out: set your OpenRouter key with `ccd key`\n'; fi
}

uninstall() {
  local purge=0 launcher="$HOME/.local/bin/ccd"
  local statusline_launcher="$CCD_DIR/statusline-launcher.sh"
  local settings="$HOME/.claude/settings.json" statusline_result dashboard=""
  [ "$#" -le 1 ] || die "Usage: ccd uninstall [--purge]"
  case "${1:-}" in
    "") ;;
    --purge) purge=1 ;;
    *) die "Usage: ccd uninstall [--purge]" ;;
  esac

  dashboard=$(ls -d "$HOME/.claude/plugins/cache/claude-dashboard/claude-dashboard"/*/dist/index.js 2>/dev/null | sort -V | tail -1)
  statusline_result=$(python3 - "$settings" "$dashboard" <<'PY'
import json, os, sys, tempfile
p, dashboard = sys.argv[1:]
if not os.path.exists(p):
    print("removed")
    raise SystemExit(0)
with open(p, encoding="utf-8") as f:
    data = json.load(f)
status = data.get("statusLine")
command = status.get("command") if isinstance(status, dict) else None
changed = isinstance(command, str) and "statusline-launcher.sh" in command
result = "unchanged"
if changed:
    if dashboard:
        data["statusLine"] = {"type": "command", "command": "node " + dashboard}
        result = "dashboard"
    else:
        del data["statusLine"]
        result = "removed"
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=".settings.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, p)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
elif status is None:
    result = "removed"
elif isinstance(command, str) and command.startswith("node ") and "/claude-dashboard/" in command:
    result = "dashboard"
print(result)
PY
  )

  case "$statusline_result" in
    dashboard) printf '✓ statusline restored (claude-dashboard)\n' ;;
    removed) printf '✓ statusline entry removed\n' ;;
    *) printf '✓ statusline left unchanged\n' ;;
  esac

  if [ -f "$launcher" ] && grep -q 'ccd launcher' "$launcher"; then
    rm "$launcher"
  elif [ -e "$launcher" ] || [ -L "$launcher" ]; then
    printf '⚠ ccd command not removed — ~/.local/bin/ccd is not a ccd launcher\n'
  fi
  [ -e "$statusline_launcher" ] || [ -L "$statusline_launcher" ] && rm "$statusline_launcher"
  printf '✓ launchers removed\n'

  if [ "$purge" -eq 1 ]; then
    rm -rf "$CCD_DIR"
    printf '✓ key, config, and state purged (~/.claude/ccd/)\n'
  else
    printf '✓ key & state kept (~/.claude/ccd/) — remove everything with: ccd uninstall --purge\n'
  fi
  printf '→ Finish in a terminal: claude plugin uninstall ccd@cc-donut && claude plugin marketplace remove cc-donut\n'
  printf '→ Then restart Claude Code\n'
}

case "${1:-}" in
  ""|status|help|-h|--help) status; exit 0 ;;
  setup)  setup; exit 0 ;;
  uninstall) shift; uninstall "$@"; exit 0 ;;
  key)    set_key; exit 0 ;;
  models) [ -f "$CATALOG" ] || die "Catalog not found: $CATALOG"; show_models; exit 0 ;;
  pick)   pick; exit 0 ;;
  doctor) shift; doctor "$@"; exit 0 ;;
  off)    shift
          unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL \
                ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL \
                ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL \
                ANTHROPIC_CUSTOM_MODEL_OPTION ANTHROPIC_CUSTOM_MODEL_OPTION_NAME \
                CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS \
                CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_MAX_OUTPUT_TOKENS 2>/dev/null
          printf '%s▶ Running with Anthropic subscription%s\n' "$grn" "$r"
          exec claude "$@" ;;
  go)     shift ;;
esac

load_env; require_key

# One-time override: --haiku/--sonnet/--opus <key|slug>
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --haiku|--sonnet|--opus)
      [ $# -ge 2 ] || die "$1 requires a model key (see ccd models)"
      s=$(slug_of "$2") || die "Unknown model key: $2"
      case "$1" in
        --haiku)  ANTHROPIC_DEFAULT_HAIKU_MODEL="$s" ;;
        --sonnet) ANTHROPIC_DEFAULT_SONNET_MODEL="$s" ;;
        --opus)   ANTHROPIC_DEFAULT_OPUS_MODEL="$s" ;;
      esac
      shift 2 ;;
    --routing)
      [ $# -ge 2 ] || die "--routing requires floor or exacto"
      CCD_ROUTING="$2"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done

# apply_tiers budgets from the cached provider data. On a cache miss/stale entry the
# slot would launch at 200K even when the model serves far more — the exact failure
# ccd exists to prevent — so refresh the three slots synchronously (bounded by
# ccd-price-fetch's --max-time) BEFORE applying. ccd only works when OpenRouter is
# reachable anyway; a failed fetch just keeps the safe 200K default for this run.
if [ -x "$SELF_DIR/ccd-price-fetch" ]; then
  stale_slugs=$(python3 - "$PRICE_CACHE" \
      "${ANTHROPIC_DEFAULT_HAIKU_MODEL%%:*}" \
      "${ANTHROPIC_DEFAULT_SONNET_MODEL%%:*}" \
      "${ANTHROPIC_DEFAULT_OPUS_MODEL%%:*}" 2>/dev/null <<'PY'
import json, math, sys, time
CACHE_TTL, FUTURE_GRACE = 86400, 300   # shared cache-freshness policy
try:
    models = json.load(open(sys.argv[1])).get("models", {})
except Exception:
    models = {}
now = time.time()
for slug in dict.fromkeys(sys.argv[2:]):
    entry = models.get(slug) or {}
    try:
        age = now - float(entry.get("fetched_at", 0))
    except Exception:
        age = 1e9
    if not math.isfinite(age) or age > CACHE_TTL or age < -FUTURE_GRACE:
        print(slug)
PY
)
  if [ -n "$stale_slugs" ]; then
    for s in $stale_slugs; do "$SELF_DIR/ccd-price-fetch" "$s" >/dev/null 2>&1 & done
    wait
  fi
fi

apply_tiers
export CCD_ACTIVE=1

# Without an interactive screen (Claude Code ! command, script, or pipe), claude
# falls into headless mode and reports a misleading "provide a prompt" error.
# Allow it only when headless mode was explicitly requested with -p/--print.
headless=0
for a in ${args+"${args[@]}"}; do
  case "$a" in -p|--print) headless=1 ;; esac
done
if [ "$headless" -eq 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  printf '\n%s✋ Exit Claude Code first.%s\n\n' "$red" "$r" >&2
  printf '  %s1.%s  %s/exit%s      %s← end the current session%s\n' "$b" "$r" "$b" "$r" "$d" "$r" >&2
  printf '  %s2.%s  %sccd -c%s     %s← in the same terminal; restores that conversation%s\n\n' \
    "$b" "$r" "$b" "$r" "$d" "$r" >&2
  printf '  %sReason: the backbone is chosen when claude starts and cannot change inside a running session.%s\n' "$d" "$r" >&2
  printf '  %sThe "last conversation" requested by -c is this active session, which creates a conflict.%s\n\n' "$d" "$r" >&2
  exit 1
fi

printf '%s▶ Switching backbone: OpenRouter%s\n' "$ylw" "$r"
printf '   haiku %s / sonnet %s / opus %s\n' \
  "$ANTHROPIC_DEFAULT_HAIKU_MODEL" "$ANTHROPIC_DEFAULT_SONNET_MODEL" "$ANTHROPIC_DEFAULT_OPUS_MODEL"
printf '%s   Switch instantly with /model haiku|sonnet|opus or /model <slug>.%s\n' "$d" "$r"
printf '%s   Statusline adds: model·effort │ price per 1M │ run cost. Updates on prompts/tools.%s\n' "$d" "$r"
printf '%s   To return to the subscription, /exit then run claude in the same terminal. Never /logout.%s\n' "$d" "$r"

init_run_state
fill_baseline_async
# Pre-cache prices for all three models so the first statusline does not show "pricing…".
# Ignore failures; the statusline retries on its next refresh.
if [ -x "$SELF_DIR/ccd-price-fetch" ]; then
  for m in "$ANTHROPIC_DEFAULT_HAIKU_MODEL" "$ANTHROPIC_DEFAULT_SONNET_MODEL" "$ANTHROPIC_DEFAULT_OPUS_MODEL"; do
    ("$SELF_DIR/ccd-price-fetch" "${m%%:*}" >/dev/null 2>&1 &)
  done
fi
exec claude ${args+"${args[@]}"}
