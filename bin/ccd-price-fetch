#!/usr/bin/env bash
# Fetch OpenRouter model pricing and cache it in ~/.claude/ccd/price-cache.json.
# The statusline calls this in the background; only this script uses the network.
#
# This public API needs no key. :floor selects the cheapest standard provider.
# :free selects free-tier providers (is_free: true); price is 0.
set -euo pipefail

raw_slug="${1:?usage: ccd-price-fetch <author/model-slug>}"
# Tolerate compound values: strip a terminal [1m] hint.
raw_slug="${raw_slug%\[1m\]}"

# Extract known routing suffix. Only these are recognized.
# Unknown suffixes are treated as part of the model identifier.
known_routings="free floor nitro exacto"
routing=""
slug="$raw_slug"

for r in $known_routings; do
  if [[ "$slug" == *":$r" ]]; then
    routing=":$r"
    slug="${slug%:$r}"
    break
  fi
done

CACHE_DIR="$HOME/.claude/ccd"
CACHE="$CACHE_DIR/price-cache.json"
mkdir -p "$CACHE_DIR"

# Cache key includes routing so different routings for same model are cached separately.
cache_key="${slug}${routing}"

# -g disables URL globbing (defensive — a terminal [1m] was already stripped above).
body=$(curl -gfsS --max-time 8 "https://openrouter.ai/api/v1/models/${slug}/endpoints" 2>/dev/null) || exit 1

CCD_PRICE_BODY="$body" CCD_ROUTING="$routing" python3 - "$CACHE" "$cache_key" "$slug" "$routing" <<'PY'
import fcntl, json, os, sys, time

cache_path, cache_key, slug, routing = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    data = json.loads(os.environ["CCD_PRICE_BODY"]).get("data") or {}
except Exception:
    sys.exit(1)

prompts, completions, contexts = [], [], []
context_unknown = False
free_endpoint_found = False

for ep in data.get("endpoints") or []:
    tag = ep.get("tag") or ""
    is_free = ep.get("is_free") is True
    # Exclude service-tier variants (flex/priority etc.) from default pools.
    if "/" in tag:
        continue

    # Routing-specific filtering
    if routing == ":free":
        # Free tier: only endpoints with is_free: true (tag "free" as fallback)
        if not (is_free or tag.lower() == "free"):
            continue
        free_endpoint_found = True
    elif routing == ":floor":
        # Floor: cheapest among standard (non-free) endpoints
        if is_free or tag.lower() == "free":
            continue
    elif routing in (":nitro", ":exacto"):
        # Nitro/exacto: not filtering by tag; show standard provider range
        # (actual routing order is dynamic and not cacheable here)
        if is_free or tag.lower() == "free":
            continue
    # Bare slug (no routing): standard pool, no free endpoints
    elif not routing:
        if is_free or tag.lower() == "free":
            continue

    # Context eligibility
    cl = ep.get("context_length")
    if isinstance(cl, (int, float)) and not isinstance(cl, bool) and cl > 0:
        contexts.append(int(cl))
    else:
        context_unknown = True

    p = ep.get("pricing") or {}
    try:
        prompts.append(float(p["prompt"]))
        completions.append(float(p["completion"]))
    except (KeyError, TypeError, ValueError):
        continue

# For :free routing, require at least one free endpoint found.
if routing == ":free":
    if not free_endpoint_found:
        # No free tier available for this model — negative cache
        entry = {
            "available": False,
            "fetched_at": int(time.time()),
        }
    else:
        entry = {
            "floor_in_per_m": 0.0,
            "floor_out_per_m": 0.0,
            "max_in_per_m": 0.0,
            "max_out_per_m": 0.0,
            "fetched_at": int(time.time()),
        }
else:
    if not prompts or not completions:
        sys.exit(1)
    entry = {
        "floor_in_per_m": min(prompts) * 1_000_000,
        "floor_out_per_m": min(completions) * 1_000_000,
        "max_in_per_m": max(prompts) * 1_000_000,
        "max_out_per_m": max(completions) * 1_000_000,
        "fetched_at": int(time.time()),
    }

# Verified only if all eligible endpoints reported context length.
verified = bool(contexts) and not context_unknown
entry["min_context_length"] = min(contexts) if verified else None
entry["max_context_length"] = max(contexts) if verified else None

# Atomic write with lock
lock = open(cache_path + ".lock", "a")
fcntl.flock(lock, fcntl.LOCK_EX)
try:
    try:
        cache = json.load(open(cache_path))
    except Exception:
        cache = {}
    cache.setdefault("models", {})[cache_key] = entry
    tmp = f"{cache_path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(cache, f)
    os.replace(tmp, cache_path)
finally:
    fcntl.flock(lock, fcntl.LOCK_UN)
    lock.close()
PY