#!/usr/bin/env bash
# Thin wrapper around the claude-dashboard statusline. It invokes the dashboard as a child
# process and appends only the required data. It also works without the dashboard plugin.
#
# When quota reaches zero Claude cannot respond, so hooks cannot give instructions.
# The statusline is the only place rendered independently of Claude.
#
# While ccd is active, render one dedicated row below the dashboard.
# ccd-price-fetch fills the cache in the background; rendering never waits for the network.
#
# Preserve upstream output on any failure; the statusline must never break.
set -uo pipefail

CCD_DIR="$HOME/.claude/ccd"
CACHE="$CCD_DIR/quota-cache.json"
RUN_STATE="$CCD_DIR/run-state.json"
OUTAGE_STATE="$CCD_DIR/outage-state.json"
PRICE_CACHE="$CCD_DIR/price-cache.json"
mkdir -p "$CCD_DIR"
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PRICE_FETCH="$SELF_DIR/ccd-price-fetch"
# The statusline warning means "switch now." Use 95%; the hook's 85% delegation threshold differs.
THRESHOLD=95

payload=$(cat)

# Locate the newest claude-dashboard build dynamically (survives plugin updates)
orig=$(ls -d "$HOME/.claude"/plugins/cache/claude-dashboard/claude-dashboard/*/dist/index.js 2>/dev/null | sort -V | tail -1)
# The dashboard is usually instant, but it refreshes its usage reading on its own
# schedule, and when it does the call takes seconds. Waiting for it blanks the
# WHOLE statusline — ours and its rows both — which reads as the statusline being
# broken rather than a number being a few seconds old. So serve the last rows we
# saw and refresh behind them: slightly stale beats absent.
DASH_CACHE="$CCD_DIR/.dashboard-row"
DASH_LOCK="$CCD_DIR/.dashboard-row.lock"
# Tunable only so the test suite can reach both sides of each bound in seconds
# rather than minutes; nothing in normal use sets them.
DASH_MAX_STALE=${CCD_DASH_MAX_STALE:-300}   # older than this, pay for a fresh read
DASH_TIMEOUT=${CCD_DASH_TIMEOUT:-10}        # a hung child must not outlive its row

# Seconds since a file was written, or a large number when it is absent. python3
# rather than stat(1): the -f/-c split between BSD and GNU has bitten this repo
# before, and python3 is already a hard dependency here.
dash_age() {
  python3 -c 'import os,sys,time
try: print(int(time.time() - os.path.getmtime(sys.argv[1])))
except OSError: print(999999)' "$1" 2>/dev/null || echo 999999
}

# Run the dashboard under a watchdog, leaving its rows in the cache on success
# and nothing behind on failure or timeout. Both paths use it: a hung child must
# never hold the statusline hostage, cold cache or not.
dash_fetch() {
  local tmp node_pid watchdog rc
  tmp=$(mktemp "$DASH_CACHE.XXXXXX" 2>/dev/null) || return 1
  printf '%s' "$payload" | node "$orig" > "$tmp" 2>/dev/null &
  node_pid=$!
  ( sleep "$DASH_TIMEOUT"; kill -9 "$node_pid" 2>/dev/null ) 2>/dev/null &
  watchdog=$!
  wait "$node_pid"; rc=$?
  kill "$watchdog" 2>/dev/null
  if [ "$rc" -eq 0 ] && [ -s "$tmp" ]; then
    mv -f "$tmp" "$DASH_CACHE" 2>/dev/null && return 0
  fi
  rm -f "$tmp"
  return 1
}

# Atomic test-and-set, reclaiming a lock left behind by a killed refresher.
dash_lock() {
  local lock_age
  lock_age=$(dash_age "$DASH_LOCK")
  [ "$lock_age" -gt "$((DASH_TIMEOUT * 3))" ] && rmdir "$DASH_LOCK" 2>/dev/null
  mkdir "$DASH_LOCK" 2>/dev/null
}

base=""
if [ -n "$orig" ]; then
  age=$(dash_age "$DASH_CACHE")
  if [ -s "$DASH_CACHE" ] && [ "$age" -le "$DASH_MAX_STALE" ]; then
    # Fresh enough to stand behind: show it now, refresh for the next render.
    base=$(cat "$DASH_CACHE" 2>/dev/null)
    if dash_lock; then
      ( trap 'rmdir "$DASH_LOCK" 2>/dev/null' EXIT; dash_fetch ) >/dev/null 2>&1 &
    fi
  elif dash_lock; then
    # Cold, or too old to stand behind: fetch now — under the same lock and the
    # same watchdog, so a hung dashboard costs this render at most DASH_TIMEOUT
    # and then we render our own row without its rows rather than freeze.
    dash_fetch && base=$(cat "$DASH_CACHE" 2>/dev/null)
    rmdir "$DASH_LOCK" 2>/dev/null
  elif [ -s "$DASH_CACHE" ]; then
    # Another render is already fetching. An over-age row beats a blank one, and
    # this one costs nothing.
    base=$(cat "$DASH_CACHE" 2>/dev/null)
  fi
fi

if [ -n "${CCD_ACTIVE:-}" ]; then
  # Dedicated ccd row. stdout = row content; stderr line 1 = model slug whose price cache is missing/stale.
  stale_file=$(mktemp "${TMPDIR:-/tmp}/ccd-stale.XXXXXX")
  ccd_line=$(CCD_PAYLOAD="$payload" python3 - "$RUN_STATE" "$PRICE_CACHE" "$OUTAGE_STATE" 2>"$stale_file" <<'PY'
import json, math, os, sys, time

def load(path):
    try:
        return json.load(open(path))
    except Exception:
        return {}

state = load(sys.argv[1])
prices = load(sys.argv[2]).get("models", {})
try:
    payload = json.loads(os.environ.get("CCD_PAYLOAD", "") or "{}")
except Exception:
    payload = {}

# Current model: the statusline payload carries the actually-active model (reflects /model changes immediately)
model_id = ((payload.get("model") or {}).get("id")) or ""
# Normalize compound suffixes: a terminal [1m] is Claude Code's local hint that opens
# the 1M budget (stripped before the provider), then a routing variant. The EFFECTIVE
# window is the process's CLAUDE_CODE_AUTO_COMPACT_WINDOW when ccd sized it from
# verified provider data — show that, so a 912K-pool model reads ~839K, not a fake 1M.
slug, routing = model_id, ""
ctx_budget = "200K"
if slug.endswith("[1m]"):
    slug = slug[:-4]
    cw = os.environ.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW", "")
    if cw.isdigit() and int(cw) < 1_000_000:
        ctx_budget = f"{int(cw) // 1000}K"
    else:
        ctx_budget = "1M"
# Extract known routing suffix for cache lookup.
# Known routings: :free, :floor, :nitro, :exacto
known_routings = (":free", ":floor", ":nitro", ":exacto")
for r in known_routings:
    if slug.endswith(r):
        routing = r
        slug = slug[:-len(r)]
        break

effort = os.environ.get("CLAUDE_CODE_EFFORT_LEVEL")
if effort not in {"low", "medium", "high", "max"}:
    effort = load(os.path.expanduser("~/.claude/settings.json")).get("effortLevel")
if effort not in {"low", "medium", "high", "max"}:
    effort = None

def fmt(v):
    if v == 0:
        return "$0"
    return f"${v:.2f}" if v >= 0.1 else f"${v:.3f}"

# Cache key includes routing for routing-specific pricing/context.
cache_key = slug + routing
# Pricing: :floor pins the cheapest standard provider (single value);
# :free is zero; other routings show the provider range.
price_part = "pricing…"
entry = prices.get(cache_key)
if entry:
    lo_i, lo_o = entry.get("floor_in_per_m"), entry.get("floor_out_per_m")
    hi_i, hi_o = entry.get("max_in_per_m"), entry.get("max_out_per_m")
    nums = lambda *v: all(isinstance(x, (int, float)) for x in v)
    # :free pins the zero-cost pool and :floor pins the cheapest one — both are a
    # single value. Only genuinely price-ranging routings get the min–max form.
    if routing in (":free", ":floor", "") and nums(lo_i, lo_o):
        price_part = f"in {fmt(lo_i)}/M · out {fmt(lo_o)}/M"
    elif nums(lo_i, hi_i, lo_o, hi_o):
        price_part = f"in {fmt(lo_i)}–{fmt(hi_i)}/M · out {fmt(lo_o)}–{fmt(hi_o)}/M"
CACHE_TTL, FUTURE_GRACE = 86400, 300   # shared cache-freshness policy
stale = True
if entry:
    try:
        age = time.time() - float(entry.get("fetched_at", 0))
        # Future-dated entries are poisoned or clock-skewed — treat as stale.
        stale = not math.isfinite(age) or age > CACHE_TTL or age < -FUTURE_GRACE
    except Exception:
        stale = True
# Request refresh with the routing-specific cache key.
if slug and stale:
    print(cache_key, file=sys.stderr)

# `/model` changes the active ID, but statusline is display-only: it cannot modify
# Claude Code's already-running global compact window. Make the next safe action
# explicit instead of pretending the suffix or provider capacity was auto-applied.
context_guidance = ""
def finite_number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
def safe_ceiling(v):
    return int(min(v * 0.92, v - 40000))
if model_id:
    if stale:
        context_guidance = "checking provider context…"
    elif not finite_number((entry or {}).get("min_context_length")):
        context_guidance = "provider context unverified · safe 200K"
    elif int(entry["min_context_length"]) <= 200000:
        context_guidance = "provider pool ≤200K · safe 200K"
    elif not model_id.endswith("[1m]"):
        candidate_ceiling = safe_ceiling(float(entry["min_context_length"]))
        current_window = os.environ.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW", "")
        # No configured window means Claude Code's ordinary extended budget; do not
        # recommend an arbitrary direct switch as though ccd had verified it.
        if current_window.isdigit() and int(current_window) <= candidate_ceiling:
            context_guidance = f"verified context → /model {slug}{routing or ':floor'}[1m]"
        else:
            context_guidance = f"restart for safe context → /exit; ccd -c --model {slug}"

# run = this ccd process's spend; total = whole quota-outage total (survives ccd restarts)
run_cost = state.get("ccd_spend_usd")
outage = load(sys.argv[3])
total_cost = outage.get("outage_spend_usd")
if isinstance(run_cost, (int, float)):
    spend_part = f"run ${run_cost:.4f}"
elif state.get("baseline_usage_usd") is None:
    spend_part = "spend n/a"
else:
    spend_part = "run $0.0000"
# Show the outage total whenever it exists — including right after a restart,
# before the first hook has computed this session's run cost.
if isinstance(total_cost, (int, float)) and "n/a" not in spend_part:
    spend_part += f" · total ${total_cost:.4f}"

recovery = ""
window = state.get("recovery_notified_window")
reset = state.get("recovery_notified_reset")
# Keep showing while inside the recovered window (reset id unchanged); percent may be >0.
if window and reset and state.get(f"last_{window}_reset") == reset:
    # Under automatic handoff the launcher performs the return itself, so naming
    # the manual commands would be telling the user to do something twice.
    if os.environ.get("CCD_HANDOFF"):
        recovery = "  \033[1;32m✓ Claude recovered → 종료하면 구독으로 자동 복귀\033[0m"
    else:
        recovery = "  \033[1;32m✓ Claude recovered → /exit then claude --resume\033[0m"

display_id = model_id[:-4] if model_id.endswith("[1m]") else model_id
model_part = display_id or "model unknown"
if effort:
    model_part += f" · {effort}"
if display_id:
    model_part += f" · {ctx_budget}"

sep = " \033[2m│\033[0m "
guidance_part = f"{sep}\033[33m{context_guidance}\033[0m" if context_guidance else ""
print(f"\033[1;35mccd\033[0m{sep}\033[36m{model_part}\033[0m{sep}\033[33m{price_part}\033[0m{sep}\033[33m{spend_part}\033[0m{guidance_part}{recovery}", end="")
PY
)
  stale_slug=$(head -n1 "$stale_file" 2>/dev/null || true)
  rm -f "$stale_file"
  if [ -n "$stale_slug" ] && [ -x "$PRICE_FETCH" ]; then
    # Fully detached so rendering never blocks — the cache lands by the next refresh
    ("$PRICE_FETCH" "$stale_slug" >/dev/null 2>&1 &) || true
  fi
  if [ -n "$base" ] && [ -n "$ccd_line" ]; then
    printf '%s\n%s' "$base" "$ccd_line"
  else
    printf '%s%s' "$base" "$ccd_line"
  fi
  exit 0
fi

# ── Normal (subscription) session ────────────────────────────────────────────
# WHICH ACCOUNT IS ANSWERING? Always shown, even with nothing registered — after a
# swap the single most important thing to know is whose quota is being spent, and
# a row that appears only sometimes is a row you learn not to look at. The ccd row
# above covers the "not the subscription" case; this covers the rest.
#
# Reads files directly instead of shelling out to ccd-account (~50ms per render):
# this path must never spawn a keychain read, a subprocess, or an HTTP call.
acct_seg=$(python3 - "$CCD_DIR/accounts" "$CCD_DIR/accounts-quota.json" 2>/dev/null <<'PY'
import json, os, sys
adir, qfile = sys.argv[1], sys.argv[2]

def load(p):
    try:
        with open(p) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

try:
    names = sorted(f[:-5] for f in os.listdir(adir)
                   if f.endswith(".json") and not f.startswith("."))
except OSError:
    names = []
accounts = {n: load(os.path.join(adir, n + ".json")) for n in names}

# Who Claude Code currently believes it is. Same two-source rule as ccd-account's
# active_name(), inlined because the statusline may not call it: whichever of the
# pointer and the profile was observed LAST wins, so a manual /login and a fresh
# ccd swap each win in their own window. ccd-account stays the authority; this is
# a read-only mirror of that rule.
ident_uuid, ident_email, fetched = "", "", 0
cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
for p in (os.path.join(cfg, ".claude.json"), os.path.expanduser("~/.claude.json")):
    acc = load(p).get("oauthAccount")
    if isinstance(acc, dict) and acc.get("accountUuid"):
        ident_uuid = acc["accountUuid"]
        ident_email = acc.get("emailAddress") or ""
        f = acc.get("profileFetchedAt")
        fetched = int(f) if isinstance(f, (int, float)) else 0
        break

def pointer():
    try:
        n = open(os.path.join(adir, ".active")).read().strip()
    except OSError:
        return ""
    return n if n in accounts else ""

def pointer_at():
    try:
        return int(open(os.path.join(adir, ".active-at")).read().strip())
    except Exception:
        return 0

active, unregistered = "", False
if ident_uuid and fetched >= pointer_at():
    active = next((n for n, a in accounts.items()
                   if a.get("account_uuid") == ident_uuid), "")
    unregistered = not active
else:
    active = pointer()

# Name it even when it is not in the store: knowing you are on
# someone@example.com beats a bare "?" that tells you nothing.
display = active or (ident_email.split("@")[0] if ident_email else "")
if not display:
    raise SystemExit(0)
if len(display) > 18:            # long email local parts must not eat the row
    display = display[:17] + "…"

quota = load(qfile)

def pct(name):
    q = quota.get(name) or {}
    if q.get("status") != "ok":
        return None
    vals = [q.get(k) for k in ("five_hour_percent", "seven_day_percent")]
    vals = [v for v in vals if isinstance(v, (int, float))]
    return max(vals) if vals else None

G, Y, R, DIM, RS, C = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m", "\033[36m"
mark = f"{Y}●{RS}" if unregistered else f"{G}●{RS}"
head = f"{mark} {C}claude:{display}{RS}"
if unregistered:
    head += f" {DIM}(unregistered){RS}"

# With nothing else registered there is no spare to talk about, so stop here
# rather than printing "spare none" at someone who never asked for the feature.
if len(names) < 2:
    print(head, end="")
    raise SystemExit(0)

# The spare is the whole point of registering a second account, so say whether one
# is actually ready. "needs re-login" has to be visible here: it is invisible
# everywhere else until the handoff fails.
#
# ONE spare is named, never a list. The statusline shares a line with the
# dashboard's own segments and is truncated at terminal width, so a row that grows
# with the number of registered accounts would push the quota numbers off screen
# for exactly the people who registered the most. The extras become a "+N" count:
# the question this answers is "do I have a net?", not "what is my whole roster".
ready, dead, unknown = [], [], 0
for n in names:
    if n == active:
        continue
    q = quota.get(n) or {}
    if q.get("status") == "dead":
        dead.append(n)
        continue
    p = pct(n)
    if p is None:
        unknown += 1          # never yet probed, or the reading failed
    elif p < 90:
        ready.append((p, n))
ready.sort()

def short(n, w=14):
    return n if len(n) <= w else n[: w - 1] + "…"

if ready:
    p, n = ready[0]
    more = f"{DIM} +{len(ready) - 1}{RS}" if len(ready) > 1 else ""
    tail = f"{DIM}spare{RS} {G}{short(n)} {p}%{RS}{more}"
elif dead:
    more = f" +{len(dead) - 1}" if len(dead) > 1 else ""
    tail = f"{R}spare {short(dead[0])} needs re-login{more}{RS}"
elif unknown:
    # Not the same as having no spare. Saying "none" here would be a claim we
    # cannot support, and it is the claim that matters most to get right.
    tail = f"{DIM}spare ?{RS}"
else:
    tail = f"{DIM}spare none{RS}"
print(f"{head} {DIM}│{RS} {tail}", end="")
PY
)

# ── Append the escape hatch only above the threshold
suffix=""
if [ -f "$CACHE" ]; then
  suffix=$(THRESHOLD="$THRESHOLD" python3 - "$CACHE" 2>/dev/null <<'PY'
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
c = d.get("claude") or {}
vals = [p for p in (c.get("fiveHourPercent"), c.get("sevenDayPercent"))
        if isinstance(p, (int, float))]
if vals and max(vals) >= int(os.environ["THRESHOLD"]):
    # Red, bold — impossible to miss
    print("\033[1;31m⚠ quota " + str(int(max(vals))) + "% → /exit then ccd -c\033[0m", end="")
PY
)
fi

# The warning gets its own row — appended to the dashboard's last line it is
# cut off by terminal-width truncation. The account segment shares that row when
# both are present, so multi-account never costs more than one extra line.
row="$acct_seg"
if [ -n "$suffix" ]; then
  if [ -n "$row" ]; then
    row="$row $(printf '\033[2m│\033[0m') $suffix"
  else
    row="$suffix"
  fi
fi

if [ -n "$base" ] && [ -n "$row" ]; then
  printf '%s\n%s' "$base" "$row"
else
  printf '%s%s' "$base" "$row"
fi
