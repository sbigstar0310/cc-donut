# OpenRouter backbone configuration — this single file is all of it.
#
# Design: pin OpenRouter as the only provider and hang models of different price
# tiers on Claude Code's built-in model aliases (haiku / sonnet / opus).
# That way `/model haiku` switches the backbone inside a session without
# restarting Claude Code. Alias ≠ actual Claude model; the mapping below overrides the names.
# The API key is stored separately in keys.env; fresh installs create OPENROUTER_API_KEY="" there.

export ANTHROPIC_BASE_URL="https://openrouter.ai/api"   # /v1/messages is appended automatically
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"

# ── Routing policy (applied to all models at once) ───────────────────────
# OpenRouter serves the same model through multiple providers with different price/quality.
#   floor  = always the cheapest provider    <- default; ccx exists to minimize cost while waiting out quota
#   exacto = providers with reliable tool calling  <- switch if tool calls keep misfiring
# For one run only: ccx -c --routing exacto
CCX_ROUTING="${CCX_ROUTING:-floor}"

# ── Models for the haiku/sonnet/opus slots (ascending price) ─────────────
# Slugs go without a suffix; ccx appends CCX_ROUTING.

# Cheap chores: file scans, log grep, trivial edits
export ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek/deepseek-v4-flash"

# Default: everyday coding
export ANTHROPIC_DEFAULT_SONNET_MODEL="openai/gpt-5.6-luna"

# Hard problems: design judgment, tricky debugging
export ANTHROPIC_DEFAULT_OPUS_MODEL="openai/gpt-5.6-terra"

# ── Non-Anthropic upstream compatibility ─────────────────────────────────
# Prevents 400s from OpenAI/DeepSeek schemas rejecting Claude Code's pre-release fields.
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"

export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1000000"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="64000"

# Note: CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY is useless here.
# Gateway model discovery only adds ids starting with claude/anthropic to the /model
# picker, so openai/... deepseek/... slugs never appear. The alias mapping above replaces it.
